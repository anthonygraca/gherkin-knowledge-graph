   385	        path = model_dir / name
   386	        digest.update(name.encode("utf-8"))
   387	        with path.open("rb") as handle:
   388	            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
   389	                digest.update(chunk)
   390	    return f"sha256:{digest.hexdigest()}"
