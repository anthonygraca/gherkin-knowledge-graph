"""FastAPI dependencies.

All collaborator state hangs off ``app.state`` so a test (or a future worker) can build an
application with different settings without monkeypatching imports.
"""

from __future__ import annotations

from typing import Annotated

from fastapi import Depends, Request

from app.assurance.rules import DeterministicAssuranceEvaluator
from app.discovery.registry import ProviderRegistry
from app.domain.ports import ArtifactRepository
from app.persistence.ingested import IngestedStore
from app.persistence.portable import PortableRegistry
from app.persistence.review import ReviewWorkspace
from app.retrieval.lifecycle import RetrievalLifecycle
from app.settings import Settings


def provide_settings(request: Request) -> Settings:
    return request.app.state.settings


def provide_repository(request: Request) -> ArtifactRepository:
    """The shared port: routes read artifacts, links, and evidence through this, not the class."""
    return request.app.state.store


def provide_store(request: Request) -> IngestedStore:
    """The concrete store, for ingestion and fixture-facing helpers."""
    return request.app.state.store


def provide_evaluator(request: Request) -> DeterministicAssuranceEvaluator:
    return request.app.state.evaluator


def provide_providers(request: Request) -> ProviderRegistry:
    return request.app.state.providers


def provide_portable(request: Request) -> PortableRegistry:
    """Portable indexes and imported reports; empty until an explicit index call."""
    return request.app.state.portable


def provide_review(request: Request) -> ReviewWorkspace:
    return request.app.state.review


def provide_retrieval_lifecycle(request: Request) -> RetrievalLifecycle:
    return request.app.state.retrieval


SettingsDep = Annotated[Settings, Depends(provide_settings)]
RepositoryDep = Annotated[ArtifactRepository, Depends(provide_repository)]
StoreDep = Annotated[IngestedStore, Depends(provide_store)]
EvaluatorDep = Annotated[DeterministicAssuranceEvaluator, Depends(provide_evaluator)]
ProvidersDep = Annotated[ProviderRegistry, Depends(provide_providers)]
PortableDep = Annotated[PortableRegistry, Depends(provide_portable)]
ReviewDep = Annotated[ReviewWorkspace, Depends(provide_review)]
RetrievalLifecycleDep = Annotated[RetrievalLifecycle, Depends(provide_retrieval_lifecycle)]
"""HTTP routes.

Endpoints are grouped by intent, which is also the honesty axis of the system:

* **reads** — real implementations over the ingested fixture repository.
* **ingestion** — parses the configured repository at a revision.
* **assurance** — deterministic rules over ingested facts; no model calls.
* **discovery** — proposals only; provider failure is a typed problem, never a finding.
* **review** — trusted-local-operator capture and append-only decisions (review_routes.py).
"""

from __future__ import annotations

import logging
from typing import Annotated

from fastapi import APIRouter, Path, Query

from app.api.deps import (
    EvaluatorDep,
    ProvidersDep,
    RepositoryDep,
    SettingsDep,
    StoreDep,
)
from app.domain.api import (
    ArtifactListResponse,
    DiscoveryRequest,
    DiscoveryResponse,
    EvaluateRequest,
    FindingsResponse,
    HealthResponse,
    IngestionRequest,
    IngestionResponse,
    ProblemDetails,
    ProviderCatalogResponse,
    ProviderDescriptor,
    ThreadResponse,
)
from app.domain.enums import ArtifactType
from app.domain.errors import DomainError, ProviderUnavailable, RetrievalUnavailable
from app.domain.models import ARTIFACT_ID_PATTERN, Artifact
from app.version import PACKAGE_VERSION, SCHEMA_VERSION

logger = logging.getLogger(__name__)

router = APIRouter()

BASELINE_QUERY = Query(
    description="Baseline name (fixture tag) or commit SHA; omitted means the latest baseline."
)

_PROBLEM_400: dict[str, object] = {
    "model": ProblemDetails,
    "description": "Unknown provider or invalid request.",
}
_PROBLEM_404: dict[str, object] = {
    "model": ProblemDetails,
    "description": "Unknown artifact, baseline, or thread.",
}


@router.get(
    "/health",
    response_model=HealthResponse,
    tags=["reads"],
    summary="Liveness, contract version, and fixture baseline status",
)
def get_health(settings: SettingsDep, store: StoreDep, providers: ProvidersDep) -> HealthResponse:
    """``baselines`` comes from the port; ``baseline_commits`` is a fixture-only convenience map."""
    return HealthResponse(
        status="ok",
        package_version=PACKAGE_VERSION,
        schema_version=SCHEMA_VERSION,
        fixture=settings.fixture,
        baselines=store.baselines(),
        baseline_commits=store.baseline_commits(),
        discovery_providers=providers.registered,
    )

"""Exception handlers that render every error as an RFC 9457 problem document.

Uniform error shape is part of the contract: the UI, the mock clients, and the API tests
all switch on ``code``/``status``, never on message text.
"""

from __future__ import annotations

import logging

from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from starlette.exceptions import HTTPException as StarletteHTTPException

from app.discovery.cocoindex import CocoIndexError
