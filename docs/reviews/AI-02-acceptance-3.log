    def embed(self, texts: list[str]) -> list[list[float]]:
        vectors: list[list[float]] = []
        for text in texts:
            encoding = self._tokenizer.encode(text)
            ids = self._numpy.asarray([encoding.ids], dtype=self._numpy.int64)
            mask = self._numpy.ones_like(ids)
            empty = self._numpy.zeros((0, 512), dtype=self._numpy.float32)
            feed = {
                "input_ids": ids,
                "attention_mask": mask,
                "image_features": empty,
                "video_features": empty,
                "audio_features": empty,
            }
            embedding = self._session.run(["sentence_embedding"], feed)[0][0]
            vector = [float(value) for value in embedding]
            if len(vector) != self.dimension:
                raise RetrievalUnavailable(
                    f"Local embedding returned dimension {len(vector)}, expected {self.dimension}."
                )
            if not all(math.isfinite(value) for value in vector):
                raise RetrievalUnavailable("Local embedding returned a non-finite value.")
            norm = math.sqrt(sum(value * value for value in vector))
            if norm <= 0:
                raise RetrievalUnavailable("Local embedding returned a zero vector.")
            vectors.append([value / norm for value in vector])
        return vectors


@dataclass
class _Corpus:
    baseline: str
    commit: str
    binding: str
    documents: dict[str, str]
    embeddings: dict[str, list[float]]
    locators: dict[str, str]


class LocalEmbeddingCandidateDiscovery:
    """`CandidateDiscovery` over a local EmbeddingGemma 2 runtime and an in-memory corpus."""

    provider_name = PROVIDER_NAME

    def __init__(
        self,
        repository: ArtifactRepository,
        git: GitRepository,
        *,
        runtime: EmbeddingRuntime,
        model_version: str | None = None,
        formatting_version: str = FORMATTING_VERSION,
    ) -> None:
        self._repository = repository
        self._git = git
        self._runtime = runtime
        if model_version is None:
            model_id = getattr(runtime, "model_id", None)
            weights_digest = getattr(runtime, "weights_digest", None)
            if not model_id or not weights_digest:
                raise RetrievalUnavailable(
                    "The local runtime did not report a model identity and weights digest; "
                    "candidates will not be returned with invented provenance."
                )
            digest_hex = weights_digest.removeprefix("sha256:")
            model_version = f"{model_id}@sha256:{digest_hex[:12]}"
        self.model_version = model_version
        self.formatting_version = formatting_version
        self._lock = threading.RLock()
        self._corpora: dict[str, _Corpus] = {}

    @property
    def index_revision(self) -> str:
        return self.binding_for(None)

    @property
    def runtime(self) -> EmbeddingRuntime:
        return self._runtime

    def binding_for(self, baseline: str | None = None) -> str:
        canonical = self._repository.resolve_baseline(baseline)
        corpus = self._corpus(canonical)
        return corpus.binding

    def discover(
        self,
        artifact_id: str,
        *,
        top_k: int = 5,
        relation_types: Sequence[RelationType] | None = None,
        baseline: str | None = None,
    ) -> list[TraceCandidate]:
        if top_k < 1:
            raise ValueError("top_k must be >= 1")
        canonical = self._repository.resolve_baseline(baseline)
        source = self._repository.get_artifact(artifact_id, baseline=canonical)
        allowed = self._allowed_relations(source, relation_types)
        if not allowed:
            return []
        corpus = self._corpus(canonical)
        query = self._query_text(source, corpus)
        query_vector = self._validate_vector(self._runtime.embed([query])[0])
        scored: list[tuple[float, Artifact]] = []
        for target in self._targets(corpus, source, allowed):
            if target.artifact_id == source.artifact_id:
                continue
            target_vector = corpus.embeddings[target.artifact_id]
            cosine = sum(a * b for a, b in zip(query_vector, target_vector, strict=True))
            scored.append((max(0.0, min(1.0, cosine)), target))
        scored.sort(key=lambda item: (-item[0], item[1].artifact_id))
        candidates: list[TraceCandidate] = []
        for rank, (score, target) in enumerate(scored[:top_k], start=1):
            candidates.append(
                TraceCandidate(
                    source_id=source.artifact_id,
                    target_id=target.artifact_id,
                    proposed_relation_type=_relation_between(
                        source.artifact_type, target.artifact_type, allowed
                    ),
                    rank=rank,
                    score=score,
                    discovery_provider=self.provider_name,
                    model_version=self.model_version,
                    index_revision=corpus.binding,
                    rationale=(
                        f"local cosine {score:.6f}; {MODEL_ID}; "
                        f"{self.formatting_version}; {corpus.binding}"
                    ),
                )
            )
        return candidates

    # ------------------------------------------------------------- internals

    def _allowed_relations(
        self, source: Artifact, requested: Sequence[RelationType] | None
    ) -> list[RelationType]:
        if requested is not None:
            return list(requested)
        if source.artifact_type is ArtifactType.REQUIREMENT:
            return [RelationType.VERIFIED_BY]
        if source.artifact_type is ArtifactType.SCENARIO:
            return [RelationType.IMPLEMENTED_BY, RelationType.EXERCISED_BY]
        return []

    def _targets(
        self, corpus: _Corpus, source: Artifact, allowed: list[RelationType]
    ) -> list[Artifact]:
        artifacts = {
            artifact.artifact_id: artifact
            for artifact in self._repository.list_artifacts(corpus.baseline)
        }
        targets: list[Artifact] = []
        for relation in allowed:
            expected_source, expected_target = RELATION_DIRECTION[relation]
            if source.artifact_type is not expected_source:
                continue
            for artifact in artifacts.values():
                if artifact.artifact_type is expected_target:
                    targets.append(artifact)
        unique = {artifact.artifact_id: artifact for artifact in targets}
        return sorted(unique.values(), key=lambda artifact: artifact.artifact_id)

    def _corpus(self, baseline: str) -> _Corpus:
        with self._lock:
            cached = self._corpora.get(baseline)
            if cached is not None:
                return cached
            commit = self._repository.commit_of(baseline)
            artifacts = self._repository.list_artifacts(baseline)
            documents: dict[str, str] = {}
            locators: dict[str, str] = {}
            for artifact in artifacts:
                documents[artifact.artifact_id] = self._document_text(artifact, commit)
                locators[artifact.artifact_id] = artifact.locator
            binding = _binding(
                baseline=baseline,
                commit=commit,
                artifacts=artifacts,
                model_version=self.model_version,
                weights_digest=getattr(self._runtime, "weights_digest", "unknown"),
                formatting=self.formatting_version,
            )
            embeddings: dict[str, list[float]] = {}
            if artifacts:
                vectors = self._runtime.embed([documents[a.artifact_id] for a in artifacts])
                if len(vectors) != len(artifacts):
                    raise RetrievalUnavailable(
                        "Local embedding runtime returned a different number of vectors "
                        "than inputs."
                    )
                for artifact, vector in zip(artifacts, vectors, strict=True):
                    embeddings[artifact.artifact_id] = self._validate_vector(vector)
            corpus = _Corpus(
                baseline=baseline,
                commit=commit,
                binding=binding,
                documents=documents,
                embeddings=embeddings,
                locators=locators,
            )
            self._corpora[baseline] = corpus
            return corpus

    def _validate_vector(self, vector: list[float]) -> list[float]:
        if len(vector) != self._runtime.dimension:
            raise RetrievalUnavailable(
                f"Local embedding returned dimension {len(vector)}, expected "
                f"{self._runtime.dimension}."
            )
        if not all(math.isfinite(value) for value in vector):
            raise RetrievalUnavailable("Local embedding returned a non-finite value.")
        norm = math.sqrt(sum(value * value for value in vector))
        if norm <= 0:
            raise RetrievalUnavailable("Local embedding returned a zero vector.")
        return [value / norm for value in vector]

    def _document_text(self, artifact: Artifact, commit: str) -> str:
        path = artifact.locator.split("#", 1)[0]
        try:
            raw = self._git.read_blob(commit, path)
        except Exception:  # noqa: BLE001 - an unreadable artifact is not a candidate
            raw = b""
        content = raw.decode("utf-8", "replace")
        if artifact.artifact_type is ArtifactType.SCENARIO:
            content = _scenario_block(content, artifact.locator) or artifact.title
        return DOCUMENT_TEMPLATE.format(title=artifact.locator, content=content)

    def _query_text(self, source: Artifact, corpus: _Corpus) -> str:
        path = source.locator.split("#", 1)[0]
        try:
            raw = self._git.read_blob(corpus.commit, path)
        except Exception:  # noqa: BLE001
            raw = b""
        content = raw.decode("utf-8", "replace")
        if source.artifact_type is ArtifactType.SCENARIO:
            content = _scenario_block(content, source.locator) or source.title
            template = QUERY_TEMPLATE_CODE
        else:
            template = QUERY_TEMPLATE_SEARCH
        return f"{template}{source.title}\n{content}".strip()


def _relation_between(
    source_type: ArtifactType,
    target_type: ArtifactType,
    allowed: Sequence[RelationType],
) -> RelationType:
    for relation in allowed:
        if RELATION_DIRECTION[relation] == (source_type, target_type):
            return relation
    raise InvalidRequest(
        f"No allowed relation connects {source_type.value} -> {target_type.value}."
    )


def _weights_digest(model_dir: Path) -> str:
    digest = hashlib.sha256()
    for name in WEIGHTS_FILES:
        path = model_dir / name
        digest.update(name.encode("utf-8"))
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
    return f"sha256:{digest.hexdigest()}"


def _binding(
    *,
    baseline: str,
    commit: str,
    artifacts: list[Artifact],
    model_version: str,
    weights_digest: str,
    formatting: str,
) -> str:
    payload = {
        "baseline": baseline,
        "commit": commit,
        "model_version": model_version,
        "weights_digest": weights_digest,
        "formatting": formatting,
        "dimension": DIMENSION,
        "artifacts": [
            {
                "artifact_id": artifact.artifact_id,
                "artifact_type": str(artifact.artifact_type),
                "locator": artifact.locator,
                "revision": artifact.revision,
                "content_hash": artifact.content_hash,
            }
            for artifact in sorted(artifacts, key=lambda item: item.artifact_id)
        ],
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"


def _scenario_block(text: str, locator: str) -> str | None:
    anchor = locator.split("#", 1)[1] if "#" in locator else None
    if anchor is None:
        return None
    lines = text.splitlines()
    start = next((index for index, line in enumerate(lines) if f"@{anchor}" in line), None)
    if start is None:
        return None
    end = len(lines)
    for index in range(start + 1, len(lines)):
        if _ARTIFACT_TAG.search(lines[index]) and lines[index].lstrip().startswith("@"):
            end = index
            break
    return "\n".join(lines[start:end]).strip()


def validate_local_endpoint(endpoint: str | None) -> None:
    """Refuse a non-loopback endpoint before any connection is attempted."""
    if endpoint is None:
        return
    from urllib.parse import urlsplit

    parsed = urlsplit(endpoint)
    if parsed.hostname not in _LOOPBACK_HOSTS:
        raise InvalidRequest(
            f"Local inference mode refuses endpoint {endpoint!r}: only loopback endpoints "
            "are permitted; no connection was attempted."
        )


__all__ = [
    "EmbeddingRuntime",
    "LocalEmbeddingCandidateDiscovery",
    "OnnxEmbeddingRuntime",
    "validate_local_endpoint",
]
"""AI-02 live evidence: real same-machine EmbeddingGemma 2 inference.

Opt in with ``CTA_LOCAL_EMBEDDING_LIVE_TESTS=1``. The test is skipped by the default offline
suite and never downloads weights. Run it under an OS-level network denial (``unshare -rn``) to
prove the process tree has no non-loopback egress.
"""

from __future__ import annotations

import json
import os
import statistics
import time
from dataclasses import replace
from pathlib import Path

import pytest
from fastapi.testclient import TestClient

from app.assurance.rules import DeterministicAssuranceEvaluator
from app.discovery.registry import ProviderRegistry
from app.domain.enums import RelationType
from app.main import create_app
from app.persistence.ingested import IngestedStore
from app.settings import Settings

DEFAULT_MODEL_DIR = Path.home() / ".local/share/cta/models/embeddinggemma-2-text-270m-onnx"
#: Reviewed fixed vector: SHA-256 over the baseline-a fixture artifact metadata and the accepted
#: model manifest, computed independently of the provider. Do not derive this from `binding_for`.
EXPECTED_BASELINE_A_BINDING = (
    "sha256:814eb9914310d4d18f68859fbb5e89230773f026a50e931cb16889b1e3eaac52"
)
pytestmark = pytest.mark.skipif(
    os.environ.get("CTA_LOCAL_EMBEDDING_LIVE_TESTS") != "1",
    reason="set CTA_LOCAL_EMBEDDING_LIVE_TESTS=1 to run real local inference",
)


def _rss_kib() -> int | None:
    try:
        for line in Path("/proc/self/status").read_text("utf-8").splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1])
    except OSError:
        return None
    return None


def test_local_embeddinggemma_live_contract(
    fixture_settings: Settings, store: IngestedStore, tmp_path: Path
) -> None:
    model_dir = Path(
        os.environ.get("CTA_LOCAL_EMBEDDING_MODEL_DIR", DEFAULT_MODEL_DIR)
    ).expanduser()
    if not model_dir.is_dir():
        pytest.skip(f"local model directory is absent: {model_dir}")
    settings = replace(
        fixture_settings,
        local_embedding_enabled=True,
        local_embedding_model_dir=model_dir,
    )
    rss_before = _rss_kib()
    evaluator = DeterministicAssuranceEvaluator(store)
    before = (
        store.list_links("baseline-a"),
        store.list_evidence("baseline-a"),
        evaluator.evaluate("baseline-a"),
    )
    started = time.perf_counter()
    provider = ProviderRegistry(settings, store).get("local-embeddinggemma")
    load_seconds = time.perf_counter() - started

    queries = ["SCN-001", "REQ-001", "SCN-002"]
    latencies: list[float] = []
    result_sets: dict[str, list[str]] = {}
    index_started = time.perf_counter()
    binding = provider.binding_for("baseline-a")
    index_seconds = time.perf_counter() - index_started
    assert binding == EXPECTED_BASELINE_A_BINDING
    for artifact_id in queries:
        query_started = time.perf_counter()
        candidates = provider.discover(artifact_id, top_k=10, baseline="baseline-a")
        latencies.append((time.perf_counter() - query_started) * 1_000.0)
        result_sets[artifact_id] = [candidate.target_id for candidate in candidates]
        assert all(candidate.source_id == artifact_id for candidate in candidates)
        assert [candidate.rank for candidate in candidates] == list(range(1, len(candidates) + 1))
        assert all(
            candidate.discovery_provider == "local-embeddinggemma" for candidate in candidates
        )
        assert all(candidate.model_version for candidate in candidates)
        assert all(candidate.index_revision == binding for candidate in candidates)
        assert all(
            not hasattr(candidate, "link_id") and not hasattr(candidate, "review_state")
            for candidate in candidates
        )

    scenario_candidates = provider.discover("SCN-001", top_k=10, baseline="baseline-a")
    assert "CODE-001" in {candidate.target_id for candidate in scenario_candidates}
    assert "TEST-001" in {candidate.target_id for candidate in scenario_candidates}
    assert all(
        candidate.proposed_relation_type is not RelationType.VERIFIED_BY
        for candidate in scenario_candidates
    )
    trimmed = provider.discover("SCN-001", top_k=1, baseline="baseline-a")
    assert len(trimmed) == 1
    assert trimmed[0].rank == 1
    with pytest.raises(ValueError):
        provider.discover("SCN-001", top_k=0, baseline="baseline-a")
    implemented = provider.discover(
        "SCN-001", relation_types=[RelationType.IMPLEMENTED_BY], baseline="baseline-a"
    )
    exercised = provider.discover(
        "SCN-001", relation_types=[RelationType.EXERCISED_BY], baseline="baseline-a"
    )
    assert implemented and all(
        candidate.proposed_relation_type is RelationType.IMPLEMENTED_BY for candidate in implemented
    )
    assert exercised and all(
        candidate.proposed_relation_type is RelationType.EXERCISED_BY for candidate in exercised
    )
    incompatible = provider.discover(
        "SCN-001", relation_types=[RelationType.VERIFIED_BY], baseline="baseline-a"
    )
    assert incompatible == []
    requirements = provider.discover("REQ-001", baseline="baseline-a")
    assert requirements and all(
        candidate.proposed_relation_type is RelationType.VERIFIED_BY for candidate in requirements
    )
    assert provider.discover("CODE-001", baseline="baseline-a") == []

    api_settings = replace(settings, review_journal_path=tmp_path / "journal.ndjson")
    app = create_app(api_settings)
    registry = ProviderRegistry(api_settings, app.state.store)
    registry._cache["local-embeddinggemma"] = provider
    app.state.providers = registry
    api = TestClient(app)
    thread_before = api.get("/api/threads/REQ-001", params={"baseline": "baseline-a"})
    assert thread_before.status_code == 200, thread_before.text
    empty = api.post(
        "/api/discovery",
        json={
            "artifact_id": "CODE-001",
            "provider": "local-embeddinggemma",
            "baseline": "baseline-a",
        },
    )
    assert empty.status_code == 200, empty.text
    empty_body = empty.json()
    assert empty_body["candidates"] == []
    assert empty_body["provider"] == "local-embeddinggemma"
    assert empty_body["model_version"].startswith("embeddinggemma-2-text-270m-q8_0@sha256:")
    assert empty_body["index_revision"] == binding
    thread_after = api.get("/api/threads/REQ-001", params={"baseline": "baseline-a"})
    assert thread_after.status_code == 200, thread_after.text
    assert thread_after.json() == thread_before.json()
    thread_body = thread_after.json()
    assert isinstance(thread_body["accepted_links"], list)
    assert isinstance(thread_body["proposed_links"], list)

    after = (
