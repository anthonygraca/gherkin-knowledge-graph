/**
 * Cucumber configuration for CTA's own acceptance suite.
 *
 * Feature files stay where the lifecycle put them (`docs/stories/*.feature`); nothing is copied or
 * rewritten. Two features are excluded by tag and documented in the inventory:
 * `@FT-03` (process/governance checks verified by inspection) and `@AI-06` (M3 slice).
 *
 * Reports are written as Cucumber Messages NDJSON, the same format the portable adapter ingests.
 */
export default {
  import: ['support/world.js', 'support/ui.js', 'step_definitions/**/*.js'],
  paths: ['../docs/stories/*.feature'],
  tags: 'not @FT-03 and not @AI-06 and not @superseded-by-AS-01 and not @refinement-draft and not @live-local',
  format: [
    'summary',
    'message:reports/cucumber-messages.ndjson',
    'json:reports/cucumber.json',
  ],
  formatOptions: { snippetInterface: 'async-await' },
  parallel: 1,
  retry: 0,
};
/**
 * Opt-in live local-model acceptance run (AI-02 SCN-3205).
 *
 * Run under an OS-level network denial, for example:
 *   unshare -rn env CTA_EGRESS_DENIED=1 CTA_LOCAL_EMBEDDING_MODEL_DIR=... \
 *     npx cucumber-js --config cucumber.live.mjs
 */
import base from './cucumber.mjs';

export default {
  ...base,
  tags: '@live-local',
  format: ['summary', 'message:reports/cucumber-live-messages.ndjson'],
  formatOptions: { snippetInterface: 'async-await' },
};
not erase the meaning of historical provenance. Problem documents may carry `failed_provider` and
`registered_providers`; both are required on `provider-not-registered`. A registered provider that
fails maps to `503 provider-unavailable` and is never converted into a finding, an accepted link, or
an empty success. Empty discovery success keeps provider/model/index provenance.

## Local embedding provider (schema 0.7.0, additive provider; AI-02)

`local-embeddinggemma` is an optional `CandidateDiscovery` implementation behind the existing port;
the default remains `fake`. It loads the Apache-2.0 EmbeddingGemma 2 text ONNX model from a local
directory, embeds the eligible corpus in memory, and returns ordinary `TraceCandidate` proposals.
The exact model, weights digests, runtime, licence, hardware, formatting versions, measured limits,
and failure modes are recorded in
`docs/reports/omp-closeout/AI-02-MODEL-MANIFEST.md`. A remote endpoint is `400 invalid-request`
before any connection; missing weights, a digest mismatch, a missing runtime, or a non-finite/wrong
dimension/zero embedding are `503 retrieval-unavailable` on `/api/discovery`; this is the AI-02
provider-specific exception to the generic AS-07 `provider-unavailable` mapping. The provider writes
no accepted link, review state, evidence, or finding.

## Retrieval lifecycle contracts (schema 0.8.0, additive; AI-03)

The CTA-owned snapshot/cache lifecycle lives in `app/domain/retrieval_lifecycle.py` and
`app/retrieval/lifecycle.py`; the normative notes are in `docs/stories/AI-03.md`.

* `RetrievalConfig` — provider, model ID/version, weights digest, runtime, formatting version,
  dimension, max tokens, and explicit `chunking_owner`/`embedding_owner = cocoindex`.
  `config_digest = sha256(canonical config)`.
* `RetrievalArtifact` — eligible `CODE-nnn`/`TEST-nnn` artifact ID, type, locator, revision, and
  content hash.
* `ContentChangePlan` — `changed`, `added`, `removed`, and `unchanged` artifact IDs plus the
  resolved selected/previous commits. It has no embedding-count field.
* `RetrievalManifest` — schema version, repository, baseline, commit, config/config digest,
  `corpus_cache_key`, `snapshot_binding`, eligible artifacts, change classifications and counts,
  `items_embedded` (nullable), `items_embedded_availability` (`measured` | `not_available`),
  measured `elapsed_ms`, previous binding, `reused`, `published_at`, and the optional backend
  observation.
* `corpus_cache_key = sha256(repository, config_digest, sorted eligible artifact IDs/types/locators/
  content hashes)`; commits are excluded. `snapshot_binding = snapshot:sha256(sha256(repository,
  commit, corpus_cache_key, config_digest))`; commits are included. Evidence-only commits therefore
  share a cache key but not a binding.
* Publication is an immutable `snapshots/<binding>.json` plus an atomically replaced
  `baselines/<baseline>.json` pointer, outside the fixture/evaluated repository. Failed refresh
"""Provider lookup.

Candidate discovery is still fixture-backed (``fake``); real providers register behind the same
:class:`CandidateDiscovery` port in a later story. The optional chat and embedding providers are
built lazily from :class:`app.settings.Settings`: fake mode returns deterministic fakes, live mode
builds the HTTP adapters only when asked, and a live configuration without an embeddings endpoint
reports embeddings as unavailable rather than substituting chat completions.
"""

from __future__ import annotations

from app.discovery.ai import ChatGenerationProvider, EmbeddingProvider
from app.discovery.ai_fake import FakeChatGenerationProvider, FakeEmbeddingProvider
from app.discovery.fake import FakeCandidateDiscovery
from app.domain.errors import ProviderNotRegistered
from app.domain.ports import ArtifactRepository, CandidateDiscovery
from app.settings import Settings

REGISTERED_PROVIDERS: tuple[str, ...] = ("fake",)

#: Presentation metadata, independent of the effective registry. Disabling an optional provider
#: must not erase the meaning of provenance recorded by an earlier proposal (AS-07).
PROVIDER_KINDS: dict[str, str] = {
    "fake": "fixture",
    "cocoindex": "model",
    "local-embeddinggemma": "model",
}

DEFAULT_PROVIDER = "fake"


class ProviderRegistry:
    """Builds providers on demand and caches them per process."""

    def __init__(self, settings: Settings, repository: ArtifactRepository | None = None) -> None:
        self._settings = settings
        self._repository = repository
        self._cache: dict[str, CandidateDiscovery] = {}
        self._chat: ChatGenerationProvider | None = None
        self._embeddings: EmbeddingProvider | None = None
        self._embeddings_resolved = False

    @property
    def registered(self) -> list[str]:
        providers = list(REGISTERED_PROVIDERS)
        if self._settings.cocoindex_enabled:
            providers.append("cocoindex")
        if self._settings.local_embedding_enabled:
            providers.append("local-embeddinggemma")
        return providers

    def catalog(self) -> list[dict[str, object]]:
        """Effective providers with presentation kind; never a hand-maintained copy."""
        default = (
            self._settings.discovery_provider
            if self._settings.discovery_provider in self.registered
            else DEFAULT_PROVIDER
        )
        return [
            {
                "name": name,
                "kind": PROVIDER_KINDS.get(name, "unknown"),
                "default": name == default,
            }
            for name in self.registered
        ]

    def get(self, name: str | None = None) -> CandidateDiscovery:
        resolved = name or self._settings.discovery_provider
        if resolved not in self.registered:
            raise ProviderNotRegistered(
                f"Unknown discovery provider '{resolved}'. Registered providers: "
                f"{', '.join(self.registered)}. Code-search candidates arrive with AI-06 "
                f"PR 2; they are optional plugins and never required for tests.",
                failed_provider=resolved,
                registered=self.registered,
            )
        if resolved not in self._cache:
            self._cache[resolved] = self._build(resolved)
        return self._cache[resolved]

    def chat(self) -> ChatGenerationProvider:
        """The configured chat provider. Construction never contacts the endpoint."""
        if self._chat is None:
            if self._settings.ai_mode == "fake":
                self._chat = FakeChatGenerationProvider()
            else:
                from app.discovery.ai_http import OpenAICompatibleChatProvider

                self._chat = OpenAICompatibleChatProvider(
                    base_url=self._settings.llm_base_url or "",
                    model=self._settings.llm_model or "",
                    api_key=self._settings.llm_api_key,
                )
        return self._chat

    def embeddings(self) -> EmbeddingProvider | None:
        """The configured embedding provider, or ``None`` when none is available.

        A live mode without ``CTA_EMBED_BASE_URL``/``CTA_EMBED_MODEL`` is a valid configuration;
        callers must treat the missing provider as "embeddings unavailable", never as a reason to
        use chat output.
        """
        if not self._embeddings_resolved:
            if self._settings.ai_mode == "fake":
                self._embeddings = FakeEmbeddingProvider()
            elif self._settings.embeddings_configured:
                from app.discovery.ai_http import OpenAICompatibleEmbeddingProvider

                self._embeddings = OpenAICompatibleEmbeddingProvider(
                    base_url=self._settings.embed_base_url or "",
                    model=self._settings.embed_model or "",
                    api_key=self._settings.embed_api_key,
                )
            else:
                self._embeddings = None
            self._embeddings_resolved = True
        return self._embeddings

    def _build(self, name: str) -> CandidateDiscovery:
        if name == "fake":
            return FakeCandidateDiscovery.from_fixture(self._settings.candidate_index_path)
        if name == "local-embeddinggemma":
            if self._repository is None:
                raise ProviderNotRegistered(
                    "the local-embeddinggemma provider requires an artifact repository; this "
                    "registry was constructed without one",
                    failed_provider=name,
                    registered=self.registered,
                )
            from app.discovery.local_embedding import (
                LocalEmbeddingCandidateDiscovery,
                OnnxEmbeddingRuntime,
                validate_local_endpoint,
            )
            from app.domain.errors import RetrievalUnavailable
            from app.ingestion.repository import GitRepository

            validate_local_endpoint(self._settings.local_embedding_endpoint)
            if self._settings.local_embedding_model_dir is None:
                raise RetrievalUnavailable(
                    "Local inference is enabled but CTA_LOCAL_EMBEDDING_MODEL_DIR is not set; "
                    "no model is downloaded automatically."
                )
            runtime = OnnxEmbeddingRuntime(
                self._settings.local_embedding_model_dir,
                expected_weights_digest=self._settings.local_embedding_weights_digest,
            )
            return LocalEmbeddingCandidateDiscovery(
                self._repository,
                GitRepository(self._settings.fixture_repo),
                runtime=runtime,
            )
        if name == "cocoindex":
            if self._repository is None:
                raise ProviderNotRegistered(
                    "the cocoindex provider requires an artifact repository; this registry was "
                    "constructed without one"
                )
            from app.discovery.code_index import (
                CocoIndexCandidateDiscovery,
                CodeDiscovery,
                configured_model_version,
                live_client,
            )
            from app.ingestion.repository import GitRepository

            discovery = CodeDiscovery(
                repository=self._repository,
                git=GitRepository(self._settings.fixture_repo),
                repository_name=self._settings.fixture,
                client=live_client(self._settings),
                model_version=configured_model_version(self._settings),
                require_live_root=True,
            )
            return CocoIndexCandidateDiscovery(discovery)
        raise AssertionError(f"provider '{name}' is listed as registered but has no builder")
    artifact_id: Annotated[str, Path(pattern=ARTIFACT_ID_PATTERN, description="e.g. REQ-001")],
    store: StoreDep,
    baseline: Annotated[str | None, BASELINE_QUERY] = None,
) -> ThreadResponse:
    """Assembled from the ingested revision; proposals and evidence stay separate arrays."""
    return store.thread(artifact_id, baseline=baseline)


