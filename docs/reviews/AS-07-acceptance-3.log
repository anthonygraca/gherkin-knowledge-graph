import asyncio, hashlib, json
from pathlib import Path
from dataclasses import replace
from fastapi import FastAPI
from starlette.requests import Request
from app.api.routes import post_discovery
from app.api.errors import register_exception_handlers
from app.discovery.registry import ProviderRegistry
from app.domain.api import DiscoveryRequest
from app.domain.errors import DomainError, RetrievalUnavailable
from app.settings import Settings
root=Path.cwd(); settings=Settings(repo_root=root,fixtures_dir=root/'fixtures')
class Repository:
    def get_artifact(self,*args,**kwargs): return object()
repo=Repository()
files=[p for p in (root/'fixtures').rglob('*') if p.is_file() and '.build' not in p.parts]
def hashes(): return {str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
before=hashes()
app=FastAPI(); register_exception_handlers(app)
request=Request({'type':'http','method':'POST','path':'/api/discovery','headers':[]})
class Registry(ProviderRegistry):
    def __init__(self,*a,**kw): super().__init__(*a,**kw); self.calls=[]
    def get(self,name=None): self.calls.append(name); return super().get(name)
class Cocoa(Registry):
    @property
    def registered(self): return ['fake','cocoindex']
class Broken(Cocoa):
    def _build(self,name):
        if name=='cocoindex': raise RetrievalUnavailable('typed construction failure')
        return super()._build(name)
class Failed:
    provider_name='cocoindex'
    def discover(self,*args,**kw): raise RetrievalUnavailable('typed execution failure')
class LocalFailed(Failed): provider_name='local-embeddinggemma'
async def check(label,registry,payload,expected,code=None):
    try:
        body=post_discovery(DiscoveryRequest(**payload),repo,registry,registry._settings).model_dump(mode='json'); status=200
    except DomainError as exc:
        response=await app.exception_handlers[DomainError](request,exc)
        body=json.loads(response.body); status=response.status_code
    assert status==expected,body
    if code: assert body['code']==code,body
    if code=='provider-unavailable': assert body['failed_provider']=='cocoindex',body
    assert registry.calls==[payload.get('provider')],registry.calls
    print(label,status,{k:body[k] for k in ('code','failed_provider','registered_providers','provider','model_version','index_revision') if k in body},'lookups',registry.calls)
    return body
async def main():
    body=await check('empty fake',Registry(settings,repo),{'artifact_id':'REQ-003','baseline':'baseline-a'},200); assert body['candidates']==[]
    body=await check('unknown',Registry(settings,repo),{'artifact_id':'REQ-001','provider':'missing-provider'},400,'provider-not-registered'); assert body['failed_provider']=='missing-provider' and body['registered_providers']==['fake']
    p={'artifact_id':'SCN-001','provider':'cocoindex','baseline':'baseline-a'}
    await check('typed construction',Broken(settings,repo),p,503,'provider-unavailable')
    r=Cocoa(settings,repo); r._cache['cocoindex']=Failed()
    await check('typed execution',r,p,503,'provider-unavailable')
    local=replace(settings,local_embedding_enabled=True)
    await check('local actual builder missing model',Registry(local,repo),{**p,'provider':'local-embeddinggemma'},503,'retrieval-unavailable')
    r=Registry(local,repo); r._cache['local-embeddinggemma']=LocalFailed()
    await check('local typed execution',r,{**p,'provider':'local-embeddinggemma'},503,'retrieval-unavailable')
asyncio.run(main())
assert before==hashes()
