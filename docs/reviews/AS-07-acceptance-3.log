"""Application factory for the CTA API.

Offline by construction: the app reads committed fixture files. It opens no socket, loads
no model, and requires no service other than itself. Building the app requires the
materialized fixtures to exist (run ``tools/fixturectl.py build materialize``).
"""

from __future__ import annotations

from fastapi import FastAPI

from app.api.answer_routes import router as answer_router
from app.api.errors import register_exception_handlers
from app.api.portable_routes import router as portable_router
from app.api.retrieval_lifecycle_routes import router as retrieval_lifecycle_router
from app.api.retrieval_routes import router as retrieval_router
from app.api.review_routes import router as review_router
from app.api.routes import router
from app.assurance.rules import DeterministicAssuranceEvaluator
from app.discovery.registry import ProviderRegistry
from app.ingestion.repository import GitRepository
from app.persistence.ingested import IngestedStore
from app.persistence.portable import PortableRegistry
from app.persistence.review import ReviewWorkspace
from app.retrieval.lifecycle import RetrievalLifecycle
from app.settings import Settings, load_settings
from app.version import PACKAGE_VERSION

DESCRIPTION = """
Continuous Traceability Assurance connects requirements, Gherkin scenarios, source code,
tests, Git revisions, and verification evidence.

Invariants this API upholds:

* **Proposals are not accepted relationships.** `POST /api/discovery` returns candidates;
  they carry no link id and no review state, and accepting one is a separate, audited act.
* **Accepted relationships are not verification.** A link is a claim about intent; evidence
  comes only from recorded test executions pinned to a commit.
* **Change is not failure.** A relevant change after verification yields
  `reverification_required`, never `verification_failed`. Failure requires a recorded
  failing execution at the evaluated baseline.
* **Version-aware.** Artifacts carry a revision and a content hash; findings and evidence
  are pinned to the baseline they were evaluated at.

M3 status: artifacts, links, evidence, and threads are parsed from the nested fixture repository
at the requested revision; `POST /api/ingestion/run` reports what it ingested. `GET /api/findings`
evaluates the deterministic rule set. Discovery proposals are separate from accepted links;
review decisions are append-only workspace events, and the optional local/CocoIndex providers are
plugins behind `CandidateDiscovery`. No endpoint currently returns 501.
"""


def create_app(settings: Settings | None = None) -> FastAPI:
    resolved = settings or load_settings()
    app = FastAPI(
        title="Continuous Traceability Assurance API",
        version=PACKAGE_VERSION,
        description=DESCRIPTION,
        openapi_tags=[
            {"name": "reads", "description": "Implemented over the ingested fixture repository."},
            {"name": "ingestion", "description": "Parses the configured repository at a revision."},
            {
                "name": "assurance",
                "description": "Deterministic rules; no model calls, no network.",
            },
            {"name": "discovery", "description": "Candidate proposals only; never writes links."},
            {
                "name": "portable",
                "description": "Read-only repository-scoped queries for external Gherkin projects.",
            },
            {
                "name": "review",
                "description": "Trusted-local-operator proposal capture, decisions, and workspace.",
            },
            {
                "name": "contract-only",
                "description": "Frozen shape, implementation in a later milestone (501).",
            },
        ],
    )
    app.state.settings = resolved
    app.state.store = IngestedStore.from_settings(resolved)
    app.state.evaluator = DeterministicAssuranceEvaluator(app.state.store)
    app.state.providers = ProviderRegistry(resolved, app.state.store)
    app.state.portable = PortableRegistry()
    app.state.review = ReviewWorkspace(app.state.store, resolved)
    app.state.retrieval = RetrievalLifecycle(
        app.state.store,
        GitRepository(resolved.fixture_repo),
        resolved.retrieval_snapshots,
        repository_name=resolved.fixture,
    )
    register_exception_handlers(app)
    app.include_router(router)
    app.include_router(portable_router)
    app.include_router(retrieval_router)
    app.include_router(answer_router)
    app.include_router(review_router)
    app.include_router(retrieval_lifecycle_router)
    return app


app = create_app()
"""In-process store over the ingested fixture repository.

The store ingests a revision on first use and caches it by resolved commit. It implements the same
``ArtifactRepository`` port as the M0 mock, so consumers did not change; the precomputed thread
replay is gone and threads are assembled from parsed repository data.
"""

from __future__ import annotations

from dataclasses import dataclass, field

from app.domain.api import ThreadResponse
from app.domain.enums import ArtifactType, ReviewState
from app.domain.errors import (
    ArtifactNotFound,
    BaselineNotFound,
    FixtureDataInvalid,
    FixtureDataMissing,
    InvalidRequest,
    ThreadNotFound,
)
from app.domain.models import Artifact, TraceLink, VerificationEvidence
from app.domain.oracle import BaselinesManifest
from app.ingestion import GitRepository, IngestedRevision, IngestionError, ingest_revision
from app.ingestion.thread import assemble_thread
from app.persistence.fixtures import load_model, require_supported_schema_version
from app.settings import Settings


@dataclass
class IngestedStore:
    """Facts parsed from the configured repository, cached by commit."""

    repository: GitRepository
    manifest: BaselinesManifest
    repository_name: str
    _cache: dict[str, IngestedRevision] = field(default_factory=dict)

    @classmethod
    def from_settings(cls, settings: Settings) -> IngestedStore:
        manifest = load_model(settings.baselines_manifest_path, BaselinesManifest)
        require_supported_schema_version(manifest.schema_version, settings.baselines_manifest_path)
        return cls(
            repository=GitRepository(settings.fixture_repo),
            manifest=manifest,
            repository_name=settings.fixture,
        )

    # --------------------------------------------------- ArtifactRepository port

    def baselines(self) -> list[str]:
        return [tag for commit in self.manifest.commits for tag in commit.tags]

    def resolve_baseline(self, baseline: str | None) -> str:
        if baseline is None:
            return self.baselines()[-1]
        if baseline in self.manifest.tags:
            return baseline
        for name, commit in self.manifest.tags.items():
            if commit == baseline:
                return name
        # The documented baseline contract accepts any immutable commit SHA, not only tag
        # targets. This is what makes evidence-only revisions and intermediate commits readable.
        try:
            resolved = self.repository.resolve(baseline)
        except IngestionError:
            resolved = None
        if resolved is not None:
            for name, commit in self.manifest.tags.items():
                if commit == resolved:
                    return name
            return resolved
        known = ", ".join(f"{name} ({commit})" for name, commit in self.manifest.tags.items())
        raise BaselineNotFound(f"Unknown baseline '{baseline}'. Known baselines: {known}")

    def commit_of(self, baseline: str) -> str:
        canonical = self.resolve_baseline(baseline)
        if canonical in self.manifest.tags:
            return self.manifest.tags[canonical]
        return canonical

    def get_artifact(self, artifact_id: str, *, baseline: str | None = None) -> Artifact:
        canonical, revision = self._revision(baseline)
        artifact = revision.artifact(artifact_id)
        if artifact is None:
            known = ", ".join(item.artifact_id for item in revision.artifacts)
            raise ArtifactNotFound(
                f"No artifact '{artifact_id}' at baseline '{canonical}'. Known artifacts: {known}"
            )
        return artifact

    def list_artifacts(self, baseline: str) -> list[Artifact]:
        return list(self._revision(baseline)[1].artifacts)

    def artifacts_at(self, revision: str) -> list[Artifact]:
        return list(self._ingest(revision).artifacts)

    def list_links(
        self, baseline: str, *, review_state: ReviewState | None = None
    ) -> list[TraceLink]:
        revision = self._revision(baseline)[1]
        links = [*revision.accepted_links, *revision.proposed_links]
        if review_state is not None:
            links = [link for link in links if link.review_state is review_state]
        return sorted(links, key=lambda link: link.link_id)

    def list_evidence(self, baseline: str) -> list[VerificationEvidence]:
        return list(self._revision(baseline)[1].evidence)

    def changed_artifacts(self, baseline: str, previous: str) -> list[str]:
        current = {
            artifact.artifact_id: artifact.content_hash
            for artifact in self._revision(baseline)[1].artifacts
        }
        before = {
            artifact.artifact_id: artifact.content_hash
            for artifact in self._revision(previous)[1].artifacts
        }
        return sorted(
            artifact_id
            for artifact_id in current.keys() | before.keys()
            if current.get(artifact_id) != before.get(artifact_id)
        )

    def impacted_links(self, baseline: str, previous: str) -> list[TraceLink]:
        changed = set(self.changed_artifacts(baseline, previous))
        return sorted(
            (
                link
                for link in self.list_links(
                    self.resolve_baseline(baseline), review_state=ReviewState.ACCEPTED
                )
                if link.source_id in changed or link.target_id in changed
            ),
            key=lambda link: link.link_id,
        )

    # ------------------------------------------- fixture-facing read helpers

    def baseline_commits(self) -> dict[str, str]:
        """Fixture addition used by ``/health``: baseline name -> resolved commit SHA."""
        return dict(self.manifest.tags)

    def label_of(self, commit: str) -> str:
        """Baseline name for a commit, by tag or by content-equivalent artifact set.

        Evidence is pinned to the commit that was actually tested, which is usually the source
        commit of a two-commit baseline. Reporting that SHA in prose ("passed at 903977de…") is
        accurate but unreadable, so a commit whose artifact content equals a baseline is labelled
        with that baseline. Content equality — never SHA equality — is the criterion.
        """
        exact = next((name for name, value in self.manifest.tags.items() if value == commit), None)
        if exact is not None:
            return exact
        try:
            current = {
                artifact.artifact_id: artifact.content_hash
                for artifact in self._ingest(commit).artifacts
            }
        except Exception:  # noqa: BLE001 - an unreadable revision has no label
            return commit
        for name, value in self.manifest.tags.items():
            try:
                candidate = {
                    artifact.artifact_id: artifact.content_hash
                    for artifact in self._ingest(value).artifacts
                }
            except Exception:  # noqa: BLE001
                continue
            if candidate == current:
                return name
        return commit

    def thread(self, root_id: str, *, baseline: str | None = None) -> ThreadResponse:
        canonical, revision = self._revision(baseline)
        artifact = revision.artifact(root_id)
        if artifact is None:
            raise ArtifactNotFound(f"No artifact '{root_id}' at baseline '{canonical}'.")
        if artifact.artifact_type is not ArtifactType.REQUIREMENT:
            raise ThreadNotFound(
      null,
    snapshot.index_revision ??
      (event.link.provenance.index_revision as string | undefined) ??
      null,
    kinds,
  );
}

function CandidatePanel({
  catalog,
  artifacts,
  source,
  onSource,
  provider,
  onProvider,
  custom,
  onCustom,
  providerKinds,
  loading,
  data,
  error,
  onDiscover,
}: {
  catalog: ProviderCatalogResponse;
  artifacts: Artifact[];
  source: string;
  onSource: (value: string) => void;
  provider: string;
  onProvider: (value: string) => void;
  custom: string;
  onCustom: (value: string) => void;
  providerKinds: ProviderKinds;
  loading: boolean;
  data: { baseline: string; source: string; response: DiscoveryResponse } | null;
  error: ApiError | null;
  onDiscover: () => void;
}) {
  const problem = error instanceof ApiError ? error.problem : undefined;
  const failed = problem?.failed_provider;
  const registered = problem?.registered_providers;
  return (
    <section aria-labelledby="candidates-heading">
      <h2 id="candidates-heading">Discovery candidates</h2>
      <p className="source-note">
        Default provider: <strong>{catalog.default}</strong>. Candidates are proposals, never
        accepted links.
      </p>
      <div className="candidate-controls">
        <label>
          Source artifact
          <select
            aria-label="Source artifact"
            value={source}
            onChange={(event) => onSource(event.target.value)}
          >
            {artifacts.map((artifact) => (
              <option key={artifact.artifact_id} value={artifact.artifact_id}>
                {artifact.artifact_id} · {artifact.artifact_type}
              </option>
            ))}
          </select>
        </label>
        <label>
          Provider
          <select
            aria-label="Provider"
            value={provider}
            onChange={(event) => onProvider(event.target.value)}
          >
            {catalog.providers.map((item) => (
              <option key={item.name} value={item.name}>
  return (
    <table>
      <thead>
        <tr>
          <th>Evidence</th>
          <th>Test / scenario</th>
          <th>Result</th>
          <th>Executed</th>
        </tr>
      </thead>
      <tbody>
        {evidence.map((item) => (
          <tr key={item.evidence_id}>
            <td>{item.evidence_id}</td>
            <td>
              {item.test_id}
              {item.scenario_id ? ` / ${item.scenario_id}` : ""}
            </td>
            <td>
              <span className={`badge ${item.result === "passed" ? "good" : "bad"}`}>
                {item.result}
              </span>
            </td>
            <td>{item.executed_at}</td>
          </tr>
        ))}
      </tbody>
    </table>
  );
}

export interface AppProps {
  api?: Api;
}

export function App({ api }: AppProps) {
  const client = useMemo(() => api ?? createApi(), [api]);
  const [health, setHealth] = useState<Health | null>(null);
