+        json={"artifact_id": "REQ-001", "provider": "cocoindex", "baseline": "baseline-a"},
+    )
+    assert response.status_code == 503
+    assert response.json()["code"] == "provider-unavailable"
+    assert response.json()["failed_provider"] == "cocoindex"
