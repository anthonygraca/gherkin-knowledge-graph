                index_revision=response.index_binding,
                rationale=(
                    f"{hit.method.value} {hit.path}:{hit.start_line}-{hit.end_line} "
                    f"raw_score={hit.raw_score:.6f}; snapshot={response.index_binding}; "
                    f"template={QUERY_TEMPLATE}"
                ),
