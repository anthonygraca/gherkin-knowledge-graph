class ReviewJournal:
    """Committed-pair append-only journal with rollback and poison semantics.

    ``_fsync`` and ``_truncate`` are overridable so tests can exercise the failure boundary
    without patching global ``os`` functions. Production uses the real syscalls.
    """

    def __init__(self, path: Path) -> None:
        self.path = path
        self.poison_path = path.with_name(path.name + ".poisoned")
        self._events: list[ReviewEvent] = []
        self._lock = threading.RLock()
        self._uncommitted_tail = False
        self._poisoned = self.poison_path.exists()
        self._committed_offset = 0
        self._replay()

    @property
    def events(self) -> list[ReviewEvent]:
        return list(self._events)

    @property
    def review_revision(self) -> int:
        return len(self._events)

    @property
    def blocked(self) -> str | None:
        if self._poisoned:
            return "journal contains an unconfirmed record; operator reconciliation is required"
        if self._uncommitted_tail:
            return "journal ends with an uncommitted record; truncate it before further writes"
        return None

    # ---------------------------------------------------------------- replay

    def _replay(self) -> None:
        if not self.path.exists():
            return
        raw = self.path.read_bytes()
        if not raw:
            return
        terminated = raw.endswith(b"\n")
        lines = raw.split(b"\n")
        if terminated:
            lines = lines[:-1]
        else:
            # The final segment is an incomplete append, never a committed record.
            self._uncommitted_tail = True
            lines = lines[:-1]

        offset = 0
        index = 0
        while index < len(lines):
            payload_line = lines[index]
            if index + 1 >= len(lines):
                self._uncommitted_tail = True
                break
            commit_line = lines[index + 1]
            try:
                payload_raw = json.loads(payload_line)
                commit_raw = json.loads(commit_line)
            except json.JSONDecodeError as exc:
                if index + 2 >= len(lines) and not terminated:
                    self._uncommitted_tail = True
                    break
                raise ReviewStorageUnavailable(
                    f"Review journal {self.path} contains a malformed committed record: {exc}",
                    durability="indeterminate",
                ) from exc
            if not isinstance(commit_raw, dict) or "commit" not in commit_raw:
                self._uncommitted_tail = True
                break
"""Read-only Git access for ingestion.

Uses the Git CLI — the project's documented prerequisite (roadmap §3, docs/setup.md) — and
reads committed objects, never the working tree. Only the operations ingestion needs are
exposed; there is no write path.

Paths and blob contents are treated as untrusted input: paths come from ``git ls-tree -z`` and
object expressions are terminated with ``--end-of-options`` so a repository cannot smuggle a
command-line option into a revision expression.
"""

from __future__ import annotations

import subprocess
from dataclasses import dataclass
from pathlib import Path

from app.ingestion.errors import IngestionError

GIT_READ_FLAGS = ("-c", "core.autocrlf=false")


@dataclass(frozen=True)
class TreeEntry:
    """One ``git ls-tree -r -l`` row: a blob, symlink, or submodule at a path."""

    mode: str
    object_type: str
    object_id: str
    path: str
    size: int | None


@dataclass(frozen=True)
class GitRepository:
    """A repository read at explicit revisions."""

    root: Path

    def resolve(self, revision: str | None = None) -> str:
        """Resolve a revision expression (tag, SHA, branch) to a commit SHA.

        ``None`` selects the repository's current ``HEAD``. An unknown expression raises.
        """
        expression = revision or "HEAD"
        output = self._run("rev-parse", "--verify", "--end-of-options", f"{expression}^{{commit}}")
        return output.decode("utf-8", "replace").strip()

    def list_paths(self, revision: str) -> list[str]:
        """Every file path in the revision's tree, sorted, NUL-delimited for exact names."""
        output = self._run("ls-tree", "-r", "-z", "--name-only", revision)
        paths = [entry.decode("utf-8") for entry in output.split(b"\0") if entry]
        return sorted(paths)

    def list_tree(self, revision: str) -> list[TreeEntry]:
        """Tree entries with mode, object id, and size, in one Git invocation.

        The portable indexer needs the object id (to read blobs without re-resolving paths) and the
        mode (to refuse symlinks and submodules instead of treating them as regular files).
        """
        output = self._run("ls-tree", "-r", "-z", "-l", revision)
        entries: list[TreeEntry] = []
        for record in output.split(b"\0"):
            if not record:
                continue
            header, _, raw_path = record.partition(b"\t")
            fields = header.decode("utf-8", "replace").split()
            if len(fields) < 4:
                raise IngestionError(f"unexpected `git ls-tree` record: {record!r}")
            mode, object_type, object_id = fields[0], fields[1], fields[2]
            size_field = fields[3]
            entries.append(
                TreeEntry(
                    mode=mode,
                    object_type=object_type,
                    object_id=object_id,
                    path=raw_path.decode("utf-8"),
                    size=int(size_field) if size_field.isdigit() else None,
                )
            )
    summary="Propose candidate links for a source artifact (never accepts them)",
)
def post_discovery(
    payload: DiscoveryRequest,
    repository: RepositoryDep,
    providers: ProvidersDep,
    settings: SettingsDep,
) -> DiscoveryResponse:
    repository.get_artifact(payload.artifact_id)  # 404 when the source artifact is unknown
    resolved = payload.provider or settings.discovery_provider
    try:
        provider = providers.get(payload.provider)  # 400 when the provider name is unknown
    except DomainError:
        raise
    except Exception as exc:  # noqa: BLE001 - provider construction is an availability boundary
        logger.warning(
            "discovery provider %s could not be constructed for %s: %s",
            resolved,
            payload.artifact_id,
            exc,
        )
        raise ProviderUnavailable(
            f"Discovery provider {resolved!r} could not be constructed: {exc}",
            failed_provider=resolved,
        ) from exc
    try:
        candidates = provider.discover(
            payload.artifact_id,
            top_k=payload.top_k,
            relation_types=payload.relation_types,
            baseline=payload.baseline,
        )
    except DomainError:
        raise
    except Exception as exc:  # noqa: BLE001 - provider plugins are an availability boundary
        logger.warning(
            "discovery provider %s failed for %s at %s: %s",
            provider.provider_name,
            payload.artifact_id,
            payload.baseline,
            exc,
        )
        raise ProviderUnavailable(
            f"Discovery provider {provider.provider_name!r} could not execute for "
            f"{payload.artifact_id!r} at {payload.baseline or 'the latest baseline'}: {exc}",
            failed_provider=provider.provider_name,
        ) from exc
    return DiscoveryResponse(
        schema_version=SCHEMA_VERSION,
        artifact_id=payload.artifact_id,
        provider=provider.provider_name,
        model_version=provider.model_version,
        # Prefer the per-candidate binding for the requested baseline when one exists; the
        # provider-level attribute is only a construction-time default.
        index_revision=(
            candidates[0].index_revision
            if candidates
            else (
                provider.binding_for(payload.baseline)
                if hasattr(provider, "binding_for")
                else provider.index_revision
            )
        ),
        candidates=candidates,
    )


