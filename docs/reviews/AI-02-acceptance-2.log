     1	"""Provider lookup.
     2	
     3	Candidate discovery is still fixture-backed (``fake``); real providers register behind the same
     4	:class:`CandidateDiscovery` port in a later story. The optional chat and embedding providers are
     5	built lazily from :class:`app.settings.Settings`: fake mode returns deterministic fakes, live mode
     6	builds the HTTP adapters only when asked, and a live configuration without an embeddings endpoint
     7	reports embeddings as unavailable rather than substituting chat completions.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	from app.discovery.ai import ChatGenerationProvider, EmbeddingProvider
    13	from app.discovery.ai_fake import FakeChatGenerationProvider, FakeEmbeddingProvider
    14	from app.discovery.fake import FakeCandidateDiscovery
    15	from app.domain.errors import ProviderNotRegistered
    16	from app.domain.ports import ArtifactRepository, CandidateDiscovery
    17	from app.settings import Settings
    18	
    19	REGISTERED_PROVIDERS: tuple[str, ...] = ("fake",)
    20	
    21	#: Presentation metadata, independent of the effective registry. Disabling an optional provider
    22	#: must not erase the meaning of provenance recorded by an earlier proposal (AS-07).
    23	PROVIDER_KINDS: dict[str, str] = {
    24	    "fake": "fixture",
    25	    "cocoindex": "model",
    26	    "local-embeddinggemma": "model",
    27	}
    28	
    29	DEFAULT_PROVIDER = "fake"
    30	
    31	
    32	class ProviderRegistry:
    33	    """Builds providers on demand and caches them per process."""
    34	
    35	    def __init__(self, settings: Settings, repository: ArtifactRepository | None = None) -> None:
    36	        self._settings = settings
    37	        self._repository = repository
    38	        self._cache: dict[str, CandidateDiscovery] = {}
    39	        self._chat: ChatGenerationProvider | None = None
    40	        self._embeddings: EmbeddingProvider | None = None
    41	        self._embeddings_resolved = False
    42	
    43	    @property
    44	    def registered(self) -> list[str]:
    45	        providers = list(REGISTERED_PROVIDERS)
    46	        if self._settings.cocoindex_enabled:
    47	            providers.append("cocoindex")
    48	        if self._settings.local_embedding_enabled:
    49	            providers.append("local-embeddinggemma")
    50	        return providers
    51	
    52	    def catalog(self) -> list[dict[str, object]]:
    53	        """Effective providers with presentation kind; never a hand-maintained copy."""
    54	        default = (
    55	            self._settings.discovery_provider
    56	            if self._settings.discovery_provider in self.registered
    57	            else DEFAULT_PROVIDER
    58	        )
    59	        return [
    60	            {
    61	                "name": name,
    62	                "kind": PROVIDER_KINDS.get(name, "unknown"),
    63	                "default": name == default,
    64	            }
    65	            for name in self.registered
    66	        ]
    67	
    68	    def get(self, name: str | None = None) -> CandidateDiscovery:
    69	        resolved = name or self._settings.discovery_provider
    70	        if resolved not in self.registered:
    71	            raise ProviderNotRegistered(
    72	                f"Unknown discovery provider '{resolved}'. Registered providers: "
    73	                f"{', '.join(self.registered)}. Code-search candidates arrive with AI-06 "
    74	                f"PR 2; they are optional plugins and never required for tests.",
    75	                failed_provider=resolved,
    76	                registered=self.registered,
    77	            )
    78	        if resolved not in self._cache:
    79	            self._cache[resolved] = self._build(resolved)
    80	        return self._cache[resolved]
    81	
    82	    def chat(self) -> ChatGenerationProvider:
    83	        """The configured chat provider. Construction never contacts the endpoint."""
    84	        if self._chat is None:
    85	            if self._settings.ai_mode == "fake":
    86	                self._chat = FakeChatGenerationProvider()
    87	            else:
    88	                from app.discovery.ai_http import OpenAICompatibleChatProvider
    89	
    90	                self._chat = OpenAICompatibleChatProvider(
    91	                    base_url=self._settings.llm_base_url or "",
    92	                    model=self._settings.llm_model or "",
    93	                    api_key=self._settings.llm_api_key,
    94	                )
    95	        return self._chat
    96	
    97	    def embeddings(self) -> EmbeddingProvider | None:
    98	        """The configured embedding provider, or ``None`` when none is available.
    99	
   100	        A live mode without ``CTA_EMBED_BASE_URL``/``CTA_EMBED_MODEL`` is a valid configuration;
   101	        callers must treat the missing provider as "embeddings unavailable", never as a reason to
   102	        use chat output.
   103	        """
   104	        if not self._embeddings_resolved:
   105	            if self._settings.ai_mode == "fake":
   106	                self._embeddings = FakeEmbeddingProvider()
   107	            elif self._settings.embeddings_configured:
   108	                from app.discovery.ai_http import OpenAICompatibleEmbeddingProvider
   109	
   110	                self._embeddings = OpenAICompatibleEmbeddingProvider(
   111	                    base_url=self._settings.embed_base_url or "",
   112	                    model=self._settings.embed_model or "",
   113	                    api_key=self._settings.embed_api_key,
   114	                )
   115	            else:
   116	                self._embeddings = None
   117	            self._embeddings_resolved = True
   118	        return self._embeddings
   119	
   120	    def _build(self, name: str) -> CandidateDiscovery:
   121	        if name == "fake":
   122	            return FakeCandidateDiscovery.from_fixture(self._settings.candidate_index_path)
   123	        if name == "local-embeddinggemma":
   124	            if self._repository is None:
   125	                raise ProviderNotRegistered(
   126	                    "the local-embeddinggemma provider requires an artifact repository; this "
   127	                    "registry was constructed without one",
   128	                    failed_provider=name,
   129	                    registered=self.registered,
   130	                )
   131	            from app.discovery.local_embedding import (
   132	                LocalEmbeddingCandidateDiscovery,
   133	                OnnxEmbeddingRuntime,
   134	                validate_local_endpoint,
   135	            )
   136	            from app.domain.errors import RetrievalUnavailable
   137	            from app.ingestion.repository import GitRepository
   138	
   139	            validate_local_endpoint(self._settings.local_embedding_endpoint)
   140	            if self._settings.local_embedding_model_dir is None:
   141	                raise RetrievalUnavailable(
   142	                    "Local inference is enabled but CTA_LOCAL_EMBEDDING_MODEL_DIR is not set; "
   143	                    "no model is downloaded automatically."
   144	                )
   145	            runtime = OnnxEmbeddingRuntime(
   146	                self._settings.local_embedding_model_dir,
   147	                expected_weights_digest=self._settings.local_embedding_weights_digest,
   148	            )
   149	            return LocalEmbeddingCandidateDiscovery(
   150	                self._repository,
   151	                GitRepository(self._settings.fixture_repo),
   152	                runtime=runtime,
   153	            )
   154	        if name == "cocoindex":
   155	            if self._repository is None:
   156	                raise ProviderNotRegistered(
   157	                    "the cocoindex provider requires an artifact repository; this registry was "
   158	                    "constructed without one"
   159	                )
   160	            from app.discovery.code_index import (
   161	                CocoIndexCandidateDiscovery,
   162	                CodeDiscovery,
   163	                configured_model_version,
   164	                live_client,
   165	            )
   166	            from app.ingestion.repository import GitRepository
   167	
   168	            discovery = CodeDiscovery(
   169	                repository=self._repository,
   170	                git=GitRepository(self._settings.fixture_repo),
   171	                repository_name=self._settings.fixture,
   172	                client=live_client(self._settings),
   173	                model_version=configured_model_version(self._settings),
   174	                require_live_root=True,
   175	            )
   176	            return CocoIndexCandidateDiscovery(discovery)
   177	        raise AssertionError(f"provider '{name}' is listed as registered but has no builder")

