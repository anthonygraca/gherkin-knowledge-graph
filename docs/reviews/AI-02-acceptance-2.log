    59	@dataclass
    60	class OnnxEmbeddingRuntime:
    61	    """CPU ONNX runtime for the EmbeddingGemma 2 text model.
    62	
    63	    Lazy imports keep the default offline suite free of onnxruntime/tokenizers. The runtime
    64	    validates every embedding (finite, expected dimension, non-zero norm) before returning it.
    65	    """
    66	
    67	    model_dir: Path
    68	    expected_weights_digest: str | None = None
    69	    max_tokens: int = MAX_TOKENS
    70	    threads: int = 4
    71	    model_id: str = MODEL_ID
    72	    runtime_version: str = field(init=False)
    73	    weights_digest: str = field(init=False)
    74	    dimension: int = DIMENSION
    75	    _session: object = field(init=False, repr=False)
    76	    _tokenizer: object = field(init=False, repr=False)
    77	    _numpy: object = field(init=False, repr=False)
    78	
    79	    def __post_init__(self) -> None:
    80	        missing = [
    81	            name
    82	            for name in (*WEIGHTS_FILES, TOKENIZER_FILE)
    83	            if not (self.model_dir / name).is_file()
    84	        ]
    85	        if missing:
    86	            raise RetrievalUnavailable(
    87	                "Local EmbeddingGemma 2 weights are not installed under "
    88	                f"{self.model_dir}: missing {', '.join(missing)}. No download or remote fallback "
    89	                "is attempted."
    90	            )
    91	        digest = _weights_digest(self.model_dir)
    92	        if self.expected_weights_digest is not None and digest != self.expected_weights_digest:
    93	            raise RetrievalUnavailable(
    94	                f"Local weights digest {digest} does not match the configured "
    95	                f"{self.expected_weights_digest}; refusing to use different weights. "
    96	                "No download or remote fallback is attempted."
    97	            )
    98	        try:
    99	            import numpy as np
   100	            import onnxruntime as ort
   101	            from tokenizers import Tokenizer
   102	        except ImportError as exc:
   103	            raise RetrievalUnavailable(
   104	                "The local-embedding runtime is not installed; run "
   105	                "'uv sync --project backend --extra local-embedding' on this machine. "
   106	                "No download or remote fallback is attempted."
   107	            ) from exc
   108	        self._numpy = np
   109	        self.weights_digest = digest
   110	        self.runtime_version = f"onnxruntime {ort.__version__}"
   111	        options = ort.SessionOptions()
   112	        options.intra_op_num_threads = max(1, self.threads)
   113	        options.inter_op_num_threads = 1
   114	        self._session = ort.InferenceSession(
   115	            str(self.model_dir / WEIGHTS_FILES[0]),
   116	            sess_options=options,
   117	            providers=["CPUExecutionProvider"],
   118	        )
   119	        self._tokenizer = Tokenizer.from_file(str(self.model_dir / TOKENIZER_FILE))
   120	        self._tokenizer.enable_truncation(max_length=self.max_tokens)
   121	
   122	    @property
   123	    def model_version(self) -> str:
   124	        return f"{self.model_id}@{self.weights_digest[:12]}"
   125	
   126	    def embed(self, texts: list[str]) -> list[list[float]]:
   127	        vectors: list[list[float]] = []
   128	        for text in texts:
   129	            encoding = self._tokenizer.encode(text)
   130	            ids = self._numpy.asarray([encoding.ids], dtype=self._numpy.int64)
   131	            mask = self._numpy.ones_like(ids)
   132	            empty = self._numpy.zeros((0, 512), dtype=self._numpy.float32)
   133	            feed = {
   134	                "input_ids": ids,
   135	                "attention_mask": mask,
   136	                "image_features": empty,
   137	                "video_features": empty,
   138	                "audio_features": empty,
   139	            }
   140	            embedding = self._session.run(["sentence_embedding"], feed)[0][0]
   141	            vector = [float(value) for value in embedding]
   142	            if len(vector) != self.dimension:
   143	                raise RetrievalUnavailable(
   144	                    f"Local embedding returned dimension {len(vector)}, expected {self.dimension}."
   145	                )
   146	            if not all(math.isfinite(value) for value in vector):
   147	                raise RetrievalUnavailable("Local embedding returned a non-finite value.")
   148	            norm = math.sqrt(sum(value * value for value in vector))
   149	            if norm <= 0:
   150	                raise RetrievalUnavailable("Local embedding returned a zero vector.")
   151	            vectors.append([value / norm for value in vector])
   152	        return vectors
