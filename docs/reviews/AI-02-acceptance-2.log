/**
 * Opt-in live local-model acceptance run (AI-02 SCN-3205).
 *
 * Run under an OS-level network denial, for example:
 *   unshare -rn env CTA_EGRESS_DENIED=1 CTA_LOCAL_EMBEDDING_MODEL_DIR=... \
 *     npx cucumber-js --config cucumber.live.mjs
 */
import base from './cucumber.mjs';

export default {
  ...base,
  tags: '@live-local',
  format: ['summary', 'message:reports/cucumber-live-messages.ndjson'],
  formatOptions: { snippetInterface: 'async-await' },
};
/**
 * Cucumber configuration for CTA's own acceptance suite.
 *
 * Feature files stay where the lifecycle put them (`docs/stories/*.feature`); nothing is copied or
 * rewritten. Two features are excluded by tag and documented in the inventory:
 * `@FT-03` (process/governance checks verified by inspection) and `@AI-06` (M3 slice).
 *
 * Reports are written as Cucumber Messages NDJSON, the same format the portable adapter ingests.
 */
export default {
  import: ['support/world.js', 'support/ui.js', 'step_definitions/**/*.js'],
  paths: ['../docs/stories/*.feature'],
  tags: 'not @FT-03 and not @AI-06 and not @superseded-by-AS-01 and not @refinement-draft and not @live-local',
  format: [
    'summary',
    'message:reports/cucumber-messages.ndjson',
    'json:reports/cucumber.json',
  ],
  formatOptions: { snippetInterface: 'async-await' },
  parallel: 1,
  retry: 0,
};
import { After, Before, setWorldConstructor } from '@cucumber/cucumber';
import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const ROOT = path.resolve(import.meta.dirname, '../..');
const PYTHON =
  process.env.CTA_BDD_PYTHON || path.join(ROOT, 'backend', '.venv', 'bin', 'python');
const BRIDGE = path.join(ROOT, 'bdd', 'support', 'cta_bridge.py');

export class CtaWorld {
  constructor() {
    this.stateDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cta-bdd-'));
    this.results = {};
  }

  invoke(op, args = {}) {
    const stdout = execFileSync(PYTHON, [BRIDGE], {
      input: JSON.stringify({ op, args }),
      env: {
        ...process.env,
        CTA_BDD_STATE: this.stateDir,
        CTA_REPO_ROOT: ROOT,
        CTA_FIXTURES_DIR: path.join(ROOT, 'fixtures'),
      },
      encoding: 'utf8',
      maxBuffer: 128 * 1024 * 1024,
    });
    return JSON.parse(stdout);
  }

  call(op, args = {}) {
    const response = this.invoke(op, args);
    if (!response.ok) {
      throw new Error(`${response.error.type || 'Error'}: ${response.error.detail}`);
    }
    return response.result;
  }

  attempt(op, args = {}) {
    return this.invoke(op, args);
  }
}

setWorldConstructor(CtaWorld);

Before(function () {
  this.results = {};
});

After(function () {
  try {
    if (this.results.expectedFailures) {
      assert.deepEqual(
        [...this.results.fixtureRun.failed].sort(),
        [...this.results.expectedFailures].sort(),
        'fixture suite failed in a different set of tests than the scenario named',
      );
    }
  } finally {
    fs.rmSync(this.stateDir, { recursive: true, force: true });
  }
});
"""Shared fixtures for the offline test suite.

Rules for this suite (see AGENTS.md):

* No network, no model download, no GPU, no external service, no Docker.
* Expectations come from hand-labeled oracle files, never from the output of the code under
  test — that would be a tautology, not a test.
* Generated fixture files are treated as inputs; one test (``test_fixture_drift.py``) proves
  they are still what the generator produces.
"""

from __future__ import annotations

import hashlib
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

import pytest
from fastapi.testclient import TestClient

