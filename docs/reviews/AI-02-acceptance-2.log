  "scripts": {
    "bdd": "cucumber-js",
    "bdd:strict": "node tools/step-resolution.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "playwright-core": "^1.65.1"
  }
}

