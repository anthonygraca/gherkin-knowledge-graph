   264	            return list(requested)
   265	        if source.artifact_type is ArtifactType.REQUIREMENT:
   266	            return [RelationType.VERIFIED_BY]
   267	        if source.artifact_type is ArtifactType.SCENARIO:
   268	            return [RelationType.IMPLEMENTED_BY, RelationType.EXERCISED_BY]
   269	        return []
   270	
   271	    def _targets(
   272	        self, corpus: _Corpus, source: Artifact, allowed: list[RelationType]
   273	    ) -> list[Artifact]:
   274	        artifacts = {
   275	            artifact.artifact_id: artifact
   276	            for artifact in self._repository.list_artifacts(corpus.baseline)
   277	        }
   278	        targets: list[Artifact] = []
   279	        for relation in allowed:
   280	            expected_source, expected_target = RELATION_DIRECTION[relation]
   281	            if source.artifact_type is not expected_source:
   282	                continue
   283	            for artifact in artifacts.values():
   284	                if artifact.artifact_type is expected_target:
   285	                    targets.append(artifact)
   286	        unique = {artifact.artifact_id: artifact for artifact in targets}
   287	        return sorted(unique.values(), key=lambda artifact: artifact.artifact_id)
   288	
   289	    def _corpus(self, baseline: str) -> _Corpus:
   290	        with self._lock:
   291	            cached = self._corpora.get(baseline)
   292	            if cached is not None:
   293	                return cached
   294	            commit = self._repository.commit_of(baseline)
   295	            artifacts = self._repository.list_artifacts(baseline)
   296	            documents: dict[str, str] = {}
   297	            locators: dict[str, str] = {}
   298	            for artifact in artifacts:
   299	                documents[artifact.artifact_id] = self._document_text(artifact, commit)
   300	                locators[artifact.artifact_id] = artifact.locator
   301	            binding = _binding(
   302	                baseline=baseline,
   303	                commit=commit,
   304	                artifacts=artifacts,
   305	                model_version=self.model_version,
   306	                weights_digest=getattr(self._runtime, "weights_digest", "unknown"),
   307	                formatting=self.formatting_version,
   308	            )
   309	            embeddings: dict[str, list[float]] = {}
   310	            if artifacts:
   311	                vectors = self._runtime.embed([documents[a.artifact_id] for a in artifacts])
   312	                if len(vectors) != len(artifacts):
   313	                    raise RetrievalUnavailable(
   314	                        "Local embedding runtime returned a different number of vectors "
   315	                        "than inputs."
   316	                    )
   317	                for artifact, vector in zip(artifacts, vectors, strict=True):
   318	                    embeddings[artifact.artifact_id] = self._validate_vector(vector)
   319	            corpus = _Corpus(
   320	                baseline=baseline,
   321	                commit=commit,
   322	                binding=binding,
   323	                documents=documents,
   324	                embeddings=embeddings,
   325	                locators=locators,
   326	            )
   327	            self._corpora[baseline] = corpus
   328	            return corpus
   329	
   330	    def _validate_vector(self, vector: list[float]) -> list[float]:
   331	        if len(vector) != self._runtime.dimension:
   332	            raise RetrievalUnavailable(
   333	                f"Local embedding returned dimension {len(vector)}, expected "
   334	                f"{self._runtime.dimension}."
   335	            )
   336	        if not all(math.isfinite(value) for value in vector):
   337	            raise RetrievalUnavailable("Local embedding returned a non-finite value.")
   338	        norm = math.sqrt(sum(value * value for value in vector))
   339	        if norm <= 0:
   340	            raise RetrievalUnavailable("Local embedding returned a zero vector.")
   341	        return [value / norm for value in vector]
   342	
   343	    def _document_text(self, artifact: Artifact, commit: str) -> str:
   344	        path = artifact.locator.split("#", 1)[0]
   345	        try:
   346	            raw = self._git.read_blob(commit, path)
   347	        except Exception:  # noqa: BLE001 - an unreadable artifact is not a candidate
   348	            raw = b""
   349	        content = raw.decode("utf-8", "replace")
   350	        if artifact.artifact_type is ArtifactType.SCENARIO:
   351	            content = _scenario_block(content, artifact.locator) or artifact.title
   352	        return DOCUMENT_TEMPLATE.format(title=artifact.locator, content=content)
   353	
   354	    def _query_text(self, source: Artifact, corpus: _Corpus) -> str:
   355	        path = source.locator.split("#", 1)[0]
   356	        try:
   357	            raw = self._git.read_blob(corpus.commit, path)
   358	        except Exception:  # noqa: BLE001
   359	            raw = b""
   360	        content = raw.decode("utf-8", "replace")
   361	        if source.artifact_type is ArtifactType.SCENARIO:
   362	            content = _scenario_block(content, source.locator) or source.title
   363	            template = QUERY_TEMPLATE_CODE
   364	        else:
   365	            template = QUERY_TEMPLATE_SEARCH
   366	        return f"{template}{source.title}\n{content}".strip()
   367	
   368	
   369	def _relation_between(
   370	    source_type: ArtifactType,
   371	    target_type: ArtifactType,
   372	    allowed: Sequence[RelationType],
   373	) -> RelationType:
   374	    for relation in allowed:
   375	        if RELATION_DIRECTION[relation] == (source_type, target_type):
   376	            return relation
   377	    raise InvalidRequest(
   378	        f"No allowed relation connects {source_type.value} -> {target_type.value}."
   379	    )
   380	
   381	
   382	def _weights_digest(model_dir: Path) -> str:
   383	    digest = hashlib.sha256()
   384	    for name in WEIGHTS_FILES:
   385	        path = model_dir / name
   386	        digest.update(name.encode("utf-8"))
   387	        with path.open("rb") as handle:
   388	            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
   389	                digest.update(chunk)
   390	    return f"sha256:{digest.hexdigest()}"
   391	
   392	
   393	def _binding(
   394	    *,
   395	    baseline: str,
   396	    commit: str,
   397	    artifacts: list[Artifact],
   398	    model_version: str,
   399	    weights_digest: str,
   400	    formatting: str,
   401	) -> str:
   402	    payload = {
   403	        "baseline": baseline,
   404	        "commit": commit,
   405	        "model_version": model_version,
   406	        "weights_digest": weights_digest,
   407	        "formatting": formatting,
   408	        "dimension": DIMENSION,
   409	        "artifacts": [
   410	            {
   411	                "artifact_id": artifact.artifact_id,
   412	                "artifact_type": str(artifact.artifact_type),
   413	                "locator": artifact.locator,
   414	                "revision": artifact.revision,
   415	                "content_hash": artifact.content_hash,
   416	            }
   417	            for artifact in sorted(artifacts, key=lambda item: item.artifact_id)
   418	        ],
   419	    }
   420	    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   421	    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"
   422	
   423	
   424	def _scenario_block(text: str, locator: str) -> str | None:
   425	    anchor = locator.split("#", 1)[1] if "#" in locator else None
   426	    if anchor is None:
   427	        return None
   428	    lines = text.splitlines()
   429	    start = next((index for index, line in enumerate(lines) if f"@{anchor}" in line), None)
   430	    if start is None:
   431	        return None
   432	    end = len(lines)
   433	    for index in range(start + 1, len(lines)):
   434	        if _ARTIFACT_TAG.search(lines[index]) and lines[index].lstrip().startswith("@"):
   435	            end = index
   436	            break
   437	    return "\n".join(lines[start:end]).strip()
   438	
   439	
   440	def validate_local_endpoint(endpoint: str | None) -> None:
   441	    """Refuse a non-loopback endpoint before any connection is attempted."""
   442	    if endpoint is None:
   443	        return
   444	    from urllib.parse import urlsplit
   445	
   446	    parsed = urlsplit(endpoint)
   447	    if parsed.hostname not in _LOOPBACK_HOSTS:
   448	        raise InvalidRequest(
   449	            f"Local inference mode refuses endpoint {endpoint!r}: only loopback endpoints "
   450	            "are permitted; no connection was attempted."
   451	        )
   452	
