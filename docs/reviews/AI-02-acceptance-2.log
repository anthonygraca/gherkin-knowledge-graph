    33	class KeywordRuntime:
    34	    model_id = "embeddinggemma-2-text-270m-q8_0"
    35	    weights_digest = "sha256:" + "a" * 64
    36	    runtime_version = "deterministic-keyword-runtime"
    37	    dimension = 3
    38	    max_tokens = 512
    39	
    40	    def embed(self, texts: list[str]) -> list[list[float]]:
    41	        vectors: list[list[float]] = []
    42	        for text in texts:
    43	            lowered = text.lower()
    44	            vector = [0.0, 0.0, 0.0]
    45	            if "withdraw" in lowered:
    46	                vector[0] += 1.0
    47	            if "transfer" in lowered:
    48	                vector[1] += 1.0
    49	            if "account" in lowered:
    50	                vector[2] += 1.0
    51	            if not any(vector):
    52	                vector[2] = 1.0
    53	            norm = math.sqrt(sum(value * value for value in vector))
    54	            vectors.append([value / norm for value in vector])
    55	        return vectors
    56	
