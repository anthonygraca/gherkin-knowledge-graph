"""FastAPI dependencies.

All collaborator state hangs off ``app.state`` so a test (or a future worker) can build an
application with different settings without monkeypatching imports.
"""

from __future__ import annotations

from typing import Annotated

from fastapi import Depends, Request

from app.assurance.rules import DeterministicAssuranceEvaluator
from app.discovery.registry import ProviderRegistry
from app.domain.ports import ArtifactRepository
from app.persistence.ingested import IngestedStore
from app.persistence.portable import PortableRegistry
from app.persistence.review import ReviewWorkspace
from app.retrieval.lifecycle import RetrievalLifecycle
from app.settings import Settings


def provide_settings(request: Request) -> Settings:
    return request.app.state.settings


def provide_repository(request: Request) -> ArtifactRepository:
    """The shared port: routes read artifacts, links, and evidence through this, not the class."""
    return request.app.state.store


def provide_store(request: Request) -> IngestedStore:
    """The concrete store, for ingestion and fixture-facing helpers."""
    return request.app.state.store


def provide_evaluator(request: Request) -> DeterministicAssuranceEvaluator:
    return request.app.state.evaluator


def provide_providers(request: Request) -> ProviderRegistry:
    return request.app.state.providers


def provide_portable(request: Request) -> PortableRegistry:
    """Portable indexes and imported reports; empty until an explicit index call."""
    return request.app.state.portable


def provide_review(request: Request) -> ReviewWorkspace:
    return request.app.state.review


def provide_retrieval_lifecycle(request: Request) -> RetrievalLifecycle:
    return request.app.state.retrieval


SettingsDep = Annotated[Settings, Depends(provide_settings)]
RepositoryDep = Annotated[ArtifactRepository, Depends(provide_repository)]
StoreDep = Annotated[IngestedStore, Depends(provide_store)]
EvaluatorDep = Annotated[DeterministicAssuranceEvaluator, Depends(provide_evaluator)]
ProvidersDep = Annotated[ProviderRegistry, Depends(provide_providers)]
PortableDep = Annotated[PortableRegistry, Depends(provide_portable)]
ReviewDep = Annotated[ReviewWorkspace, Depends(provide_review)]
RetrievalLifecycleDep = Annotated[RetrievalLifecycle, Depends(provide_retrieval_lifecycle)]
"""Request and response envelopes for the documented API (roadmap §4).

Baseline handling, stated once and relied on everywhere:

* Requests accept a baseline name (fixture tag) **or** a resolved commit SHA.
* Response-level ``baseline`` is the canonical baseline name when the requested revision
  resolves to a known baseline, otherwise the resolved commit SHA. Calling an endpoint
  with a tag and with that tag's SHA therefore yields byte-identical responses.
* Version-pinning fields — ``AssuranceFinding.evaluated_baseline`` and
  ``Artifact.revision`` — always carry the resolved commit SHA.
"""

from __future__ import annotations

from pydantic import BaseModel, ConfigDict, Field, model_validator

from app.domain.enums import RelationType
from app.domain.models import (
    ARTIFACT_ID_PATTERN,
    Artifact,
    AssuranceFinding,
    TraceCandidate,
    TraceLink,
    VerificationEvidence,
    validate_link_partition,
)


class _FrozenModel(BaseModel):
    model_config = ConfigDict(extra="forbid", frozen=True)


class HealthResponse(_FrozenModel):
    status: str
    package_version: str
    schema_version: str
    fixture: str
    baselines: list[str]
    baseline_commits: dict[str, str]
    discovery_providers: list[str]


class ThreadResponse(_FrozenModel):
    """One artifact's digital thread at one baseline.

    ``accepted_links`` and ``proposed_links`` are separate arrays on purpose: a proposal
    must never be read as an accepted relationship by a consumer that only walks
    ``accepted_links``.
    """

    schema_version: str
    root_id: str
    baseline: str
    artifacts: list[Artifact]
    accepted_links: list[TraceLink]
    proposed_links: list[TraceLink]
    evidence: list[VerificationEvidence]

    @model_validator(mode="after")
    def _link_partition(self) -> ThreadResponse:
        validate_link_partition(accepted=self.accepted_links, proposed=self.proposed_links)
        return self


class FindingsResponse(_FrozenModel):
    schema_version: str
    baseline: str
    findings: list[AssuranceFinding]


class ArtifactListResponse(_FrozenModel):
    """Artifact inventory at one baseline (additive in schema 0.2.0)."""

    schema_version: str
    baseline: str
    artifacts: list[Artifact]


class DiscoveryRequest(BaseModel):
    model_config = ConfigDict(extra="forbid")

    artifact_id: str = Field(pattern=ARTIFACT_ID_PATTERN)
    top_k: int = Field(default=5, ge=1, le=50)
    relation_types: list[RelationType] | None = Field(
        default=None, description="Restrict proposals to these relation types; null means all."
    )
    provider: str | None = Field(
        default=None, description="Discovery provider name; null uses the configured default."
    )
    baseline: str | None = Field(
        default=None,
        description="Baseline tag/SHA the provider must bind to; null uses the latest baseline.",
    )


class DiscoveryResponse(_FrozenModel):
    """Candidate proposals for one source artifact. Contains no link ids and no review state."""

    schema_version: str
    artifact_id: str
