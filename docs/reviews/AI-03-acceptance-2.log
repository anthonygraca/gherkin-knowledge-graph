   311	                "Provider returned candidates from more than one index revision: "
   312	                + ", ".join(sorted(provider_bindings))
   313	            )
   314	        if provider_bindings and provider.index_revision not in provider_bindings:
   315	            raise MixedIndexContext(
   316	                f"Provider identity {provider.index_revision!r} does not match its candidate "
   317	                "index revisions."
   318	            )
   319	        bound = [
   320	            candidate.model_copy(update={"index_revision": manifest.snapshot_binding})
   321	            for candidate in provider_candidates
   322	        ]
   323	        return SnapshotBoundBatch(
   324	            snapshot_binding=manifest.snapshot_binding,
   325	            provider=provider.provider_name,
   326	            provider_index_revision=provider.index_revision,
   327	            model_version=provider.model_version,
   328	            candidates=bound,
   329	        )
   330	
   331	    def combine(self, request: CombineRequest) -> CombinedCandidatesResponse:
   332	        candidates: list[TraceCandidate] = []
   333	        provenance: list[BatchProvenance] = []
   334	        for batch in request.batches:
   335	            if batch.snapshot_binding != request.snapshot_binding:
   336	                raise MixedIndexContext(
   337	                    f"Batch is bound to {batch.snapshot_binding!r}, not "
   338	                    f"{request.snapshot_binding!r}; refusing to combine mixed index contexts."
   339	                )
   340	            for candidate in batch.candidates:
   341	                if candidate.index_revision != request.snapshot_binding:
   342	                    raise MixedIndexContext(
   343	                        f"Candidate {candidate.source_id}->{candidate.target_id} is bound to "
   344	                        f"{candidate.index_revision!r}, not {request.snapshot_binding!r}; "
   345	                        "refusing to combine mixed index contexts."
   346	                    )
   347	                candidates.append(candidate)
   348	            provenance.append(
   349	                BatchProvenance(
   350	                    snapshot_binding=batch.snapshot_binding,
   351	                    provider=batch.provider,
   352	                    provider_index_revision=batch.provider_index_revision,
   353	                    model_version=batch.model_version,
   354	                )
   355	            )
   356	        ordered = sorted(
   357	            candidates,
   358	            key=lambda candidate: (-candidate.score, candidate.target_id, candidate.source_id),
   359	        )
   360	        ranked = [
   361	            candidate.model_copy(update={"rank": rank})
   362	            for rank, candidate in enumerate(ordered, start=1)
   363	        ]
   364	        return CombinedCandidatesResponse(
   365	            schema_version=SCHEMA_VERSION,
   366	            snapshot_binding=request.snapshot_binding,
   367	            provenance=provenance,
   368	            candidates=ranked,
   369	        )
