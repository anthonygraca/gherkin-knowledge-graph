   406	def test_pointer_failure_rolls_back_the_unpublished_snapshot(
   407	    store: IngestedStore,
   408	    fixture_settings: Settings,
   409	    tmp_path: Path,
   410	    monkeypatch: pytest.MonkeyPatch,
