   497	def _safe_name(value: str) -> str:
   498	    return value.replace(":", "-").replace("/", "-")
   499	
   500	
   501	def _binding_from_filename(path: Path) -> str | None:
   502	    prefix = "snapshot-sha256-"
   503	    stem = path.stem
   504	    if not stem.startswith(prefix):
   505	        return None
   506	    return f"snapshot:sha256:{stem[len(prefix) :]}"
   507	
   508	
   509	def _atomic_write(path: Path, content: str) -> None:
   510	    path.parent.mkdir(parents=True, exist_ok=True)
   511	    descriptor, temporary = tempfile.mkstemp(
   512	        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
   513	    )
   514	    try:
   515	        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
   516	            handle.write(content)
   517	            handle.flush()
   518	            os.fsync(handle.fileno())
   519	        os.replace(temporary, path)
   520	    except Exception:
   521	        try:
   522	            os.unlink(temporary)
   523	        except OSError:
   524	            pass
   525	        raise
   526	
