   417	
   418	    def failing_pointer(path: Path, content: str) -> None:
   419	        if path.parent.name == "baselines" and path.name == "baseline-b.json":
   420	            raise OSError("injected pointer publication failure")
   421	        original(path, content)
   422	
   423	    monkeypatch.setattr(lifecycle_module, "_atomic_write", failing_pointer)
   424	    with pytest.raises(RetrievalUnavailable):
