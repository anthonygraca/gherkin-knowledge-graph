   371	    # ------------------------------------------------------------- internals
   372	
   373	    def _resolve(self, baseline: str) -> tuple[str, str]:
   374	        canonical = self._repository.resolve_baseline(baseline)
   375	        return canonical, self._repository.commit_of(canonical)
   376	
   377	    def _eligibles(self, baseline: str) -> list[RetrievalArtifact]:
   378	        artifacts = [
   379	            artifact
   380	            for artifact in self._repository.list_artifacts(baseline)
   381	            if artifact.artifact_type in (ArtifactType.SOURCE, ArtifactType.TEST)
   382	        ]
   383	        return [
   384	            RetrievalArtifact(
   385	                artifact_id=artifact.artifact_id,
   386	                artifact_type=artifact.artifact_type.value,
   387	                locator=artifact.locator,
   388	                revision=artifact.revision,
   389	                content_hash=artifact.content_hash,
   390	            )
   391	            for artifact in sorted(artifacts, key=lambda item: item.artifact_id)
   392	        ]
   393	
   394	    def _publish(self, manifest: RetrievalManifest) -> None:
   395	        snapshot_path = self._snapshots / f"{_safe_name(manifest.snapshot_binding)}.json"
   396	        snapshot_existed = snapshot_path.exists()
   397	        if not snapshot_existed:
   398	            _atomic_write(snapshot_path, manifest.model_dump_json(indent=2) + "\n")
   399	        pointer = self._baselines / f"{_safe_name(manifest.baseline)}.json"
   400	        try:
   401	            _atomic_write(
   402	                pointer,
   403	                json.dumps(
   404	                    {
   405	                        "snapshot_binding": manifest.snapshot_binding,
   406	                        "config_digest": manifest.config_digest,
   407	                    },
   408	                    indent=2,
   409	                )
   410	                + "\n",
   411	            )
   412	        except Exception as exc:  # noqa: BLE001 - publication failure is a typed storage error
   413	            if not snapshot_existed:
   414	                try:
   415	                    snapshot_path.unlink()
   416	                except OSError as cleanup_exc:
   417	                    raise RetrievalUnavailable(
   418	                        "Retrieval publication failed and the uncommitted snapshot could not be "
   419	                        f"rolled back; the publication state is indeterminate: {cleanup_exc}"
   420	                    ) from cleanup_exc
   421	            raise RetrievalUnavailable(
   422	                f"Retrieval publication failed for {manifest.baseline!r} and was rolled back: {exc}"
   423	            ) from exc
   424	
   425	    def _read_snapshot(self, binding: str) -> RetrievalManifest | None:
   426	        path = self._snapshots / f"{_safe_name(binding)}.json"
   427	        return self._read_snapshot_file(path, expected_binding=binding) if path.is_file() else None
   428	
   429	    def _read_snapshot_file(
   430	        self,
   431	        path: Path,
   432	        *,
   433	        expected_binding: str | None = None,
   434	        expected_baseline: str | None = None,
   435	    ) -> RetrievalManifest | None:
   436	        if not path.is_file():
   437	            return None
   438	        try:
   439	            manifest = RetrievalManifest.model_validate_json(path.read_text("utf-8"))
   440	        except Exception as exc:  # noqa: BLE001 - a corrupt cache entry is not a usable snapshot
   441	            raise RetrievalSnapshotNotFound(
   442	                f"Retrieval snapshot {path.name} is corrupt and will not be served: {exc}"
   443	            ) from exc
   444	        return self._verify_manifest(
   445	            manifest,
   446	            expected_binding=expected_binding,
   447	            expected_baseline=expected_baseline,
   448	        )
   449	
   450	    def _verify_manifest(
   451	        self,
   452	        manifest: RetrievalManifest,
   453	        *,
   454	        expected_binding: str | None = None,
   455	        expected_baseline: str | None = None,
   456	    ) -> RetrievalManifest:
   457	        expected_config = config_digest(manifest.config)
   458	        if manifest.config_digest != expected_config:
   459	            raise RetrievalSnapshotNotFound(
   460	                f"Retrieval snapshot {manifest.snapshot_binding} has a configuration digest "
   461	                "that does not match its stored configuration."
   462	            )
   463	        expected_cache = corpus_cache_key(
   464	            repository=self._repository_name,
   465	            config_digest_value=expected_config,
   466	            artifacts=manifest.artifacts,
   467	        )
   468	        if manifest.corpus_cache_key != expected_cache:
   469	            raise RetrievalSnapshotNotFound(
   470	                f"Retrieval snapshot {manifest.snapshot_binding} has a corpus cache key that "
   471	                "does not match its stored artifacts and configuration."
   472	            )
   473	        expected_identity = snapshot_binding(
   474	            repository=self._repository_name,
   475	            commit=manifest.commit,
   476	            cache_key=expected_cache,
   477	            config_digest_value=expected_config,
   478	        )
   479	        if manifest.snapshot_binding != expected_identity:
   480	            raise RetrievalSnapshotNotFound(
   481	                f"Retrieval snapshot {manifest.snapshot_binding} has a binding that does not "
   482	                "match its stored commit, artifacts, and configuration."
   483	            )
   484	        if expected_binding is not None and manifest.snapshot_binding != expected_binding:
   485	            raise RetrievalSnapshotNotFound(
   486	                f"Retrieval snapshot file does not contain the requested binding "
   487	                f"{expected_binding!r}."
   488	            )
   489	        if expected_baseline is not None and manifest.baseline != expected_baseline:
   490	            raise RetrievalSnapshotNotFound(
   491	                f"Retrieval snapshot {manifest.snapshot_binding} belongs to baseline "
   492	                f"{manifest.baseline!r}, not {expected_baseline!r}."
   493	            )
   494	        return manifest
