   188	        "artifacts": [
   189	            {
   190	                "artifact_id": artifact.artifact_id,
   191	                "artifact_type": artifact.artifact_type,
   192	                "locator": artifact.locator,
   193	                "content_hash": artifact.content_hash,
   194	            }
   195	            for artifact in sorted(artifacts, key=lambda item: item.artifact_id)
   196	        ],
   197	    }
   198	    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   199	    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"
