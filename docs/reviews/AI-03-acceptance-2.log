   430	    )
   431	    assert snapshot_files == [f"{first.snapshot_binding.replace(':', '-')}.json"]
   432	
   433	    monkeypatch.setattr(lifecycle_module, "_atomic_write", original)
   434	    retried = service.refresh("baseline-b", previous_baseline="baseline-a", config=config())
