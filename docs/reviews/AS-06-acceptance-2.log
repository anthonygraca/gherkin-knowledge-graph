   191	def test_findings_match_the_oracle_exactly(
   192	    client: TestClient, fixture_settings: Settings, baseline: str
   193	) -> None:
   194	    oracle = load_model(fixture_settings.expected_dir / f"{baseline}.json", ExpectedFindingsFile)
   195	    body = FindingsResponse.model_validate(
   196	        client.get("/api/findings", params={"baseline": baseline}).json()
   197	    )
   198	
   199	    actual = {
   200	        (
   201	            item.rule_id.value,
   202	            item.finding_type.value,
   203	            tuple(item.artifact_ids),
   204	            tuple(item.evidence_ids),
   205	        ): item
   206	        for item in body.findings
   207	    }
   208	    expected = {
   209	        (
   210	            item.rule_id.value,
   211	            item.finding_type.value,
   212	            tuple(item.artifact_ids),
   213	            tuple(item.evidence_ids),
   214	        ): item
   215	        for item in oracle.findings
   216	    }
   217	    assert set(actual) == set(expected)
   218	
   219	    for key, expected_item in expected.items():
   220	        item = actual[key]
