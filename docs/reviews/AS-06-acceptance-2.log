   430	def test_concurrent_decisions_serialize(app_client: tuple[TestClient, Settings]) -> None:
   431	    client, _ = app_client
   432	    workspace: ReviewWorkspace = client.app.state.review
   433	    outcomes: list[str] = []
   434	
   435	    def decide(decision: ReviewDecision) -> None:
   436	        try:
   437	            workspace.review(
   438	                "LNK-007",
   439	                decision=decision,
   440	                reviewer_id="rv-ana",
   441	                baseline="baseline-a",
   442	                reason=None if decision is ReviewDecision.ACCEPT else "concurrent rejection",
   443	            )
   444	            outcomes.append("ok")
   445	        except ReviewConflict:
   446	            outcomes.append("conflict")
   447	
   448	    threads = [
   449	        threading.Thread(target=decide, args=(ReviewDecision.ACCEPT,)),
   450	        threading.Thread(target=decide, args=(ReviewDecision.REJECT,)),
   451	    ]
   452	    for thread in threads:
   453	        thread.start()
   454	    for thread in threads:
   455	        thread.join()
   456	
   457	    assert sorted(outcomes) == ["conflict", "ok"]
   458	    history = client.get("/api/workspace/history", params={"baseline": "baseline-a"}).json()
   459	    assert len([event for event in history["events"] if event["event"] == "decision_recorded"]) == 1
