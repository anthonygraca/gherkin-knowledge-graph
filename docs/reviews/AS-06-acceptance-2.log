    59	class ReviewJournal:
    60	    """Committed-pair append-only journal with rollback and poison semantics.
    61	
    62	    ``_fsync`` and ``_truncate`` are overridable so tests can exercise the failure boundary
    63	    without patching global ``os`` functions. Production uses the real syscalls.
    64	    """
    65	
    66	    def __init__(self, path: Path) -> None:
    67	        self.path = path
    68	        self.poison_path = path.with_name(path.name + ".poisoned")
    69	        self._events: list[ReviewEvent] = []
    70	        self._lock = threading.RLock()
    71	        self._uncommitted_tail = False
    72	        self._poisoned = self.poison_path.exists()
    73	        self._committed_offset = 0
    74	        self._replay()
    75	
    76	    @property
    77	    def events(self) -> list[ReviewEvent]:
    78	        return list(self._events)
    79	
    80	    @property
    81	    def review_revision(self) -> int:
    82	        return len(self._events)
    83	
    84	    @property
    85	    def blocked(self) -> str | None:
    86	        if self._poisoned:
    87	            return "journal contains an unconfirmed record; operator reconciliation is required"
    88	        if self._uncommitted_tail:
    89	            return "journal ends with an uncommitted record; truncate it before further writes"
    90	        return None
    91	
    92	    # ---------------------------------------------------------------- replay
    93	
    94	    def _replay(self) -> None:
    95	        if not self.path.exists():
    96	            return
    97	        raw = self.path.read_bytes()
    98	        if not raw:
    99	            return
   100	        terminated = raw.endswith(b"\n")
   101	        lines = raw.split(b"\n")
   102	        if terminated:
   103	            lines = lines[:-1]
   104	        else:
   105	            # The final segment is an incomplete append, never a committed record.
   106	            self._uncommitted_tail = True
   107	            lines = lines[:-1]
   108	
   109	        offset = 0
   110	        index = 0
   111	        while index < len(lines):
   112	            payload_line = lines[index]
   113	            if index + 1 >= len(lines):
   114	                self._uncommitted_tail = True
   115	                break
   116	            commit_line = lines[index + 1]
   117	            try:
   118	                payload_raw = json.loads(payload_line)
   119	                commit_raw = json.loads(commit_line)
   120	            except json.JSONDecodeError as exc:
   121	                if index + 2 >= len(lines) and not terminated:
   122	                    self._uncommitted_tail = True
   123	                    break
   124	                raise ReviewStorageUnavailable(
   125	                    f"Review journal {self.path} contains a malformed committed record: {exc}",
   126	                    durability="indeterminate",
   127	                ) from exc
   128	            if not isinstance(commit_raw, dict) or "commit" not in commit_raw:
   129	                self._uncommitted_tail = True
   130	                break
   131	            try:
   132	                payload = JournalPayload.model_validate(payload_raw)
   133	                commit = JournalCommit.model_validate(commit_raw)
   134	            except ValidationError as exc:
   135	                raise ReviewStorageUnavailable(
   136	                    f"Review journal {self.path} contains an invalid committed record: {exc}",
   137	                    durability="indeterminate",
   138	                ) from exc
   139	            event = payload.event
   140	            if commit.commit != payload.record_digest:
   141	                raise ReviewStorageUnavailable(
   142	                    f"Review journal {self.path} commit marker does not match its payload",
   143	                    durability="indeterminate",
   144	                )
   145	            if compute_record_digest(event) != payload.record_digest:
   146	                raise ReviewStorageUnavailable(
   147	                    f"Review journal {self.path} record digest does not match its event",
   148	                    durability="indeterminate",
   149	                )
   150	            if event.review_revision != len(self._events) + 1:
   151	                raise ReviewStorageUnavailable(
   152	                    f"Review journal {self.path} has a non-contiguous review revision",
   153	                    durability="indeterminate",
   154	                )
   155	            self._events.append(event)
   156	            offset += len(payload_line) + 1 + len(commit_line) + 1
   157	            index += 2
   158	        self._committed_offset = offset
   159	
   160	    # ---------------------------------------------------------------- append
   161	
   162	    def append(self, event: ReviewEvent) -> None:
   163	        with self._lock:
   164	            blocked = self.blocked
   165	            if blocked is not None:
   166	                raise ReviewStorageUnavailable(
   167	                    blocked,
   168	                    durability="indeterminate" if self._poisoned else "not_committed",
   169	                )
   170	            if event.review_revision != len(self._events) + 1:
   171	                raise ValueError("event review_revision must follow the committed journal")
   172	            payload = JournalPayload(event=event, record_digest=compute_record_digest(event))
   173	            payload_bytes = (payload.model_dump_json() + "\n").encode("utf-8")
   174	            commit_bytes = (
   175	                JournalCommit(commit=payload.record_digest).model_dump_json() + "\n"
   176	            ).encode("utf-8")
   177	
   178	            try:
   179	                self.path.parent.mkdir(parents=True, exist_ok=True)
   180	                fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
   181	            except OSError as exc:
   182	                raise ReviewStorageUnavailable(
   183	                    f"Review journal {self.path} cannot be opened: {exc}",
   184	                    durability="not_committed",
   185	                ) from exc
   186	
   187	            try:
   188	                before = os.fstat(fd).st_size
   189	                try:
   190	                    _write_all(fd, payload_bytes)
   191	                    self._fsync(fd)
   192	                    _write_all(fd, commit_bytes)
   193	                    self._fsync(fd)
   194	                except OSError as exc:
   195	                    try:
   196	                        self._truncate(fd, before)
   197	                        self._fsync(fd)
   198	                    except OSError:
   199	                        self._poisoned = True
   200	                        try:
   201	                            self.poison_path.write_text(
   202	                                "unconfirmed journal append; reconcile before further writes",
   203	                                encoding="utf-8",
   204	                            )
   205	                        except OSError:
   206	                            pass
   207	                        raise ReviewStorageUnavailable(
   208	                            f"Review journal {self.path} could not confirm durability or roll "
   209	                            f"back: {exc}",
   210	                            durability="indeterminate",
   211	                        ) from exc
   212	                    raise ReviewStorageUnavailable(
   213	                        f"Review journal {self.path} refused the record and rolled back: {exc}",
   214	                        durability="not_committed",
   215	                    ) from exc
   216	            finally:
   217	                os.close(fd)
   218	
   219	            self._events.append(event)
   220	            self._committed_offset = before + len(payload_bytes) + len(commit_bytes)
   221	
   222	    # ------------------------------------------------------------ overridable
   223	
   224	    def _fsync(self, fd: int) -> None:
   225	        os.fsync(fd)
   226	
   227	    def _truncate(self, fd: int, size: int) -> None:
   228	        os.ftruncate(fd, size)
   229	
   230	
   231	def _write_all(fd: int, payload: bytes) -> None:
   232	    view = memoryview(payload)
   233	    while view:
   234	        written = os.write(fd, view)
   235	        if written <= 0:
   236	            raise OSError("short write to review journal")
   237	        view = view[written:]
