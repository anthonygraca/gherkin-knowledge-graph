"""Trusted-local-operator review surface (AS-06).

Every route here is local-only. Reads project committed decisions over immutable baseline facts;
writes append to the application-owned journal and publish only after a committed pair exists.
"""

from __future__ import annotations

from typing import Annotated
from urllib.parse import urlsplit

from fastapi import APIRouter, Depends, Path, Query, Request, Response

from app.api.deps import ReviewDep, SettingsDep
from app.domain.api import ProblemDetails
from app.domain.errors import (
    ReviewIdentityMismatch,
    ReviewIdentityUnavailable,
    ReviewLoopbackRequired,
    ReviewOriginForbidden,
)
from app.domain.models import ARTIFACT_ID_PATTERN, LINK_ID_PATTERN, TraceLink
from app.domain.review import (
    LinkProposalResponse,
    ProposalCaptureRequest,
    ReviewConfigResponse,
    ReviewRequestPayload,
    WorkspaceHistoryResponse,
    WorkspaceProposalsResponse,
    WorkspaceThreadResponse,
)

router = APIRouter(prefix="/api", tags=["review"])

_LOOPBACK_PEERS = {
    "127.0.0.1",
    "::1",
    "localhost",
    "testclient",
    "::ffff:127.0.0.1",
}
_LOOPBACK_ORIGIN_HOSTS = {"127.0.0.1", "::1", "localhost"}

BASELINE_QUERY = Query(
    description="Baseline name or commit SHA; omitted means the latest tagged baseline."
)

_PROBLEM_403 = {"model": ProblemDetails, "description": "A local review write is required."}
_PROBLEM_404 = {"model": ProblemDetails, "description": "Unknown artifact, baseline, or proposal."}
_PROBLEM_409 = {"model": ProblemDetails, "description": "Conflicting or stale review state."}
_PROBLEM_422 = {"model": ProblemDetails, "description": "Invalid review or capture request."}
_PROBLEM_503 = {"model": ProblemDetails, "description": "Review identity or storage unavailable."}


def enforce_local_review(request: Request) -> None:
    """Loopback peer plus optional loopback browser origin.

    A missing ``Origin`` is allowed for local CLI/non-browser clients. Any present Origin must be
    an http(s) loopback origin; this is a CSRF boundary, not an authentication mechanism.
    """
    host = request.client.host if request.client else ""
    if host not in _LOOPBACK_PEERS:
        raise ReviewLoopbackRequired(
            f"Review access is limited to the local machine; peer {host!r} is not loopback."
        )
    origin = request.headers.get("origin")
    if origin is None:
        return
    try:
        parsed = urlsplit(origin)
    except ValueError as exc:
        raise ReviewOriginForbidden(
            f"Browser origin {origin!r} is malformed and outside the trusted local boundary."
        ) from exc
    if parsed.scheme not in {"http", "https"} or parsed.hostname not in _LOOPBACK_ORIGIN_HOSTS:
        raise ReviewOriginForbidden(
            f"Browser origin {origin!r} is outside the trusted local review boundary."
        )


async def review_local_guard(request: Request, settings: SettingsDep) -> None:
    """Transport and operator checks run before the request body is validated."""
    enforce_local_review(request)
    if settings.review_operator is None:
        raise ReviewIdentityUnavailable(
            "Review writes are disabled: no operator identity is configured (CTA_REVIEW_OPERATOR)."
        )


async def review_decision_guard(request: Request, settings: SettingsDep) -> None:
    await review_local_guard(request, settings)
    try:
        body = await request.json()
    except Exception:  # noqa: BLE001 - malformed JSON is left to body validation
        return
    reviewer = body.get("reviewer_id") if isinstance(body, dict) else None
    if isinstance(reviewer, str) and reviewer != settings.review_operator:
        raise ReviewIdentityMismatch(
            f"Reviewer {reviewer!r} is not the configured local operator "
            f"{settings.review_operator!r}. Review writes are server-assigned."
        )


@router.get(
    "/review/config",
    response_model=ReviewConfigResponse,
    responses={403: _PROBLEM_403},
    summary="Whether local review writes are enabled and which operator is assigned",
)
def get_review_config(request: Request, review: ReviewDep) -> ReviewConfigResponse:
    enforce_local_review(request)
    return review.config()


@router.post(
    "/link-proposals",
    response_model=LinkProposalResponse,
    status_code=201,
    dependencies=[Depends(review_local_guard)],
    responses={400: _PROBLEM_403, 409: _PROBLEM_409, 422: _PROBLEM_422, 503: _PROBLEM_503},
    summary="Capture a discovery candidate as a proposed link (never accepts it)",
)
def post_link_proposal(
    payload: ProposalCaptureRequest,
    response: Response,
    review: ReviewDep,
) -> LinkProposalResponse:
    result = review.capture(payload)
    if not result.created:
        response.status_code = 200
    return result


@router.post(
    "/links/{link_id}/review",
    response_model=TraceLink,
    dependencies=[Depends(review_decision_guard)],
    responses={
        403: _PROBLEM_403,
        404: _PROBLEM_404,
        409: _PROBLEM_409,
        422: _PROBLEM_422,
        503: _PROBLEM_503,
    },
    summary="Record an append-only reviewer decision on a proposed link",
)
def post_link_review(
    link_id: Annotated[str, Path(pattern=LINK_ID_PATTERN)],
    payload: ReviewRequestPayload,
    review: ReviewDep,
) -> TraceLink:
    return review.review(
        link_id,
        decision=payload.decision,
        reviewer_id=payload.reviewer_id,
        baseline=payload.baseline,
        reason=payload.reason,
        reason_present="reason" in payload.model_fields_set,
    )


@router.get(
    "/workspace/threads/{artifact_id}",
    response_model=WorkspaceThreadResponse,
    responses={403: _PROBLEM_403, 404: _PROBLEM_404},
    summary="Thread projection with committed review decisions applied",
)
def get_workspace_thread(
    artifact_id: Annotated[str, Path(pattern=ARTIFACT_ID_PATTERN)],
    request: Request,
    review: ReviewDep,
    baseline: Annotated[str | None, BASELINE_QUERY] = None,
) -> WorkspaceThreadResponse:
    enforce_local_review(request)
    return review.thread(artifact_id, baseline=baseline)


@router.get(
    "/workspace/proposals",
    response_model=WorkspaceProposalsResponse,
    responses={403: _PROBLEM_403, 404: _PROBLEM_404},
    summary="Pending review queue for a baseline",
)
def get_workspace_proposals(
    request: Request,
    review: ReviewDep,
    baseline: Annotated[str | None, BASELINE_QUERY] = None,
) -> WorkspaceProposalsResponse:
    enforce_local_review(request)
    return review.pending(baseline)


@router.get(
    "/workspace/history",
    response_model=WorkspaceHistoryResponse,
    responses={403: _PROBLEM_403, 404: _PROBLEM_404},
    summary="Capture and decision history applicable to a baseline",
)
def get_workspace_history(
    request: Request,
    review: ReviewDep,
    baseline: Annotated[str | None, BASELINE_QUERY] = None,
) -> WorkspaceHistoryResponse:
    enforce_local_review(request)
    return review.history(baseline)
"""Review-workspace contracts (AS-06).

A discovery candidate is not a link until an explicit capture; a capture is not accepted until a
durable human decision. These models keep the three states separate and make the audit fields
explicit: the proposal snapshot, the selected baseline and hashes, the server-assigned operator,
and the append-only journal event.

Nothing here derives an expected result from model output. Provenance is *reported* provenance,
stored verbatim; missing values stay null and are rendered as "not recorded".
"""

from __future__ import annotations

import hashlib
import json
from datetime import datetime
from typing import Literal

from pydantic import BaseModel, ConfigDict, Field, model_validator

from app.domain.api import ThreadResponse
from app.domain.enums import RelationType, ReviewDecision
from app.domain.models import (
    ARTIFACT_ID_PATTERN,
    CONTENT_HASH_PATTERN,
    TraceLink,
    _FrozenModel,
)


class ProposalCaptureRequest(BaseModel):
    """Explicit capture of a discovery candidate as a proposed link."""

    model_config = ConfigDict(extra="forbid")

    source_id: str = Field(pattern=ARTIFACT_ID_PATTERN)
    target_id: str = Field(pattern=ARTIFACT_ID_PATTERN)
    relation_type: RelationType
    baseline: str = Field(min_length=1)
    source_content_hash: str = Field(pattern=CONTENT_HASH_PATTERN)
    target_content_hash: str = Field(pattern=CONTENT_HASH_PATTERN)
    provider: str | None = Field(default=None, min_length=1)
    model_version: str | None = Field(default=None, min_length=1)
    index_revision: str | None = Field(default=None, min_length=1)
    score: float | None = Field(default=None, ge=0.0, le=1.0)
    rationale: str | None = None


def snapshot_identity_payload(
    *,
    source_id: str,
    target_id: str,
    relation_type: RelationType,
    baseline: str,
    baseline_commit: str,
    source_content_hash: str,
    target_content_hash: str,
    provider: str | None,
    model_version: str | None,
    index_revision: str | None,
) -> dict[str, object]:
    """The exact fields hashed into ``snapshot_digest``.

    Presentation metadata (``score``, ``rationale``, ``captured_at``) is excluded: editing a
    rationale must not manufacture a different proposal identity.
    """
    return {
        "source_id": source_id,
        "target_id": target_id,
        "relation_type": str(relation_type),
        "baseline": baseline,
        "baseline_commit": baseline_commit,
        "source_content_hash": source_content_hash,
        "target_content_hash": target_content_hash,
        "provider": provider,
        "model_version": model_version,
        "index_revision": index_revision,
    }


def compute_snapshot_digest(payload: dict[str, object]) -> str:
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"


class ProposalSnapshot(_FrozenModel):
    """Immutable identity and provenance of one proposal at one baseline."""

    snapshot_digest: str = Field(pattern=CONTENT_HASH_PATTERN)
    source_id: str = Field(pattern=ARTIFACT_ID_PATTERN)
    target_id: str = Field(pattern=ARTIFACT_ID_PATTERN)
    relation_type: RelationType
    baseline: str = Field(min_length=1)
    baseline_commit: str = Field(min_length=7)
    source_content_hash: str = Field(pattern=CONTENT_HASH_PATTERN)
    target_content_hash: str = Field(pattern=CONTENT_HASH_PATTERN)
    provider: str | None = None
    model_version: str | None = None
    index_revision: str | None = None
    score: float | None = Field(default=None, ge=0.0, le=1.0)
    rationale: str | None = None
    captured_at: datetime

    @model_validator(mode="after")
    def _digest_matches(self) -> ProposalSnapshot:
        expected = compute_snapshot_digest(
            snapshot_identity_payload(
                source_id=self.source_id,
                target_id=self.target_id,
                relation_type=self.relation_type,
                baseline=self.baseline,
                baseline_commit=self.baseline_commit,
                source_content_hash=self.source_content_hash,
                target_content_hash=self.target_content_hash,
                provider=self.provider,
                model_version=self.model_version,
                index_revision=self.index_revision,
            )
        )
        if self.snapshot_digest != expected:
            raise ValueError("snapshot_digest does not match the snapshot identity fields")
        return self

    @model_validator(mode="after")
    def _different_endpoints(self) -> ProposalSnapshot:
        if self.source_id == self.target_id:
            raise ValueError("a proposal must connect two different artifacts")
        return self


def make_proposal_snapshot(
    *,
    source_id: str,
    target_id: str,
    relation_type: RelationType,
    baseline: str,
    baseline_commit: str,
    source_content_hash: str,
    target_content_hash: str,
    provider: str | None,
    model_version: str | None,
    index_revision: str | None,
    score: float | None,
    rationale: str | None,
    captured_at: datetime,
) -> ProposalSnapshot:
    payload = snapshot_identity_payload(
        source_id=source_id,
        target_id=target_id,
        relation_type=relation_type,
        baseline=baseline,
        baseline_commit=baseline_commit,
        source_content_hash=source_content_hash,
        target_content_hash=target_content_hash,
        provider=provider,
        model_version=model_version,
        index_revision=index_revision,
    )
    return ProposalSnapshot(
        snapshot_digest=compute_snapshot_digest(payload),
        source_id=source_id,
        target_id=target_id,
        relation_type=relation_type,
        baseline=baseline,
        baseline_commit=baseline_commit,
        source_content_hash=source_content_hash,
        target_content_hash=target_content_hash,
        provider=provider,
        model_version=model_version,
        index_revision=index_revision,
        score=score,
        rationale=rationale,
        captured_at=captured_at,
    )


class LinkProposalResponse(_FrozenModel):
    schema_version: str
    link: TraceLink
    snapshot: ProposalSnapshot
    review_revision: int = Field(ge=0)
    created: bool


class ProposalRecord(_FrozenModel):
    """One pending proposal; legacy proposals have no capture snapshot yet."""

    link: TraceLink
    snapshot: ProposalSnapshot | None = None
    binding: Literal["captured", "legacy"]


class WorkspaceProposalsResponse(_FrozenModel):
    schema_version: str
    baseline: str
    review_revision: int = Field(ge=0)
    proposals: list[ProposalRecord]


class ReviewEvent(_FrozenModel):
    """One committed journal event: a capture or a terminal decision."""

    review_revision: int = Field(ge=1)
    event: Literal["proposal_captured", "decision_recorded"]
    recorded_at: datetime
    operator: str = Field(min_length=1)
    baseline: str = Field(min_length=1)
    baseline_commit: str = Field(min_length=7)
    link: TraceLink
    snapshot: ProposalSnapshot
    decision: ReviewDecision | None = None
    reason: str | None = None

    @model_validator(mode="after")
    def _consistent(self) -> ReviewEvent:
        if self.event == "proposal_captured" and self.decision is not None:
            raise ValueError("a capture event cannot carry a decision")
        if self.event == "decision_recorded" and self.decision is None:
            raise ValueError("a decision event must carry a decision")
        return self


class JournalPayload(_FrozenModel):
    event: ReviewEvent
    record_digest: str = Field(pattern=CONTENT_HASH_PATTERN)


class JournalCommit(_FrozenModel):
    commit: str = Field(pattern=CONTENT_HASH_PATTERN)


def compute_record_digest(event: ReviewEvent) -> str:
    canonical = json.dumps(event.model_dump(mode="json"), sort_keys=True, separators=(",", ":"))
    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"


class WorkspaceThreadResponse(ThreadResponse):
    """Thread projection with the journal revision that produced it."""

    review_revision: int = Field(default=0, ge=0)


class WorkspaceHistoryResponse(_FrozenModel):
    schema_version: str
    baseline: str
    review_revision: int = Field(ge=0)
    events: list[ReviewEvent]


class ReviewConfigResponse(_FrozenModel):
    schema_version: str
    enabled: bool
    operator: str | None = None
    loopback_only: bool = True


class ReviewRequestPayload(BaseModel):
    """Request body for ``POST /api/links/{link_id}/review``.

    ``reason`` is optional at the type level so the route can distinguish an absent/null field
    (``request-validation``) from an empty/whitespace value (``review-reason-required``).
    """

    model_config = ConfigDict(extra="forbid")

    decision: ReviewDecision
    reviewer_id: str = Field(min_length=1)
    baseline: str = Field(min_length=1)
    reason: str | None = None


__all__ = [
    "JournalCommit",
    "JournalPayload",
    "LinkProposalResponse",
    "ProposalCaptureRequest",
    "ProposalRecord",
    "ProposalSnapshot",
    "ReviewConfigResponse",
    "ReviewEvent",
    "ReviewRequestPayload",
    "WorkspaceHistoryResponse",
    "WorkspaceProposalsResponse",
    "WorkspaceThreadResponse",
    "compute_record_digest",
    "compute_snapshot_digest",
    "make_proposal_snapshot",
    "snapshot_identity_payload",
]

