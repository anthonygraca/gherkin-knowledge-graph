@dataclass(frozen=True)
class ExternalRepo:
    """A built external-style repository: no CTA tags, annotations, or requirement files."""

    name: str
    path: Path
    tags: dict[str, str]


@pytest.fixture(scope="session")
def external_repos(tmp_path_factory: pytest.TempPathFactory) -> dict[str, ExternalRepo]:
    """Materialize both independent fixtures once per session.

    Built from the committed trees by ``tools/external_fixture.py``; the trees themselves are never
    modified, and the builder runs no project code.
    """
    destination = tmp_path_factory.mktemp("external-fixtures")
    refs = external_fixture.build_all(destination)
    return {
        name: ExternalRepo(name=name, path=destination / name, tags=tags)
        for name, tags in refs.items()
    }
#!/usr/bin/env node
/**
 * Strict step-resolution gate for the CTA acceptance suite.
 *
 * Cucumber's process exit code is not enough: a suite can pass while a required scenario was
 * skipped or a step resolved ambiguously and was never executed. This gate reads the Cucumber
 * Messages report and fails when:
 *
 *   - the run did not finish successfully;
 *   - any step was reported UNDEFINED, AMBIGUOUS, or PENDING;
 *   - a pickle (concrete scenario case) never started.
 *
 * Usage: node tools/step-resolution.mjs [reports/cucumber-messages.ndjson]
 */
import fs from 'node:fs';
import path from 'node:path';

const reportPath = process.argv[2] || 'reports/cucumber-messages.ndjson';
const config = (await import(`file://${path.resolve('cucumber.mjs')}`)).default;
const excludedTags = new Set(
  [...String(config.tags ?? '').matchAll(/not\s+(@[\w-]+)/g)].map((match) => match[1]),
);
const envelopes = fs
  .readFileSync(reportPath, 'utf8')
  .split('\n')
  .filter((line) => line.trim())
  .map((line) => JSON.parse(line));

const documents = new Map();
const pickles = new Map();
const testCases = new Map();
const startedByCase = new Map();
const results = new Map();
const definitions = new Map();
const finishedCases = new Set();
let runFinished = null;

for (const envelope of envelopes) {
  if (envelope.gherkinDocument) documents.set(envelope.gherkinDocument.uri, envelope.gherkinDocument);
  if (envelope.pickle) pickles.set(envelope.pickle.id, envelope.pickle);
  if (envelope.testCase) testCases.set(envelope.testCase.id, envelope.testCase);
  if (envelope.testCaseStarted) {
    const ids = startedByCase.get(envelope.testCaseStarted.testCaseId) ?? [];
    ids.push(envelope.testCaseStarted.id);
    startedByCase.set(envelope.testCaseStarted.testCaseId, ids);
  }
  if (envelope.stepDefinition) {
    const source = envelope.stepDefinition.sourceReference ?? {};
    definitions.set(envelope.stepDefinition.id, {
      pattern: envelope.stepDefinition.pattern?.source,
      where: `${source.uri ?? '?'}:${source.location?.line ?? '?'}`,
    });
  }
  if (envelope.testCaseFinished) {
    finishedCases.add(envelope.testCaseFinished.testCaseStartedId);
  }
  if (envelope.testStepFinished) {
    const key = `${envelope.testStepFinished.testCaseStartedId}:${envelope.testStepFinished.testStepId}`;
    const list = results.get(key) ?? [];
    list.push(envelope.testStepFinished.testStepResult);
    results.set(key, list);
  }
  if (envelope.testRunFinished) runFinished = envelope.testRunFinished;
}

function stepLocations(uri) {
  const byId = new Map();
  const walk = (steps) => {
    for (const step of steps ?? []) byId.set(step.id, step.location.line);
  };
  for (const child of documents.get(uri)?.feature?.children ?? []) {
    if (child.background) walk(child.background.steps);
    if (child.scenario) walk(child.scenario.steps);
    for (const sub of child.rule?.children ?? []) {
      if (sub.background) walk(sub.background.steps);
      if (sub.scenario) walk(sub.scenario.steps);
    }
  }
  return byId;
}

const problems = [];
const knownPairs = new Set();
for (const [caseId, testCase] of testCases) {
  for (const attemptId of startedByCase.get(caseId) ?? []) {
    for (const step of testCase.testSteps ?? []) knownPairs.add(`${attemptId}:${step.id}`);
  }
}
for (const key of results.keys()) {
  if (!knownPairs.has(key)) {
    problems.push(`a step result references an unknown attempt or step identity: ${key}`);
  }
}
const anyFailed = [...results.values()].some((list) =>
  list.some((result) => result.status === 'FAILED'),
);
if (runFinished?.success && anyFailed) {
  problems.push('the run reports success but a step result is FAILED');
}
if (!runFinished) problems.push('report has no testRunFinished envelope');
else if (!runFinished.success) problems.push('the run did not finish successfully');
if (testCases.size === 0) problems.push('the report selects no test cases');
if (pickles.size === 0) problems.push('the report contains no pickles');

const coveredPickles = new Set();
for (const [caseId, testCase] of testCases) {
  const pickle = pickles.get(testCase.pickleId);
  if (!pickle) {
    problems.push(`test case ${caseId} references an unknown pickle`);
    continue;
  }
  coveredPickles.add(pickle.id);
  const excluded = (pickle.tags ?? []).some((tag) => excludedTags.has(tag.name));
  if (excluded) continue;
  const attemptIds = startedByCase.get(caseId) ?? [];
  if (attemptIds.length === 0) {
    problems.push(`${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" never started`);
    continue;
  }
  const locations = stepLocations(pickle.uri);
  const stepsById = new Map((testCase.testSteps ?? []).map((step) => [step.id, step]));
  for (const attemptId of attemptIds) {
    if (!finishedCases.has(attemptId)) {
      problems.push(
        `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" attempt ${attemptId} ` +
          'has no testCaseFinished result',
      );
    }
    for (const testStep of testCase.testSteps ?? []) {
      const resultList = results.get(`${attemptId}:${testStep.id}`) ?? [];
      if (resultList.length === 0) {
        problems.push(
          `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" has no result for ` +
            `test step ${testStep.id} (incomplete attempt)`,
        );
        continue;
      }
      if (resultList.length > 1) {
        problems.push(
          `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" has ` +
            `${resultList.length} results for test step ${testStep.id}`,
        );
      }
      if (!testStep.pickleStepId) {
        const hookStatus = resultList[0].status;
        if (!['PASSED', 'FAILED'].includes(hookStatus)) {
          problems.push(
            `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" hook ${testStep.id} ` +
              `is ${hookStatus} [${hookStatus}]`,
          );
        }
        continue;
      }
      const pickleStep = pickle.steps.find((step) => step.id === testStep.pickleStepId);
      if (!pickleStep) continue;
      for (const result of resultList) {
        if (!['UNDEFINED', 'AMBIGUOUS', 'PENDING', 'SKIPPED', 'UNKNOWN'].includes(result.status)) {
          continue;
        }
        const line = locations.get(pickleStep.astNodeIds?.[0]) ?? '?';
        const matched = (testStep.stepDefinitionIds ?? []).map(
          (id) => definitions.get(id)?.where ?? id,
        );
        const detail =
          result.status === 'UNDEFINED'
            ? 'no matching definition'
            : result.status === 'AMBIGUOUS'
              ? `${matched.length} definitions: ${matched.join(', ')}`
              : result.status === 'SKIPPED'
                ? 'was not executed (SKIPPED; dry run or an earlier failure)'
                : result.status === 'PENDING'
                  ? 'is pending'
                  : 'has no result';
        problems.push(
          `${pickle.uri}:${line} "${pickle.name}" step "${pickleStep.text}" ${detail} ` +
            `[${result.status}]`,
        );
      }
    }
  }
}

for (const pickle of pickles.values()) {
  if ((pickle.tags ?? []).some((tag) => excludedTags.has(tag.name))) continue;
  if (!coveredPickles.has(pickle.id)) {
    problems.push(
      `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" has no test case ` +
        '(selected scenario omitted from the report)',
    );
  }
}

if (problems.length > 0) {
  console.error('step-resolution: FAILED');
  for (const problem of [...new Set(problems)].sort()) console.error(`  - ${problem}`);
  process.exit(1);
}
console.log(
  `step-resolution: ok (${testCases.size} test cases, ${results.size} step results, all resolved and started)`,
);
"""Runtime settings.

Offline by default: the application configures no remote endpoint unless ``CTA_AI_MODE=live``.
The AI provider variables are read here and validated without contacting any endpoint; provider
adapters are constructed only when the application or a tool asks for them.

Secret handling: API keys live in the process environment only. They are excluded from the
dataclass ``repr`` and must never be logged, serialized into a report, or sent to the frontend.
"""

from __future__ import annotations

import os
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import urlsplit

DEFAULT_FIXTURE = "banking-demo"
DEFAULT_AI_MODE = "fake"
DEFAULT_VECTOR_BACKEND = "memory"

ENV_REPO_ROOT = "CTA_REPO_ROOT"
ENV_FIXTURES_DIR = "CTA_FIXTURES_DIR"
ENV_FIXTURE = "CTA_FIXTURE"
ENV_FIXTURE_REPO = "CTA_FIXTURE_REPO"
ENV_DISCOVERY_PROVIDER = "CTA_DISCOVERY_PROVIDER"

# Starting names from the RAG mission; kept verbatim so deployment configuration is explicit.
ENV_AI_MODE = "CTA_AI_MODE"
ENV_LLM_BASE_URL = "CTA_LLM_BASE_URL"
ENV_LLM_MODEL = "CTA_LLM_MODEL"
ENV_LLM_API_KEY = "CTA_LLM_API_KEY"
ENV_EMBED_BASE_URL = "CTA_EMBED_BASE_URL"
ENV_EMBED_MODEL = "CTA_EMBED_MODEL"
ENV_EMBED_API_KEY = "CTA_EMBED_API_KEY"
ENV_VECTOR_BACKEND = "CTA_VECTOR_BACKEND"
ENV_AI_LIVE_TESTS = "CTA_AI_LIVE_TESTS"

# CocoIndex Code (AI-06): an optional external code-search cache. Offline unless explicitly
# configured and opted in; it is never a default discovery provider in PR 1.
ENV_CCC_EXECUTABLE = "CTA_CCC_EXECUTABLE"
ENV_CCC_PROJECT_ROOT = "CTA_CCC_PROJECT_ROOT"
ENV_CCC_LIVE_OPT_IN = "CTA_CCC_LIVE_OPT_IN"
ENV_CCC_LIVE_TESTS = "CTA_CCC_LIVE_TESTS"

# AS-06 trusted-local-operator review mode. The journal is application-owned and must live
# outside the fixture/evaluated repository.
ENV_REVIEW_OPERATOR = "CTA_REVIEW_OPERATOR"
ENV_REVIEW_JOURNAL = "CTA_REVIEW_JOURNAL"

# AI-02 same-machine local inference. Disabled by default; the fake provider remains the default.
ENV_LOCAL_EMBEDDING = "CTA_LOCAL_EMBEDDING"
ENV_LOCAL_EMBEDDING_MODEL_DIR = "CTA_LOCAL_EMBEDDING_MODEL_DIR"
ENV_LOCAL_EMBEDDING_ENDPOINT = "CTA_LOCAL_EMBEDDING_ENDPOINT"
ENV_LOCAL_EMBEDDING_WEIGHTS_DIGEST = "CTA_LOCAL_EMBEDDING_WEIGHTS_DIGEST"
ENV_LOCAL_EMBEDDING_LIVE_TESTS = "CTA_LOCAL_EMBEDDING_LIVE_TESTS"

# AI-03 CTA-owned retrieval manifests. Application-owned, outside the fixture/evaluated repo.
ENV_RETRIEVAL_SNAPSHOT_DIR = "CTA_RETRIEVAL_SNAPSHOT_DIR"
DEFAULT_RETRIEVAL_SNAPSHOT_DIR = ".cta/retrieval-snapshots"

DEFAULT_CCC_EXECUTABLE = "ccc"
DEFAULT_REVIEW_JOURNAL = ".cta/review-journal.ndjson"

ALLOWED_AI_MODES: tuple[str, ...] = ("fake", "live")
#: PR 1 validates the selector but ships no vector index; PR 2 owns the in-memory index.
ALLOWED_VECTOR_BACKENDS: tuple[str, ...] = ("memory",)


class SettingsError(ValueError):
    """Invalid runtime configuration, raised before any network call."""


def _clean(value: str | None) -> str | None:
    if value is None:
        return None
    cleaned = value.strip()
    return cleaned or None


def _env_flag(name: str, *, default: bool = False) -> bool:
    raw = _clean(os.environ.get(name))
    if raw is None:
        return default
    lowered = raw.lower()
    if lowered in {"1", "true", "yes", "on"}:
        return True
    if lowered in {"0", "false", "no", "off"}:
        return False
    raise SettingsError(f"{name} must be a boolean (1/0, true/false, yes/no, on/off)")


def validate_base_url(name: str, value: str | None) -> str | None:
    """Validate and normalize an HTTP(S) API base URL without contacting it.

    The configured value is the OpenAI-compatible API root, including its path prefix (for
    example ``http://host:8000/v1``). Credentials belong in the API-key variable, never in the
    URL; a query or fragment is rejected so a secret cannot be hidden there.
    """
    if value is None:
        return None
    normalized = value.strip().rstrip("/")
    parsed = urlsplit(normalized)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise SettingsError(f"{name} must be an absolute http(s) URL")
    if parsed.username or parsed.password:
        raise SettingsError(f"{name} must not contain credentials; use the API-key variable")
    if parsed.query or parsed.fragment:
        raise SettingsError(f"{name} must not contain a query or fragment")
    return normalized


@dataclass(frozen=True)
class Settings:
    repo_root: Path
    fixtures_dir: Path
    fixture: str = DEFAULT_FIXTURE
    discovery_provider: str = "fake"
    fixture_repo_path: Path | None = None

    # AI providers. `fake` is the default and keeps every normal path offline.
    ai_mode: str = DEFAULT_AI_MODE
    llm_base_url: str | None = None
    llm_model: str | None = None
    llm_api_key: str | None = field(default=None, repr=False)
    embed_base_url: str | None = None
    embed_model: str | None = None
    embed_api_key: str | None = field(default=None, repr=False)
    vector_backend: str = DEFAULT_VECTOR_BACKEND
    ai_live_tests: bool = False

    # CocoIndex Code capability (AI-06). The project root must be an initialized CocoIndex
    # project; live opt-in is separate so merely configuring a path contacts nothing.
    ccc_executable: str = DEFAULT_CCC_EXECUTABLE
    ccc_project_root: Path | None = None
    cocoindex_live_opt_in: bool = False
    ccc_live_tests: bool = False

    # Trusted-local-operator review (AS-06). Unset operator disables every review mutation.
    review_operator: str | None = None
    review_journal_path: Path | None = None
    review_loopback_only: bool = True

    # AI-02 same-machine local inference. An endpoint is accepted only on loopback; a remote
    # endpoint is refused by the provider rather than silently contacted.
    local_embedding_enabled: bool = False
    local_embedding_model_dir: Path | None = None
    local_embedding_endpoint: str | None = None
    local_embedding_weights_digest: str | None = None
    local_embedding_live_tests: bool = False

    # AI-03 application-owned retrieval manifest store.
    retrieval_snapshot_dir: Path | None = None

    def __post_init__(self) -> None:
        mode = self.ai_mode.strip().lower()
        vector_backend = self.vector_backend.strip().lower()
        object.__setattr__(self, "ai_mode", mode)
        object.__setattr__(self, "vector_backend", vector_backend)
        object.__setattr__(
            self, "llm_base_url", validate_base_url(ENV_LLM_BASE_URL, self.llm_base_url)
        )
        object.__setattr__(
            self, "embed_base_url", validate_base_url(ENV_EMBED_BASE_URL, self.embed_base_url)
        )
        object.__setattr__(self, "llm_model", _clean(self.llm_model))
        object.__setattr__(self, "embed_model", _clean(self.embed_model))
        object.__setattr__(self, "llm_api_key", _clean(self.llm_api_key))
        object.__setattr__(self, "embed_api_key", _clean(self.embed_api_key))

        if mode not in ALLOWED_AI_MODES:
            raise SettingsError(
                f"{ENV_AI_MODE} must be one of {', '.join(ALLOWED_AI_MODES)}; got '{mode}'"
            )
        if vector_backend not in ALLOWED_VECTOR_BACKENDS:
            raise SettingsError(
                f"{ENV_VECTOR_BACKEND} must be one of {', '.join(ALLOWED_VECTOR_BACKENDS)} "
                f"in PR 1; got '{vector_backend}'"
            )
        if mode == "live" and (self.llm_base_url is None or self.llm_model is None):
