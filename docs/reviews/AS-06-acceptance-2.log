   462	class _FailSecondFsync(ReviewJournal):
   463	    def __init__(self, path: Path) -> None:
   464	        self.calls = 0
   465	        super().__init__(path)
   466	
   467	    def _fsync(self, fd: int) -> None:
   468	        self.calls += 1
   469	        if self.calls == 2:
   470	            raise OSError("injected fsync failure")
   471	        super()._fsync(fd)
   472	
   473	
   474	class _FailRollback(_FailSecondFsync):
   475	    def _truncate(self, fd: int, size: int) -> None:
   476	        raise OSError("injected truncate failure")
