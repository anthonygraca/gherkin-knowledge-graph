  1271	def _journal_hashes(path: Path) -> dict:
  1272	    import hashlib
  1273	
  1274	    if not path.exists():
  1275	        return {"bytes_sha256": None, "line_count": 0, "bytes": 0}
  1276	    raw = path.read_bytes()
  1277	    return {
  1278	        "bytes_sha256": f"sha256:{hashlib.sha256(raw).hexdigest()}",
  1279	        "line_count": len(raw.splitlines()),
  1280	        "bytes": len(raw),
  1281	    }
