  1284	def _independent_snapshot_digest(snapshot: dict) -> str:
  1285	    import hashlib
  1286	    import json
  1287	
  1288	    payload = {
  1289	        "source_id": snapshot["source_id"],
  1290	        "target_id": snapshot["target_id"],
  1291	        "relation_type": snapshot["relation_type"],
  1292	        "baseline": snapshot["baseline"],
  1293	        "baseline_commit": snapshot["baseline_commit"],
  1294	        "source_content_hash": snapshot["source_content_hash"],
  1295	        "target_content_hash": snapshot["target_content_hash"],
  1296	        "provider": snapshot["provider"],
  1297	        "model_version": snapshot["model_version"],
  1298	        "index_revision": snapshot["index_revision"],
  1299	    }
  1300	    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
  1301	    return f"sha256:{hashlib.sha256(canonical.encode('utf-8')).hexdigest()}"
