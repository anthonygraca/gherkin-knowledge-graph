   240	class ReviewWorkspace:
   241	    """Projects committed review events over immutable baseline facts."""
   242	
   243	    def __init__(
   244	        self,
   245	        store: IngestedStore,
   246	        settings: Settings,
   247	        *,
   248	        journal: ReviewJournal | None = None,
