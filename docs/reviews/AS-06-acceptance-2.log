  1304	class _KeywordRuntime:
  1305	    """Deterministic local runtime used by the offline AI-02 contract scenario."""
  1306	
  1307	    model_id = "embeddinggemma-2-text-270m-q8_0"
  1308	    weights_digest = "sha256:" + "a" * 64
  1309	    runtime_version = "deterministic-keyword-runtime"
  1310	    dimension = 3
  1311	    max_tokens = 512
  1312	
  1313	    def embed(self, texts):
  1314	        import math
  1315	
  1316	        vectors = []
  1317	        for text in texts:
  1318	            lowered = text.lower()
  1319	            vector = [0.0, 0.0, 0.0]
  1320	            if "withdraw" in lowered:
  1321	                vector[0] += 1.0
  1322	            if "transfer" in lowered:
  1323	                vector[1] += 1.0
  1324	            if "account" in lowered:
  1325	                vector[2] += 1.0
  1326	            if not any(vector):
  1327	                vector[2] = 1.0
  1328	            norm = math.sqrt(sum(value * value for value in vector))
  1329	            vectors.append([value / norm for value in vector])
  1330	        return vectors
  1331	
  1332	
  1333	class _NaNRuntime(_KeywordRuntime):
  1334	    def embed(self, texts):
  1335	        return [[float("nan"), 0.0, 0.0] for _ in texts]
