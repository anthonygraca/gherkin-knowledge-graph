   351	                if candidate.index_revision != request.snapshot_binding:
   352	                    raise MixedIndexContext(
   353	                        f"Candidate {candidate.source_id}->{candidate.target_id} is bound to "
   354	                        f"{candidate.index_revision!r}, not {request.snapshot_binding!r}; "
   355	                        "refusing to combine mixed index contexts."
   356	                    )
   357	                candidates.append(candidate)
