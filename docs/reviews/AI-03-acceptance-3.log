   359	                BatchProvenance(
   360	                    snapshot_binding=batch.snapshot_binding,
   361	                    provider=batch.provider,
   362	                    provider_index_revision=batch.provider_index_revision,
   363	                    model_version=batch.model_version,
   364	                )
