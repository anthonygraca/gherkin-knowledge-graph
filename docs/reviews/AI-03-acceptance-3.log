    mixed = client.post(
        "/api/retrieval/combine",
        json={
            "snapshot_binding": "snapshot:sha256:aaa",
            "batches": [
                {
                    "snapshot_binding": "snapshot:sha256:bbb",
                    "provider": "fake",
                    "provider_index_revision": "sha256:provider-b",
