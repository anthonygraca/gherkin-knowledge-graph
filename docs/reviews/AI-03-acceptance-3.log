   341	    def combine(self, request: CombineRequest) -> CombinedCandidatesResponse:
   342	        candidates: list[TraceCandidate] = []
   343	        provenance: list[BatchProvenance] = []
   344	        for batch in request.batches:
   345	            if batch.snapshot_binding != request.snapshot_binding:
   346	                raise MixedIndexContext(
   347	                    f"Batch is bound to {batch.snapshot_binding!r}, not "
   348	                    f"{request.snapshot_binding!r}; refusing to combine mixed index contexts."
   349	                )
