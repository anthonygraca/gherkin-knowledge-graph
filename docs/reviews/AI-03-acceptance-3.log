   578	def _safe_name(value: str) -> str:
   579	    return value.replace(":", "-").replace("/", "-")
   580	
   581	
   582	def _binding_from_filename(path: Path) -> str | None:
   583	    prefix = "snapshot-sha256-"
   584	    stem = path.stem
   585	    if not stem.startswith(prefix):
   586	        return None
   587	    return f"snapshot:sha256:{stem[len(prefix) :]}"
   588	
   589	
   590	def _atomic_write(path: Path, content: str) -> None:
   591	    path.parent.mkdir(parents=True, exist_ok=True)
   592	    descriptor, temporary = tempfile.mkstemp(
   593	        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
   594	    )
   595	    try:
   596	        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
   597	            handle.write(content)
   598	            handle.flush()
   599	            os.fsync(handle.fileno())
   600	        os.replace(temporary, path)
   601	    except Exception:
   602	        try:
   603	            os.unlink(temporary)
   604	        except OSError:
   605	            pass
   606	        raise
