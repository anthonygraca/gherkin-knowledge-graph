        <button type="button" onClick={onDiscover} disabled={loading || !source}>
          {loading ? "Finding candidates…" : "Find candidates"}
        </button>
      </div>
      {error && problem?.code === "provider-not-registered" && (
        <div role="alert" className="error">
          <p>
            Provider unavailable: <code>{failed ?? "unknown"}</code>
          </p>
          <p>
            Registered providers: <code>{(registered ?? catalog.providers.map((p) => p.name)).join(", ")}</code>
          </p>
          <p>“fake” remains selectable; no candidate was substituted.</p>
        </div>
      )}
      {error && problem?.code === "provider-unavailable" && (
        <p role="alert" className="error">
          Provider failed: <code>{failed ?? "unknown"}</code>. No candidates were returned for
          this request; the accepted thread and evidence remain available.
        </p>
      )}
      {error && problem?.code !== "provider-not-registered" && problem?.code !== "provider-unavailable" && (
        <p role="alert" className="error">
          {errorMessage(error)}
        </p>
      )}
      {loading && <p className="loading">Loading candidates…</p>}
      {!loading && !error && data && data.response.candidates.length === 0 && (
        <div className="candidate-empty">
          <p>0 candidates.</p>
          <p>
            Provider <code>{data.response.provider}</code> · model{" "}
            <code>{data.response.model_version}</code> · index{" "}
            <code>{data.response.index_revision}</code>
          </p>
        </div>
      )}
      {!loading && !error && data && data.response.candidates.length > 0 && (
        <ol className="candidate-list" aria-label="Discovery candidates">
          {data.response.candidates.map((candidate) => {
            const provenance = candidateProvenance(candidate, providerKinds);
            return (
              <li
                key={`${candidate.rank}-${candidate.target_id}`}
                data-target-id={candidate.target_id}
              >
                <strong>
                  #{candidate.rank} {candidate.target_id}
                </strong>{" "}
                · <code>{candidate.proposed_relation_type}</code> · score{" "}
                {candidate.score.toFixed(3)}
                <dl>
                  <dt>Provider</dt>
                  <dd>{provenance.provider}</dd>
                  <dt>Model version</dt>
                  <dd>{provenance.model}</dd>
                  <dt>{provenance.indexLabel}</dt>
                  <dd className="commit">{provenance.index}</dd>
                  <dt>Origin</dt>
                  <dd>{provenance.label}</dd>
                </dl>
                {candidate.rationale && <p className="source-note">{candidate.rationale}</p>}
              </li>
            );
          })}
        </ol>
      )}
    </section>
  );
}

function ReviewWorkspace({
  config,
  proposals,
  history,
  availableProviders,
  providerKinds,
  busy,
  error,
  onDecide,
}: {
  config: ReviewConfig;
  proposals: ProposalRecord[];
  history: ReviewEvent[];
  availableProviders: string[];
  providerKinds: ProviderKinds;
  busy: boolean;
  error: string | null;
  onDecide: (linkId: string, decision: "accept" | "reject", reason?: string) => Promise<void>;
}) {
  const [reasons, setReasons] = useState<Record<string, string>>({});
  if (!config.enabled) {
    return (
      <section aria-labelledby="review-heading">
        <h2 id="review-heading">Review proposals</h2>
        <p className="empty">
          Review writes are disabled: no operator identity is configured.
        </p>
      </section>
    );
  }
  return (
    <section aria-labelledby="review-heading">
      <h2 id="review-heading">Review proposals</h2>
      <p className="source-note">Operator {config.operator} · loopback review writes</p>
      {error && (
        <p role="alert" className="error">
          {error}
        </p>
      )}
      {proposals.length === 0 ? (
        <p className="empty">No pending proposals for this requirement.</p>
      ) : (
        proposals.map((record) => {
          const provenance = provenanceOf(record, providerKinds);
          const link = record.link;
          const reason = reasons[link.link_id] ?? "";
          return (
            <article
              className="proposal"
              key={link.link_id}
              data-link-id={link.link_id}
              data-state={link.review_state}
            >
              <h3>
                <code>{link.link_id}</code>{" "}
                <span className="badge warn">{link.review_state}</span>
              </h3>
              <p>
                {link.source_id} → {link.target_id} · <code>{link.relation_type}</code>
              </p>
              <dl>
                <dt>Provider</dt>
                <dd>{provenance.provider}</dd>
                <dt>Model version</dt>
                <dd>{provenance.model}</dd>
                <dt>{provenance.indexLabel}</dt>
                <dd className="commit">{provenance.index}</dd>
                <dt>Origin</dt>
                <dd>{provenance.label}</dd>
              </dl>
              {provenance.provider !== "not recorded" &&
                !availableProviders.includes(provenance.provider) && (
                  <p className="empty">
                    Provider {provenance.provider} is not in the current registry; the recorded
                    provenance is retained.
                  </p>
                )}
              <label>
                Reason for rejecting {link.link_id}
                <input
                  type="text"
                  value={reason}
                  disabled={busy}
                  onChange={(event) =>
                    setReasons((current) => ({ ...current, [link.link_id]: event.target.value }))
                  }
                />
              </label>
              <div className="proposal-actions">
                <button
                  type="button"
                  disabled={busy}
                  onClick={() => onDecide(link.link_id, "accept")}
                >
                  Accept {link.link_id}
                </button>
                <button
                  type="button"
                  disabled={busy || reason.trim().length === 0}
                  onClick={() => onDecide(link.link_id, "reject", reason)}
                >
                  Reject {link.link_id}
                </button>
              </div>
            </article>
          );
        })
      )}
      <h3 id="history-heading">Review history</h3>
      {history.length === 0 ? (
        <p className="empty">No review decisions recorded for this baseline.</p>
      ) : (
        <ul aria-label="Review history" className="review-history">
          {history.map((event) => {
            const provenance = provenanceOfEvent(event, providerKinds);
            return (
              <li key={event.review_revision} data-event={event.event}>
                <code>{event.link.link_id}</code>{" "}
                {event.event === "decision_recorded" ? event.decision : "captured"} by{" "}
                {event.operator} at {event.recorded_at}
                {event.reason ? ` · reason: ${event.reason}` : ""}
                <span className="provenance-line">
                  provider {provenance.provider} · model {provenance.model} ·{" "}
                  {provenance.indexLabel} {provenance.index} · {provenance.label}
                  {provenance.provider !== "not recorded" &&
                  !availableProviders.includes(provenance.provider)
                    ? ` · provider ${provenance.provider} is not in the current registry`
                    : ""}
                </span>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  );
}

function LinksTable({ links }: { links: TraceLink[] }) {
import { After, AfterAll, Before, BeforeAll, setDefaultTimeout } from '@cucumber/cucumber';
import { execFileSync, spawn } from 'node:child_process';
import fs from 'node:fs';
import http from 'node:http';
import net from 'node:net';
import path from 'node:path';
import { chromium } from 'playwright-core';


const BDD_ROOT = path.resolve(import.meta.dirname, '..');
const ROOT = path.resolve(BDD_ROOT, '..');
const PYTHON = process.env.CTA_BDD_PYTHON || path.join(ROOT, 'backend/.venv/bin/python');
const BRIDGE = path.join(BDD_ROOT, 'support', 'cta_bridge.py');
const DIST = path.join(ROOT, 'frontend', 'dist');

setDefaultTimeout(60_000);

let ui = null;

function freePort() {
  return new Promise((resolve, reject) => {
    const server = net.createServer();
    server.listen(0, '127.0.0.1', () => {
      const { port } = server.address();
      server.close(() => resolve(port));
    });
    server.on('error', reject);
  });
}

async function stopServer(server, backend) {
  const line = `[ui harness ${new Date().toISOString()}] stopServer server=${!!server} backend=${backend?.pid ?? "none"}\n`;
  fs.appendFileSync(path.join(ROOT, 'bdd', '.cache', 'ui-harness.log'), line);
  if (server) {
    await new Promise((resolve) => server.close(resolve));
  }
  if (backend) {
    backend.kill('SIGTERM');
    await new Promise((resolve) => {
      backend.once('exit', resolve);
      setTimeout(resolve, 2000);
    });
  }
}

async function spawnReviewBackend(port, fixture, journal, providerMode = "recorded") {
  const logPath = path.join(path.dirname(journal), "backend.log");
  const logFd = fs.openSync(logPath, "a");
  const backend = spawn(
    PYTHON,
    [
      '-m',
      'uvicorn',
      'provider_ui_app:app',
      '--host',
      '127.0.0.1',
      '--port',
      String(port),
    ],
    {
      cwd: path.join(ROOT, 'backend'),
      env: {
        ...process.env,
        PYTHONPATH: [path.join(ROOT, 'backend'), path.join(ROOT, 'bdd', 'support')].join(path.delimiter),
        CTA_REPO_ROOT: ROOT,
        CTA_FIXTURES_DIR: path.join(ROOT, 'fixtures'),
        CTA_FIXTURE_REPO: fixture,
        CTA_REVIEW_OPERATOR: 'rv-ana',
        CTA_REVIEW_JOURNAL: journal,
        CTA_BDD_PROVIDER_MODE: providerMode,
      },
      stdio: ['ignore', logFd, logFd],
    },
  );
  backend.on('exit', (code, signal) => {
    fs.appendFileSync(logPath, `\n[ui harness] backend exited code=${code} signal=${signal}\n`);
  });
  await waitFor(`http://127.0.0.1:${port}/health`);
  await new Promise((resolve) => setTimeout(resolve, 500));
  if (backend.exitCode !== null) {
    const log = fs.readFileSync(logPath, 'utf8');
    throw new Error(`review backend exited after health check:\n${log}`);
  }
  return backend;
}

export async function startReviewUI(options = {}) {
  const { providerMode = "recorded" } = options;
  fs.appendFileSync(
    path.join(ROOT, 'bdd', '.cache', 'ui-harness.log'),
    `[ui harness ${new Date().toISOString()}] startReviewUI begin backend=${ui?.backend?.pid ?? 'none'}\n`,
  );
  if (!ui) throw new Error('the browser UI was not started');
  const cache = path.join(ROOT, 'bdd', '.cache');
  fs.mkdirSync(cache, { recursive: true });
  const dir = fs.mkdtempSync(path.join(cache, 'ui-review-'));
  const journal = path.join(dir, 'review-journal.ndjson');
  const fixture = builtFixturePath();
  const backendPort = await freePort();
  const staticPort = await freePort();

  await stopServer(ui.server, ui.backend);
  const backend = await spawnReviewBackend(backendPort, fixture, journal, providerMode);
  const server = await startStatic(staticPort, backendPort);
  await waitFor(`http://127.0.0.1:${staticPort}/`);

  ui.backend = backend;
  ui.backendPort = backendPort;
  ui.server = server;
  ui.staticPort = staticPort;
  ui.baseUrl = `http://127.0.0.1:${staticPort}`;
  ui.review = { dir, journal };
  await new Promise((resolve) => setTimeout(resolve, 250));
  fs.appendFileSync(
    path.join(ROOT, 'bdd', '.cache', 'ui-harness.log'),
    `[ui harness ${new Date().toISOString()}] startReviewUI ready backend=${backend.pid} port=${backendPort}\n`,
  );
  return ui.review;
}

function builtFixturePath() {
  const cache = path.join(ROOT, 'bdd', '.cache');
  fs.mkdirSync(cache, { recursive: true });
  const state = fs.mkdtempSync(path.join(cache, 'ui-state-'));
  const stdout = execFileSync(PYTHON, [BRIDGE], {
    input: JSON.stringify({ op: 'fixture_repo', args: {} }),
    env: { ...process.env, CTA_BDD_STATE: state },
    encoding: 'utf8',
  });
  const parsed = JSON.parse(stdout);
  if (!parsed.ok) throw new Error(parsed.error?.detail || 'fixture_repo failed');
  return parsed.result.path;
}

async function waitFor(url, timeoutMs = 20_000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    try {
      const response = await fetch(url);
      if (response.ok) return response;
    } catch {
      // server not listening yet
    }
    await new Promise((resolve) => setTimeout(resolve, 100));
  }
  throw new Error(`${url} did not become ready`);
}

function proxy(targetPort, req, res) {
  const upstream = http.request(
    {
      host: '127.0.0.1',
      port: targetPort,
      path: req.url,
      method: req.method,
      headers: req.headers,
    },
    (response) => {
      res.writeHead(response.statusCode ?? 502, response.headers);
      response.pipe(res);
    },
  );
  upstream.on('error', (error) => {
    res.writeHead(502, { 'content-type': 'text/plain' });
    res.end(`proxy error: ${error.message}`);
  });
  req.pipe(upstream);
}

function startStatic(port, backendPort) {
  const server = http.createServer((req, res) => {
    if (req.url.startsWith('/api') || req.url.startsWith('/health')) {
      proxy(backendPort, req, res);
      return;
    }
    const urlPath = decodeURIComponent(req.url.split('?')[0]);
    const target = path.join(DIST, urlPath === '/' ? 'index.html' : urlPath);
    if (!target.startsWith(DIST)) {
      res.writeHead(403).end();
      return;
    }
    fs.readFile(target, (error, data) => {
      if (error) {
        fs.readFile(path.join(DIST, 'index.html'), (fallbackError, fallback) => {
          if (fallbackError) {
            res.writeHead(404).end();
          } else {
            res.writeHead(200, { 'content-type': 'text/html' }).end(fallback);
          }
        });
        return;
      }
      const ext = path.extname(target);
      const type =
        ext === '.js'
          ? 'text/javascript'
          : ext === '.css'
            ? 'text/css'
            : ext === '.html'
              ? 'text/html'
              : 'application/octet-stream';
      res.writeHead(200, { 'content-type': type }).end(data);
    });
  });
  return new Promise((resolve) => server.listen(port, '127.0.0.1', () => resolve(server)));
}

function chromePath() {
  const candidates = [
    process.env.CTA_CHROME_PATH,
    '/usr/bin/chromium-browser',
    '/usr/bin/chromium',
    '/usr/bin/google-chrome',
    '/usr/bin/google-chrome-stable',
    '/opt/google/chrome/chrome',
  ].filter(Boolean);
  const found = candidates.find((candidate) => fs.existsSync(candidate));
  if (!found) {
    throw new Error(
      'no Chromium/Chrome executable found for browser acceptance; set CTA_CHROME_PATH',
    );
  }
  return found;
}

