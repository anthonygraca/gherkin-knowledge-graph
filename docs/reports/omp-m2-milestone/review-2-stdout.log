        link.relation_type === 'verified_by',
    ),
    [],
  );
});

Given('{string} has no accepted implementation', function (artifactId) {
  const { links } = this.call('links', { baseline: 'baseline-a' });
  assert.deepEqual(
    links.filter(
      (link) =>
        link.review_state === 'accepted' &&
