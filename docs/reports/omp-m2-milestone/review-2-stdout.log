        [...this.results.fixtureRun.failed].sort(),
        [...this.results.expectedFailures].sort(),
        'fixture suite failed in a different set of tests than the scenario named',
      );
    }
  } finally {
    fs.rmSync(this.stateDir, { recursive: true, force: true });
  }
});
