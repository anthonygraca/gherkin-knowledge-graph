"""In-process store over the ingested fixture repository.

The store ingests a revision on first use and caches it by resolved commit. It implements the same
``ArtifactRepository`` port as the M0 mock, so consumers did not change; the precomputed thread
replay is gone and threads are assembled from parsed repository data.
"""

from __future__ import annotations

from dataclasses import dataclass, field

from app.domain.api import ThreadResponse
from app.domain.enums import ArtifactType, ReviewState
from app.domain.errors import (
    ArtifactNotFound,
    BaselineNotFound,
    FixtureDataInvalid,
    FixtureDataMissing,
    InvalidRequest,
    ThreadNotFound,
)
from app.domain.models import Artifact, TraceLink, VerificationEvidence
from app.domain.oracle import BaselinesManifest
from app.ingestion import GitRepository, IngestedRevision, IngestionError, ingest_revision
from app.ingestion.thread import assemble_thread
from app.persistence.fixtures import load_model, require_supported_schema_version
from app.settings import Settings


@dataclass
class IngestedStore:
    """Facts parsed from the configured repository, cached by commit."""

    repository: GitRepository
    manifest: BaselinesManifest
    repository_name: str
    _cache: dict[str, IngestedRevision] = field(default_factory=dict)

    @classmethod
    def from_settings(cls, settings: Settings) -> IngestedStore:
        manifest = load_model(settings.baselines_manifest_path, BaselinesManifest)
        require_supported_schema_version(manifest.schema_version, settings.baselines_manifest_path)
        return cls(
            repository=GitRepository(settings.fixture_repo),
            manifest=manifest,
            repository_name=settings.fixture,
        )

    # --------------------------------------------------- ArtifactRepository port

    def baselines(self) -> list[str]:
        return [tag for commit in self.manifest.commits for tag in commit.tags]

    def resolve_baseline(self, baseline: str | None) -> str:
        if baseline is None:
            return self.baselines()[-1]
        if baseline in self.manifest.tags:
            return baseline
        for name, commit in self.manifest.tags.items():
            if commit == baseline:
                return name
        known = ", ".join(f"{name} ({commit})" for name, commit in self.manifest.tags.items())
        raise BaselineNotFound(f"Unknown baseline '{baseline}'. Known baselines: {known}")

    def commit_of(self, baseline: str) -> str:
        return self.manifest.tags[self.resolve_baseline(baseline)]

    def get_artifact(self, artifact_id: str, *, baseline: str | None = None) -> Artifact:
        canonical, revision = self._revision(baseline)
        artifact = revision.artifact(artifact_id)
        if artifact is None:
            known = ", ".join(item.artifact_id for item in revision.artifacts)
            raise ArtifactNotFound(
                f"No artifact '{artifact_id}' at baseline '{canonical}'. Known artifacts: {known}"
            )
        return artifact

    def list_artifacts(self, baseline: str) -> list[Artifact]:
        return list(self._revision(baseline)[1].artifacts)

    def artifacts_at(self, revision: str) -> list[Artifact]:
        return list(self._ingest(revision).artifacts)

    def list_links(
        self, baseline: str, *, review_state: ReviewState | None = None
    ) -> list[TraceLink]:
        revision = self._revision(baseline)[1]
        links = [*revision.accepted_links, *revision.proposed_links]
        if review_state is not None:
            links = [link for link in links if link.review_state is review_state]
        return sorted(links, key=lambda link: link.link_id)

    def list_evidence(self, baseline: str) -> list[VerificationEvidence]:
        return list(self._revision(baseline)[1].evidence)

    def changed_artifacts(self, baseline: str, previous: str) -> list[str]:
        current = {
            artifact.artifact_id: artifact.content_hash
            for artifact in self._revision(baseline)[1].artifacts
        }
        before = {
            artifact.artifact_id: artifact.content_hash
            for artifact in self._revision(previous)[1].artifacts
        }
        return sorted(
            artifact_id
            for artifact_id in current.keys() | before.keys()
            if current.get(artifact_id) != before.get(artifact_id)
        )

    def impacted_links(self, baseline: str, previous: str) -> list[TraceLink]:
        changed = set(self.changed_artifacts(baseline, previous))
        return sorted(
            (
                link
                for link in self.list_links(
                    self.resolve_baseline(baseline), review_state=ReviewState.ACCEPTED
                )
                if link.source_id in changed or link.target_id in changed
            ),
            key=lambda link: link.link_id,
        )

    # ------------------------------------------- fixture-facing read helpers

    def baseline_commits(self) -> dict[str, str]:
        """Fixture addition used by ``/health``: baseline name -> resolved commit SHA."""
        return dict(self.manifest.tags)

    def label_of(self, commit: str) -> str:
        """Baseline name for a commit, by tag or by content-equivalent artifact set.

        Evidence is pinned to the commit that was actually tested, which is usually the source
        commit of a two-commit baseline. Reporting that SHA in prose ("passed at 903977de…") is
        accurate but unreadable, so a commit whose artifact content equals a baseline is labelled
        with that baseline. Content equality — never SHA equality — is the criterion.
        """
        exact = next((name for name, value in self.manifest.tags.items() if value == commit), None)
        if exact is not None:
            return exact
        try:
            current = {
                artifact.artifact_id: artifact.content_hash
                for artifact in self._ingest(commit).artifacts
            }
        except Exception:  # noqa: BLE001 - an unreadable revision has no label
            return commit
        for name, value in self.manifest.tags.items():
            try:
                candidate = {
                    artifact.artifact_id: artifact.content_hash
                    for artifact in self._ingest(value).artifacts
                }
            except Exception:  # noqa: BLE001
                continue
            if candidate == current:
                return name
        return commit

    def thread(self, root_id: str, *, baseline: str | None = None) -> ThreadResponse:
        canonical, revision = self._revision(baseline)
        artifact = revision.artifact(root_id)
        if artifact is None:
            raise ArtifactNotFound(f"No artifact '{root_id}' at baseline '{canonical}'.")
        if artifact.artifact_type is not ArtifactType.REQUIREMENT:
            raise ThreadNotFound(
                f"No thread materialized for '{root_id}' at baseline '{canonical}'. "
                f"M1 materializes threads for requirement roots only."
            )
        return assemble_thread(
            root_id=root_id,
            baseline=canonical,
            artifacts=revision.artifacts,
            accepted_links=revision.accepted_links,
            proposed_links=revision.proposed_links,
"""Runtime settings.

Offline by default: the application configures no remote endpoint unless ``CTA_AI_MODE=live``.
The AI provider variables are read here and validated without contacting any endpoint; provider
adapters are constructed only when the application or a tool asks for them.

Secret handling: API keys live in the process environment only. They are excluded from the
dataclass ``repr`` and must never be logged, serialized into a report, or sent to the frontend.
"""

from __future__ import annotations

import os
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import urlsplit

DEFAULT_FIXTURE = "banking-demo"
DEFAULT_AI_MODE = "fake"
DEFAULT_VECTOR_BACKEND = "memory"

ENV_REPO_ROOT = "CTA_REPO_ROOT"
ENV_FIXTURES_DIR = "CTA_FIXTURES_DIR"
ENV_FIXTURE = "CTA_FIXTURE"
ENV_FIXTURE_REPO = "CTA_FIXTURE_REPO"
ENV_DISCOVERY_PROVIDER = "CTA_DISCOVERY_PROVIDER"

# Starting names from the RAG mission; kept verbatim so deployment configuration is explicit.
ENV_AI_MODE = "CTA_AI_MODE"
ENV_LLM_BASE_URL = "CTA_LLM_BASE_URL"
ENV_LLM_MODEL = "CTA_LLM_MODEL"
ENV_LLM_API_KEY = "CTA_LLM_API_KEY"
ENV_EMBED_BASE_URL = "CTA_EMBED_BASE_URL"
ENV_EMBED_MODEL = "CTA_EMBED_MODEL"
ENV_EMBED_API_KEY = "CTA_EMBED_API_KEY"
ENV_VECTOR_BACKEND = "CTA_VECTOR_BACKEND"
ENV_AI_LIVE_TESTS = "CTA_AI_LIVE_TESTS"

# CocoIndex Code (AI-06): an optional external code-search cache. Offline unless explicitly
# configured and opted in; it is never a default discovery provider in PR 1.
ENV_CCC_EXECUTABLE = "CTA_CCC_EXECUTABLE"
ENV_CCC_PROJECT_ROOT = "CTA_CCC_PROJECT_ROOT"
ENV_CCC_LIVE_OPT_IN = "CTA_CCC_LIVE_OPT_IN"
ENV_CCC_LIVE_TESTS = "CTA_CCC_LIVE_TESTS"

DEFAULT_CCC_EXECUTABLE = "ccc"

ALLOWED_AI_MODES: tuple[str, ...] = ("fake", "live")
#: PR 1 validates the selector but ships no vector index; PR 2 owns the in-memory index.
ALLOWED_VECTOR_BACKENDS: tuple[str, ...] = ("memory",)


class SettingsError(ValueError):
    """Invalid runtime configuration, raised before any network call."""


def _clean(value: str | None) -> str | None:
    if value is None:
        return None
    cleaned = value.strip()
    return cleaned or None


def _env_flag(name: str, *, default: bool = False) -> bool:
    raw = _clean(os.environ.get(name))
    if raw is None:
        return default
    lowered = raw.lower()
    if lowered in {"1", "true", "yes", "on"}:
        return True
    if lowered in {"0", "false", "no", "off"}:
        return False
    raise SettingsError(f"{name} must be a boolean (1/0, true/false, yes/no, on/off)")


def validate_base_url(name: str, value: str | None) -> str | None:
    """Validate and normalize an HTTP(S) API base URL without contacting it.

    The configured value is the OpenAI-compatible API root, including its path prefix (for
    example ``http://host:8000/v1``). Credentials belong in the API-key variable, never in the
    URL; a query or fragment is rejected so a secret cannot be hidden there.
    """
    if value is None:
        return None
    normalized = value.strip().rstrip("/")
    parsed = urlsplit(normalized)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise SettingsError(f"{name} must be an absolute http(s) URL")
    if parsed.username or parsed.password:
        raise SettingsError(f"{name} must not contain credentials; use the API-key variable")
    if parsed.query or parsed.fragment:
        raise SettingsError(f"{name} must not contain a query or fragment")
    return normalized


@dataclass(frozen=True)
class Settings:
    repo_root: Path
    fixtures_dir: Path
    fixture: str = DEFAULT_FIXTURE
    discovery_provider: str = "fake"
    fixture_repo_path: Path | None = None

    # AI providers. `fake` is the default and keeps every normal path offline.
    ai_mode: str = DEFAULT_AI_MODE
    llm_base_url: str | None = None
    llm_model: str | None = None
    llm_api_key: str | None = field(default=None, repr=False)
    embed_base_url: str | None = None
    embed_model: str | None = None
    embed_api_key: str | None = field(default=None, repr=False)
    vector_backend: str = DEFAULT_VECTOR_BACKEND
    ai_live_tests: bool = False

    # CocoIndex Code capability (AI-06). The project root must be an initialized CocoIndex
    # project; live opt-in is separate so merely configuring a path contacts nothing.
    ccc_executable: str = DEFAULT_CCC_EXECUTABLE
    ccc_project_root: Path | None = None
    cocoindex_live_opt_in: bool = False
    ccc_live_tests: bool = False

    def __post_init__(self) -> None:
        mode = self.ai_mode.strip().lower()
        vector_backend = self.vector_backend.strip().lower()
        object.__setattr__(self, "ai_mode", mode)
        object.__setattr__(self, "vector_backend", vector_backend)
        object.__setattr__(
            self, "llm_base_url", validate_base_url(ENV_LLM_BASE_URL, self.llm_base_url)
        )
        object.__setattr__(
            self, "embed_base_url", validate_base_url(ENV_EMBED_BASE_URL, self.embed_base_url)
        )
        object.__setattr__(self, "llm_model", _clean(self.llm_model))
        object.__setattr__(self, "embed_model", _clean(self.embed_model))
        object.__setattr__(self, "llm_api_key", _clean(self.llm_api_key))
        object.__setattr__(self, "embed_api_key", _clean(self.embed_api_key))

        if mode not in ALLOWED_AI_MODES:
            raise SettingsError(
                f"{ENV_AI_MODE} must be one of {', '.join(ALLOWED_AI_MODES)}; got '{mode}'"
            )
        if vector_backend not in ALLOWED_VECTOR_BACKENDS:
            raise SettingsError(
                f"{ENV_VECTOR_BACKEND} must be one of {', '.join(ALLOWED_VECTOR_BACKENDS)} "
                f"in PR 1; got '{vector_backend}'"
            )
        if mode == "live" and (self.llm_base_url is None or self.llm_model is None):
            raise SettingsError(
                f"{ENV_AI_MODE}=live requires {ENV_LLM_BASE_URL} and {ENV_LLM_MODEL}; "
                "the application will not silently fall back to fake"
