"""Boundary contracts that the independent M0 review found unenforced (R1, R2, R4).

Each test reproduces the reviewer's probe against a public surface: the shared port, the response
models, or the fixture loaders. They exist so those defects cannot come back silently.
"""

from __future__ import annotations

import json
import shutil
from pathlib import Path

import pytest
from fastapi.testclient import TestClient
from pydantic import ValidationError

from app.discovery.fake import FakeCandidateDiscovery
from app.domain.api import ThreadResponse
from app.domain.enums import ReviewState
from app.domain.errors import FixtureDataInvalid
from app.domain.oracle import CandidateIndexFile
from app.domain.ports import ArtifactRepository
from app.main import create_app
from app.persistence.fixtures import load_model
from app.persistence.ingested import IngestedStore
from app.settings import Settings
from app.version import SCHEMA_VERSION


def fixture_copy(fixture_settings: Settings, tmp_path: Path) -> Path:
    """A writable copy of the fixture data, so probes never touch the committed files."""
    fixtures = tmp_path / "fixtures"
    shutil.copytree(fixture_settings.api_responses_dir, fixtures / "api-responses")
    shutil.copytree(fixture_settings.expected_dir, fixtures / "banking-demo" / "expected")
    return fixtures


def app_over(fixture_settings: Settings, fixtures: Path) -> TestClient:
    return TestClient(
        create_app(
            Settings(
                repo_root=fixture_settings.repo_root,
                fixtures_dir=fixtures,
                fixture_repo_path=fixture_settings.fixture_repo_path,
            )
        )
    )


# ------------------------------------------------------------------ R1: port conformance


def test_store_satisfies_the_artifact_repository_port(fixture_settings: Settings) -> None:
    assert isinstance(IngestedStore.from_settings(fixture_settings), ArtifactRepository)


def test_consumer_can_read_everything_through_the_port_alone(fixture_settings: Settings) -> None:
    """R1's acceptance condition: one constructor path, port methods only, real data returned."""
    repository: ArtifactRepository = IngestedStore.from_settings(fixture_settings)

    assert repository.baselines() == ["baseline-a", "baseline-b"]
    assert repository.resolve_baseline("baseline-a") == "baseline-a"
    assert repository.resolve_baseline(None) == "baseline-b"

    artifact = repository.get_artifact("REQ-001", baseline="baseline-a")
    assert artifact.artifact_id == "REQ-001"
    assert repository.get_artifact("REQ-001", baseline="baseline-b").revision != artifact.revision

    accepted = repository.list_links("baseline-a", review_state=ReviewState.ACCEPTED)
    assert [link.link_id for link in accepted] == [
        "LNK-001",
        "LNK-002",
        "LNK-003",
        "LNK-004",
        "LNK-005",
        "LNK-006",
    ]
    proposed = repository.list_links("baseline-a", review_state=ReviewState.PROPOSED)
    assert [link.link_id for link in proposed] == ["LNK-007"]

    assert [item.evidence_id for item in repository.list_evidence("baseline-a")] == [
        "EV-001",
        "EV-002",
    ]
    assert repository.changed_artifacts("baseline-b", "baseline-a") == ["CODE-001", "TEST-002"]
    assert {item.artifact_id for item in repository.list_artifacts("baseline-b")} >= {
        "REQ-001",
        "REQ-003",
    }


def test_port_reads_raise_documented_errors(fixture_settings: Settings) -> None:
    from app.domain.errors import ArtifactNotFound, BaselineNotFound

    repository: ArtifactRepository = IngestedStore.from_settings(fixture_settings)
    with pytest.raises(ArtifactNotFound):
        repository.get_artifact("REQ-999", baseline="baseline-a")
    with pytest.raises(BaselineNotFound):
        repository.resolve_baseline("baseline-z")


# ------------------------------------------------- R2: link partitioning at the boundary


def test_thread_response_rejects_a_proposal_inside_accepted_links(client: TestClient) -> None:
    thread = client.get("/api/threads/REQ-002", params={"baseline": "baseline-a"}).json()
    thread["accepted_links"] = thread.pop("proposed_links")
    thread["proposed_links"] = []
    with pytest.raises(ValidationError) as failure:
        ThreadResponse.model_validate(thread)
    assert "accepted_links" in str(failure.value)


def test_thread_response_rejects_an_accepted_link_inside_proposals(client: TestClient) -> None:
    thread = client.get("/api/threads/REQ-001", params={"baseline": "baseline-a"}).json()
    thread["proposed_links"] = thread.pop("accepted_links")
    thread["accepted_links"] = []
    with pytest.raises(ValidationError) as failure:
        ThreadResponse.model_validate(thread)
    assert "proposed_links" in str(failure.value)


def test_thread_is_served_without_example_files(fixture_settings: Settings, tmp_path: Path) -> None:
    fixtures = fixture_copy(fixture_settings, tmp_path)
    shutil.rmtree(fixtures / "api-responses" / "threads")

    response = app_over(fixture_settings, fixtures).get(
        "/api/threads/REQ-001", params={"baseline": "baseline-b"}
    )
    assert response.status_code == 200
    body = ThreadResponse.model_validate(response.json())
    assert [artifact.artifact_id for artifact in body.artifacts] == [
        "CODE-001",
        "REQ-001",
        "SCN-001",
        "TEST-001",
    ]
    assert body.schema_version == SCHEMA_VERSION


# ------------------------------------------------- R4: unsupported contract versions


def test_served_responses_reject_an_unsupported_schema_version(
    fixture_settings: Settings, tmp_path: Path
) -> None:
    """R4 regression: a contract-bearing fixture file with a foreign version is refused.

    The findings endpoint no longer serves a fixture file (M2 evaluates the rule set), so the
    probe targets the candidate index the fake discovery provider loads.
    """
    fixtures = fixture_copy(fixture_settings, tmp_path)
    path = fixtures / "banking-demo" / "expected" / "candidate-links.json"
    payload = json.loads(path.read_text(encoding="utf-8"))
    payload["schema_version"] = "999.0.0"
    path.write_text(json.dumps(payload), encoding="utf-8")

    response = app_over(fixture_settings, fixtures).post(
        "/api/discovery", json={"artifact_id": "SCN-001"}
    )
    assert response.status_code == 500
    problem = response.json()
    assert problem["code"] == "fixture-data-invalid"
    assert "999.0.0" in problem["detail"]


def test_candidate_index_version_is_enforced(fixture_settings: Settings) -> None:
    """The snapshot is a test oracle now; the served app reads git and the baselines manifest."""
    index = load_model(fixture_settings.candidate_index_path, CandidateIndexFile)
    with pytest.raises(FixtureDataInvalid):
        FakeCandidateDiscovery(index.model_copy(update={"schema_version": "999.0.0"}))
import assert from 'node:assert/strict';
import { Given, Then, When } from '@cucumber/cucumber';

function quoted(text) {
  return [...text.matchAll(/"([^"]+)"/g)].map((match) => match[1]);
}

function findings(world) {
  return world.results.findings.findings;
}

Given('the fixture generator builds {string} twice in different directories', function (fixture) {
  assert.equal(fixture, 'banking-demo');
  this.results.builds = [this.call('build_fixture', {}), this.call('build_fixture', {})];
});

When('each generated repository is asked for the tags {string} and {string}', function (a, b) {
  this.results.askedTags = [a, b];
});

Then('both repositories report the same commit SHA for each tag', function () {
  const [first, second] = this.results.builds;
  for (const tag of this.results.askedTags) {
    assert.equal(first.tags[tag], second.tags[tag], `tag ${tag} differs between builds`);
    assert.equal(first.tags[tag].length, 40);
  }
});

Then('those SHAs match the committed manifest {string}', function (path) {
  assert.ok(path.endsWith('baselines.json'));
  const { tags } = this.call('manifest', {});
  for (const tag of this.results.askedTags) {
    assert.equal(this.results.builds[0].tags[tag], tags[tag]);
  }
});

Given('{string} has accepted links to {string}, {string}, and {string}', function (
  rootId,
  first,
  second,
  third,
) {
  const { thread } = this.call('thread', { id: rootId, baseline: 'baseline-a' });
  const targets = thread.accepted_links.flatMap((link) => [link.source_id, link.target_id]);
  for (const id of [first, second, third]) {
    assert.ok(targets.includes(id), `thread does not reach ${id}`);
  }
});

Given(
  'evidence {string} recorded a passing run for {string} at baseline {string}',
  function (evidenceId, testId, baseline) {
    const { evidence } = this.call('ingest', { revision: baseline });
    const row = evidence.find((item) => item.evidence_id === evidenceId);
    assert.ok(row, `${evidenceId} missing at ${baseline}`);
    assert.equal(row.test_id, testId);
    assert.equal(row.result, 'passed');
    assert.equal(row.scenario_id, 'SCN-001');
  },
);

When('findings for baseline {string} are inspected', function (baseline) {
  this.results.findings = this.call('findings', { baseline });
});

When('findings for baseline {string} or {string} are inspected', function (first, second) {
  this.results.findings = [this.call('findings', { baseline: first }), this.call('findings', { baseline: second })];
});

Then('no finding references {string}', function (artifactId) {
  const all = Array.isArray(this.results.findings)
    ? this.results.findings.flatMap((entry) => entry.findings)
    : findings(this);
  assert.deepEqual(
    all.filter((finding) => finding.artifact_ids.includes(artifactId)),
    [],
  );
});

Given('{string} has no accepted verification scenario', function (artifactId) {
  const { links } = this.call('links', { baseline: 'baseline-a' });
  assert.deepEqual(
