#!/usr/bin/env node
/**
 * Strict step-resolution gate for the CTA acceptance suite.
 *
 * Cucumber's process exit code is not enough: a suite can pass while a required scenario was
 * skipped or a step resolved ambiguously and was never executed. This gate reads the Cucumber
 * Messages report and fails when:
 *
 *   - the run did not finish successfully;
 *   - any step was reported UNDEFINED, AMBIGUOUS, or PENDING;
 *   - a pickle (concrete scenario case) never started.
 *
 * Usage: node tools/step-resolution.mjs [reports/cucumber-messages.ndjson]
 */
import fs from 'node:fs';

const reportPath = process.argv[2] || 'reports/cucumber-messages.ndjson';
const envelopes = fs
  .readFileSync(reportPath, 'utf8')
  .split('\n')
  .filter((line) => line.trim())
  .map((line) => JSON.parse(line));

const documents = new Map();
const pickles = new Map();
const testCases = new Map();
const startedByCase = new Map();
const results = new Map();
const definitions = new Map();
let runFinished = null;

for (const envelope of envelopes) {
  if (envelope.gherkinDocument) documents.set(envelope.gherkinDocument.uri, envelope.gherkinDocument);
  if (envelope.pickle) pickles.set(envelope.pickle.id, envelope.pickle);
  if (envelope.testCase) testCases.set(envelope.testCase.id, envelope.testCase);
  if (envelope.testCaseStarted) {
    const ids = startedByCase.get(envelope.testCaseStarted.testCaseId) ?? [];
    ids.push(envelope.testCaseStarted.id);
    startedByCase.set(envelope.testCaseStarted.testCaseId, ids);
  }
  if (envelope.stepDefinition) {
    const source = envelope.stepDefinition.sourceReference ?? {};
    definitions.set(envelope.stepDefinition.id, {
      pattern: envelope.stepDefinition.pattern?.source,
      where: `${source.uri ?? '?'}:${source.location?.line ?? '?'}`,
    });
  }
  if (envelope.testStepFinished) {
    results.set(
      `${envelope.testStepFinished.testCaseStartedId}:${envelope.testStepFinished.testStepId}`,
      envelope.testStepFinished.testStepResult,
    );
  }
  if (envelope.testRunFinished) runFinished = envelope.testRunFinished;
}

function stepLocations(uri) {
  const byId = new Map();
  const walk = (steps) => {
    for (const step of steps ?? []) byId.set(step.id, step.location.line);
  };
  for (const child of documents.get(uri)?.feature?.children ?? []) {
    if (child.background) walk(child.background.steps);
    if (child.scenario) walk(child.scenario.steps);
    for (const sub of child.rule?.children ?? []) {
      if (sub.background) walk(sub.background.steps);
      if (sub.scenario) walk(sub.scenario.steps);
    }
  }
  return byId;
}

const problems = [];
if (!runFinished) problems.push('report has no testRunFinished envelope');
else if (!runFinished.success) problems.push('the run did not finish successfully');

for (const [caseId, testCase] of testCases) {
  const pickle = pickles.get(testCase.pickleId);
  if (!pickle) {
    problems.push(`test case ${caseId} references an unknown pickle`);
    continue;
  }
  const attemptIds = startedByCase.get(caseId) ?? [];
  if (attemptIds.length === 0) {
    problems.push(`${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" never started`);
    continue;
  }
  const locations = stepLocations(pickle.uri);
  const stepsById = new Map((testCase.testSteps ?? []).map((step) => [step.id, step]));
  for (const attemptId of attemptIds) {
    for (const [key, result] of results) {
      const [startedId, testStepId] = key.split(':');
      if (startedId !== attemptId) continue;
      const caseStep = stepsById.get(testStepId);
      if (!caseStep?.pickleStepId) continue;
      const pickleStep = pickle.steps.find((step) => step.id === caseStep.pickleStepId);
      if (!pickleStep) continue;
      if (!['UNDEFINED', 'AMBIGUOUS', 'PENDING', 'SKIPPED', 'UNKNOWN'].includes(result.status)) {
        continue;
      }
      const line = locations.get(pickleStep.astNodeIds?.[0]) ?? '?';
      const matched = (caseStep.stepDefinitionIds ?? []).map(
        (id) => definitions.get(id)?.where ?? id,
      );
      const detail =
        result.status === 'UNDEFINED'
          ? 'no matching definition'
          : result.status === 'AMBIGUOUS'
            ? `${matched.length} definitions: ${matched.join(', ')}`
            : result.status === 'SKIPPED'
              ? 'was not executed (SKIPPED; dry run or an earlier failure)'
              : result.status === 'PENDING'
                ? 'is pending'
                : 'has no result';
      problems.push(
        `${pickle.uri}:${line} "${pickle.name}" step "${pickleStep.text}" ${detail} ` +
          `[${result.status}]`,
      );
    }
  }
}

if (problems.length > 0) {
  console.error('step-resolution: FAILED');
  for (const problem of [...new Set(problems)].sort()) console.error(`  - ${problem}`);
  process.exit(1);
}
console.log(
  `step-resolution: ok (${testCases.size} test cases, ${results.size} step results, all resolved and started)`,
);
#!/usr/bin/env python3
"""Generate the repository-wide feature inventory artifact.

Counts and step patterns are parsed from the tracked feature files; classification, execution
status, and exclusion reasons are declared here by hand. The two kinds of information are kept in
separate fields so a reader can tell a parsed count from a review decision.

    uv run --project backend python tools/feature_inventory.py

Writes ``docs/feature-inventory.json`` and ``docs/feature-inventory.md``.
"""

from __future__ import annotations

import json
import subprocess
from pathlib import Path

from gherkin.parser import Parser
from gherkin.token_scanner import TokenScanner

ROOT = Path(__file__).resolve().parents[1]
OUT_JSON = ROOT / "docs" / "feature-inventory.json"
OUT_MD = ROOT / "docs" / "feature-inventory.md"
DEFAULT_REPORT = ROOT / "docs" / "reports" / "omp-m2-bdd" / "evidence" / "cucumber-messages.ndjson"

#: Hand-declared disposition per tracked feature file.
DISPOSITIONS: dict[str, dict[str, str]] = {
    "docs/stories/DT-01.feature": {"status": "executed", "reason": ""},
    "docs/stories/DT-02.feature": {"status": "executed", "reason": ""},
    "docs/stories/DT-03.feature": {"status": "executed", "reason": ""},
    "docs/stories/DT-04.feature": {"status": "executed", "reason": ""},
    "docs/stories/DT-05.feature": {"status": "executed", "reason": ""},
    "docs/stories/DT-06.feature": {"status": "executed", "reason": ""},
    "docs/stories/AS-01.feature": {"status": "executed", "reason": ""},
    "docs/stories/AS-02.feature": {"status": "executed", "reason": ""},
    "docs/stories/AS-03.feature": {"status": "executed", "reason": ""},
    "docs/stories/AS-04.feature": {
        "status": "component-tested",
        "reason": "Dashboard rendering is verified by Vitest component tests and a recorded "
        "browser demonstration; browser-level Cucumber bindings are pending under GT-02.",
    },
    "docs/stories/AS-05.feature": {
        "status": "component-tested",
        "reason": "Findings drill-down rendering is verified by Vitest component tests and a "
        "recorded browser demonstration; browser-level Cucumber bindings are pending under GT-02.",
    },
    "docs/stories/FT-01.feature": {"status": "executed", "reason": ""},
    "docs/stories/FT-02.feature": {
        "status": "executed-with-superseded-scenario",
        "reason": "SCN-205 asserted the M0 501 contract; AS-01 implemented the endpoint in M1. The "
        "scenario keeps its approved wording and is excluded by @superseded-by-AS-01.",
    },
    "docs/stories/FT-03.feature": {
        "status": "inspection",
        "reason": "Process/governance criteria verified by inspection and analysis per FT-03.md; "
        "they assert document properties, not application behaviour.",
    },
    "docs/stories/SETUP-01.feature": {
        "status": "mapped-pytest",
        "reason": "Commit-history lint behaviour is verified by 28 mapped pytest checks in "
        "backend/tests/test_commitlint.py; Cucumber bindings are pending under GT-02.",
    },
    "docs/stories/AI-01.feature": {"status": "executed", "reason": ""},
    "docs/stories/AI-06.feature": {
        "status": "out-of-scope",
        "reason": "M3 CocoIndex slice; not an M0/M1 acceptance feature and outside the M2 "
        "executable-migration scope.",
    },
    "docs/stories/GT-01.feature": {"status": "executed", "reason": ""},
    "docs/stories/GT-02.feature": {"status": "executed", "reason": ""},
    "docs/stories/GT-03.feature": {"status": "executed", "reason": ""},
    "docs/stories/PG-01.feature": {"status": "executed", "reason": ""},
    "bdd/probes/passing/feature.feature": {
        "status": "probe",
        "reason": "Harness probe executed on demand by GT-01 to prove real assertion reporting.",
    },
    "bdd/probes/undefined/feature.feature": {
        "status": "probe",
        "reason": "GT-01 probe: undefined steps must fail the gate.",
    },
    "bdd/probes/ambiguous/feature.feature": {
        "status": "probe",
        "reason": "GT-01 probe: ambiguous steps must fail the gate.",
    },
    "bdd/probes/failing/feature.feature": {
        "status": "probe",
        "reason": "GT-01 probe: assertion failures must be recorded.",
    },
    "fixtures/external-recipes/tree/features/browse.feature": {
        "status": "external",
        "reason": "Independently developed fixture indexed read-only by the portable path; never "
        "executed by CTA's acceptance suite and never modified.",
    },
    "fixtures/external-recipes/tree/features/publish.feature": {
        "status": "external",
        "reason": "Independently developed fixture indexed read-only by the portable path; never "
        "executed by CTA's acceptance suite and never modified.",
    },
    "fixtures/external-recipes/changes/02-ratings/features/ratings.feature": {
        "status": "external",
        "reason": "Second-revision overlay of the external fixture; used to prove revision "
        "isolation and undefined-step reporting from a real framework report.",
    },
    "fixtures/external-twin/tree/features/browse.feature": {
        "status": "external",
        "reason": "Collision probe: same relative path and @SCN-001 tag as external-recipes.",
    },
    "fixtures/banking-demo/tree/features/withdrawals.feature": {
        "status": "monitored",
        "reason": "Specification of the monitored banking application; executed by that "
        "application's own pytest suite, never by CTA's acceptance suite.",
    },
    "fixtures/banking-demo/tree/features/transfers.feature": {
        "status": "monitored",
        "reason": "Specification of the monitored banking application; executed by that "
        "application's own pytest suite, never by CTA's acceptance suite.",
    },
}

CLASSIFICATIONS = {
    "monitored": "monitored_application_specification",
    "probe": "harness_probe",
    "external": "external_indexed_specification",
}
DEFAULT_CLASSIFICATION = "cta_acceptance_specification"


def tracked_features() -> list[str]:
    output = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "*.feature"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=True,
    )
    return sorted(line for line in output.stdout.splitlines() if line)


def parse(path: Path) -> tuple[int, list[str]]:
    document = Parser().parse(TokenScanner(path.read_text(encoding="utf-8")))
    feature = document["feature"]
    scenarios: list[dict] = []

    def collect(children: list[dict], rule: str | None = None) -> None:
        for child in children:
            if "background" in child:
                continue
            if "rule" in child:
                collect(child["rule"].get("children", []), child["rule"].get("name"))
                continue
            scenario = child.get("scenario")
            if scenario is not None:
                scenarios.append({"scenario": scenario, "rule": rule})

    collect(feature.get("children", []))
    patterns: list[str] = []
    for entry in scenarios:
        for step in entry["scenario"].get("steps", []):
            pattern = f"{step['keyword'].strip()} {step['text']}".strip()
            if pattern not in patterns:
                patterns.append(pattern)
    return len(scenarios), patterns


def report_stats(report: Path) -> dict[str, dict[str, int]]:
    """Per feature URI: pickles, started test cases, failed test cases."""
    import json

    if not report.exists():
        raise SystemExit(f"acceptance report {report} is missing; run the Cucumber suite first")
    documents: set[str] = set()
    pickles: dict[str, str] = {}
    test_cases: dict[str, dict] = {}
    started: dict[str, str] = {}
    results: dict[str, list[str]] = {}
    for line in report.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        envelope = json.loads(line)
        if "gherkinDocument" in envelope:
            documents.add(envelope["gherkinDocument"]["uri"])
        if "pickle" in envelope:
            pickles[envelope["pickle"]["id"]] = envelope["pickle"]["uri"]
        if "testCase" in envelope:
            test_cases[envelope["testCase"]["id"]] = envelope["testCase"]
        if "testCaseStarted" in envelope:
            started[envelope["testCaseStarted"]["id"]] = envelope["testCaseStarted"]["testCaseId"]
        if "testStepFinished" in envelope:
            item = envelope["testStepFinished"]
            results.setdefault(item["testCaseStartedId"], []).append(
                item["testStepResult"]["status"]
            )
    stats: dict[str, dict[str, int]] = {
        uri.lstrip("./"): {"pickles": 0, "cases": 0, "started": 0, "failed": 0} for uri in documents
    }
    for _pickle_id, uri in pickles.items():
        stats.setdefault(uri.lstrip("./"), {"pickles": 0, "cases": 0, "started": 0, "failed": 0})[
            "pickles"
        ] += 1
    for case_id, case in test_cases.items():
        uri = pickles.get(case["pickleId"])
        if uri is None:
            continue
        entry = stats.setdefault(
            uri.lstrip("./"), {"pickles": 0, "cases": 0, "started": 0, "failed": 0}
        )
        entry["cases"] += 1
        attempts = [key for key, value in started.items() if value == case_id]
        if not attempts:
            continue
        entry["started"] += 1
        if any("FAILED" in results.get(attempt, []) for attempt in attempts):
            entry["failed"] += 1
    return stats


def main() -> int:
    files = tracked_features()
    stats = report_stats(DEFAULT_REPORT)
    entries = []
    for name in files:
        disposition = DISPOSITIONS.get(name)
        if disposition is None:
            raise SystemExit(f"{name} has no declared disposition; add one before regenerating")
        scenario_count, patterns = parse(ROOT / name)
        story = Path(name).stem.split(".")[0]
        status = disposition["status"]
        stats_for_file = stats.get(name, {"pickles": 0, "cases": 0, "started": 0, "failed": 0})
        declared_executed = status.startswith("executed")
        if declared_executed and stats_for_file["pickles"] == 0:
            raise SystemExit(f"{name} is declared executed but absent from {DEFAULT_REPORT}")
        if declared_executed and stats_for_file["started"] < stats_for_file["cases"]:
            raise SystemExit(
                f"{name} is declared executed but only {stats_for_file['started']} of "
                f"{stats_for_file['cases']} test cases started"
            )
        if not declared_executed and stats_for_file["started"]:
            raise SystemExit(
                f"{name} is declared not executed but appears as started in the report"
            )
        executed = declared_executed and stats_for_file["cases"] > 0
        entries.append(
            {
                "file": name,
                "classification": CLASSIFICATIONS.get(status, DEFAULT_CLASSIFICATION),
                "story_id": story if name.startswith("docs/stories/") else None,
                "scenario_count": scenario_count,
                "unique_step_patterns": patterns,
                "cucumber_status": "executed" if executed else "not_executed",
                "execution_result": (
                    "failed"
                    if executed and stats_for_file["failed"]
                    else "passing"
                    if executed
                    else "on_demand"
                    if status == "probe"
                    else "not_applicable"
                ),
                "executed_scenarios": stats_for_file["started"] if executed else 0,
                "failed_scenarios": stats_for_file["failed"] if executed else 0,
                "report": str(DEFAULT_REPORT.relative_to(ROOT)) if executed else None,
                "migration_status": "complete" if executed else "pending",
                "reason": disposition["reason"],
                "repository_identity": "cta" if name.startswith("docs/") else "banking-demo",
                "ref": str(DEFAULT_REPORT.relative_to(ROOT)) if executed else None,
                "annotation_dependency": name.startswith("fixtures/"),
                "binding_evidence": "cucumber-js 13.3.0 messages" if executed else "not_executed",
                "modification_audit": "read-only input" if name.startswith("fixtures/") else "n/a",
            }
        )
    payload = {
        "generated_by": "tools/feature_inventory.py",
        "notes": [
            "Counts and step patterns are parsed; classification, status, and reasons are declared "
            "in the generator by hand.",
            "Cucumber execution is recorded only for entries with a captured messages report.",
        ],
        "features": entries,
    }
    OUT_JSON.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    lines = [
        "# Feature inventory",
        "",
        "Generated by `tools/feature_inventory.py`; counts are parsed, "
        "classifications are declared.",
        "",
        "| Feature | Classification | Scenarios | Cucumber | Migration | Reason |",
        "| --- | --- | --- | --- | --- | --- |",
    ]
    for entry in entries:
        lines.append(
            f"| `{entry['file']}` | {entry['classification']} | {entry['scenario_count']} | "
            f"{entry['cucumber_status']} | {entry['migration_status']} | {entry['reason'] or '—'} |"
        )
    OUT_MD.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(
        f"wrote {OUT_JSON.relative_to(ROOT)} and {OUT_MD.relative_to(ROOT)} ({len(entries)} files)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { Given, Then, When } from '@cucumber/cucumber';

const BDD_ROOT = path.resolve(import.meta.dirname, '..');
const REPO_ROOT = path.resolve(BDD_ROOT, '..');
const CUCUMBER = path.join(BDD_ROOT, 'node_modules', '.bin', 'cucumber-js');
const GATE = path.join(BDD_ROOT, 'tools', 'step-resolution.mjs');

function runProbe(name, extraArgs = []) {
  const report = path.join(BDD_ROOT, 'reports', `probe-${name}.ndjson`);
  fs.mkdirSync(path.dirname(report), { recursive: true });
  const result = spawnSync(
    CUCUMBER,
    [
      '--config',
      'probes/cucumber.mjs',
      '--import',
      `probes/${name}/steps.js`,
      '--format',
      `message:${report}`,
      ...extraArgs,
      `probes/${name}/feature.feature`,
    ],
    { cwd: BDD_ROOT, encoding: 'utf8' },
  );
  return { status: result.status, stdout: result.stdout, stderr: result.stderr, report };
}

function envelopes(report) {
  return fs
    .readFileSync(report, 'utf8')
    .split('\n')
    .filter((line) => line.trim())
    .map((line) => JSON.parse(line));
}

function gate(report) {
  const result = spawnSync(process.execPath, [GATE, report], {
    cwd: BDD_ROOT,
    encoding: 'utf8',
  });
  return { status: result.status, stdout: result.stdout, stderr: result.stderr };
}

Given('a probe acceptance suite whose step performs a real assertion', function () {
  this.results.probe = 'passing';
});

Given('a probe acceptance suite with an undefined step', function () {
  this.results.probe = 'undefined';
});

Given('a probe acceptance suite with an ambiguous step', function () {
  this.results.probe = 'ambiguous';
});

Given('a probe acceptance suite with a deliberately failing assertion', function () {
  this.results.probe = 'failing';
});

Given('a probe acceptance suite run without executing steps', function () {
  this.results.probe = 'passing';
  this.results.dryRun = true;
});

When('the probe suite runs through the selected Cucumber runtime', function () {
  this.results.run = runProbe(this.results.probe);
});

When('strict step-resolution validation runs', function () {
  this.results.run = runProbe(this.results.probe, this.results.dryRun ? ['--dry-run'] : []);
  this.results.gate = gate(this.results.run.report);
});

Then('the scenario executes and passes', function () {
  assert.equal(this.results.run.status, 0, this.results.run.stderr);
});

Then('the structured report records the scenario and each step outcome', function () {
  const messages = envelopes(this.results.run.report);
  const pickle = messages.find((envelope) => envelope.pickle).pickle;
  assert.equal(pickle.name, 'A real assertion runs');
