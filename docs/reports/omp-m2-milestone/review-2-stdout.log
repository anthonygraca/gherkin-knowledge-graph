function reportStats(report) {
  const messages = envelopes(report);
  const pickles = new Map();
  const cases = new Map();
  const attempts = new Map();
  const outcomes = new Map();
  const documents = new Set();
  for (const envelope of messages) {
    if (envelope.gherkinDocument) documents.add(envelope.gherkinDocument.uri.replace(/^\.\.\//, ''));
    if (envelope.pickle) pickles.set(envelope.pickle.id, envelope.pickle.uri.replace(/^\.\.\//, ''));
    if (envelope.testCase) cases.set(envelope.testCase.id, envelope.testCase.pickleId);
    if (envelope.testCaseStarted) {
      const list = attempts.get(envelope.testCaseStarted.testCaseId) ?? [];
      list.push(envelope.testCaseStarted.id);
      attempts.set(envelope.testCaseStarted.testCaseId, list);
    }
    if (envelope.testStepFinished) {
      const list = outcomes.get(envelope.testStepFinished.testCaseStartedId) ?? [];
      list.push(envelope.testStepFinished.testStepResult.status);
      outcomes.set(envelope.testStepFinished.testCaseStartedId, list);
    }
  }
  const stats = new Map();
  const entry = (uri) => {
    if (!stats.has(uri)) stats.set(uri, { pickles: 0, cases: 0, started: 0, failed: 0 });
    return stats.get(uri);
  };
  for (const uri of documents) entry(uri);
  for (const uri of pickles.values()) entry(uri).pickles += 1;
  for (const [caseId, pickleId] of cases) {
    const uri = pickles.get(pickleId);
    if (!uri) continue;
    const row = entry(uri);
    row.cases += 1;
    const startedIds = attempts.get(caseId) ?? [];
    if (startedIds.length === 0) continue;
    row.started += 1;
    if (startedIds.some((id) => (outcomes.get(id) ?? []).includes('FAILED'))) row.failed += 1;
  }
  return stats;
}

When("the inventory's executed entries are compared with the report", function () {
  this.results.reportStats = reportStats(this.results.executionReport);
});

Then('every executed entry names a scenario present in that report', function () {
  const stats = this.results.reportStats;
  const executed = this.results.inventory.features.filter(
    (entry) => entry.cucumber_status === 'executed',
