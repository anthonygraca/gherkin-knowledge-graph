            : result.status === 'AMBIGUOUS'
              ? `${matched.length} definitions: ${matched.join(', ')}`
              : result.status === 'SKIPPED'
                ? 'was not executed (SKIPPED; dry run or an earlier failure)'
                : result.status === 'PENDING'
                  ? 'is pending'
                  : 'has no result';
        problems.push(
          `${pickle.uri}:${line} "${pickle.name}" step "${pickleStep.text}" ${detail} ` +
            `[${result.status}]`,
        );
      }
    }
  }
}

for (const pickle of pickles.values()) {
  if ((pickle.tags ?? []).some((tag) => excludedTags.has(tag.name))) continue;
  if (!coveredPickles.has(pickle.id)) {
    problems.push(
      `${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" has no test case ` +
        '(selected scenario omitted from the report)',
    );
  }
}

if (problems.length > 0) {
  console.error('step-resolution: FAILED');
  for (const problem of [...new Set(problems)].sort()) console.error(`  - ${problem}`);
  process.exit(1);
}
console.log(
  `step-resolution: ok (${testCases.size} test cases, ${results.size} step results, all resolved and started)`,
);
#!/usr/bin/env python3
"""Generate the repository-wide feature inventory artifact.

Counts and step patterns are parsed from the tracked feature files; classification, execution
status, and exclusion reasons are declared here by hand. The two kinds of information are kept in
separate fields so a reader can tell a parsed count from a review decision.

    uv run --project backend python tools/feature_inventory.py

Writes ``docs/feature-inventory.json`` and ``docs/feature-inventory.md``.
"""

from __future__ import annotations

import json
import re
import subprocess
from pathlib import Path

from gherkin.parser import Parser
from gherkin.token_scanner import TokenScanner

