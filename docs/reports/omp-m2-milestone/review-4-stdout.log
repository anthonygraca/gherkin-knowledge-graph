OUT_MD = ROOT / "docs" / "feature-inventory.md"
DEFAULT_REPORT = ROOT / "docs" / "reports" / "omp-m2-bdd" / "evidence" / "cucumber-messages.ndjson"

#: Hand-declared disposition per tracked feature file.
DISPOSITIONS: dict[str, dict[str, str]] = {
