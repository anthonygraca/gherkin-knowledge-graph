   272	
   273	def derive_repository_id(root: Path, explicit: str | None) -> tuple[str, IdentityStrategy]:
   274	    """Resolve a stable repository id without trusting the working tree's path."""
   275	    if explicit is not None:
   276	        normalized = explicit.strip().lower()
   277	        if not REPOSITORY_ID_RE.fullmatch(normalized):
   278	            raise PortableIndexError(
   279	                f"repository id {explicit!r} must match {REPOSITORY_ID_RE.pattern}"
   280	            )
   281	        return normalized, IdentityStrategy.EXPLICIT
   282	    repository = GitRepository(root)
   283	    remote = repository.remote_url()
   284	    if remote:
   285	        digest = hashlib.sha256(normalize_remote_url(remote).encode("utf-8")).hexdigest()[:12]
   286	        return f"repo-{digest}", IdentityStrategy.REMOTE_URL
   287	    roots = repository.root_commits()
   288	    if not roots:
   289	        raise PortableIndexError(
   290	            f"{root} has no commits, so no deterministic repository identity can be derived"
   291	        )
   292	    digest = hashlib.sha256(roots[0].encode("utf-8")).hexdigest()[:12]
   293	    return f"repo-{digest}", IdentityStrategy.ROOT_COMMIT
