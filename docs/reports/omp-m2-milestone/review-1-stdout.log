   317	                tested_commit=spec["tested_commit"],
   318	                adapter=spec.get("adapter", "cucumber-messages"),
   319	            ),
   320	        )
   321	    response = client.request(
   322	        args.get("method", "GET"), args["path"], json=args.get("json"), params=args.get("params")
   323	    )
   324	    try:
   325	        body = response.json()
   326	    except ValueError:
   327	        body = response.text
