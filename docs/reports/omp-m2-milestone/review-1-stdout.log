     1	"""Command-line access to the portable repository surface.
     2	
     3	Every command prints one JSON document on stdout and exits non-zero on failure. The CLI is a thin
     4	adapter over the same in-process registry the API uses; it deliberately performs no writes to the
     5	indexed repository and no project-code execution.
     6	
     7	    python -m app.cli index ../some-repo --repo-id some-repo --ref v1
     8	    python -m app.cli scenarios ../some-repo --repo-id some-repo --ref v1
     9	    python -m app.cli steps ../some-repo --repo-id some-repo --ref v1 --scenario <key>
    10	    python -m app.cli definitions ../some-repo --repo-id some-repo --ref v1 \\
    11	        --report report.ndjson --tested-commit <sha>
    12	    python -m app.cli unresolved ../some-repo --repo-id some-repo --ref v1 \\
    13	        --report report.ndjson --tested-commit <sha>
    14	    python -m app.cli executions ../some-repo --repo-id some-repo --ref v1
    15	    python -m app.cli findings ../some-repo --repo-id some-repo --ref v1
    16	
    17	The ref must be a tag or commit in the repository; queries never fall back to another revision.
    18	"""
    19	
    20	from __future__ import annotations
    21	
