   365	        path = _repo_path(state, args["name"])
   366	        repository = GitRepository(path)
   367	        first = {
   368	            a.artifact_id: a.content_hash
   369	            for a in ingest_revision(repository, args["rev_a"], repository_name="probe").artifacts
   370	        }
   371	        second = {
   372	            a.artifact_id: a.content_hash
   373	            for a in ingest_revision(repository, args["rev_b"], repository_name="probe").artifacts
   374	        }
   375	    else:
   376	        store = _store()
   377	        first = {a.artifact_id: a.content_hash for a in store.artifacts_at(args["rev_a"])}
   378	        second = {a.artifact_id: a.content_hash for a in store.artifacts_at(args["rev_b"])}
   379	    changed = sorted(
   380	        key for key in first.keys() | second.keys() if first.get(key) != second.get(key)
   381	    )
   382	    return {
   383	        "changed": changed,
   384	        "only_first": sorted(first.keys() - second.keys()),
   385	        "only_second": sorted(second.keys() - first.keys()),
   386	    }
