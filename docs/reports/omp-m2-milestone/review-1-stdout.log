   389	        step_nodes=step_nodes,
   390	    )
   391	    row_index = 0
   392	    for example in scenario.get("examples", []):
   393	        for row in example.get("tableBody", []):
   394	            row_index += 1
   395	            example_rows[row["id"]] = (scenario_key, row_index)
