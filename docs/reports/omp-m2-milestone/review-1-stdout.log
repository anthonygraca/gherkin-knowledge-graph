    38	    root: Path
    39	
    40	    def resolve(self, revision: str | None = None) -> str:
    41	        """Resolve a revision expression (tag, SHA, branch) to a commit SHA.
    42	
    43	        ``None`` selects the repository's current ``HEAD``. An unknown expression raises.
    44	        """
    45	        expression = revision or "HEAD"
    46	        output = self._run("rev-parse", "--verify", "--end-of-options", f"{expression}^{{commit}}")
    47	        return output.decode("utf-8", "replace").strip()
    48	
    49	    def list_paths(self, revision: str) -> list[str]:
    50	        """Every file path in the revision's tree, sorted, NUL-delimited for exact names."""
    51	        output = self._run("ls-tree", "-r", "-z", "--name-only", revision)
    52	        paths = [entry.decode("utf-8") for entry in output.split(b"\0") if entry]
    53	        return sorted(paths)
    54	
    55	    def list_tree(self, revision: str) -> list[TreeEntry]:
    56	        """Tree entries with mode, object id, and size, in one Git invocation.
    57	
    58	        The portable indexer needs the object id (to read blobs without re-resolving paths) and the
    59	        mode (to refuse symlinks and submodules instead of treating them as regular files).
    60	        """
    61	        output = self._run("ls-tree", "-r", "-z", "-l", revision)
    62	        entries: list[TreeEntry] = []
    63	        for record in output.split(b"\0"):
    64	            if not record:
    65	                continue
    66	            header, _, raw_path = record.partition(b"\t")
    67	            fields = header.decode("utf-8", "replace").split()
    68	            if len(fields) < 4:
    69	                raise IngestionError(f"unexpected `git ls-tree` record: {record!r}")
    70	            mode, object_type, object_id = fields[0], fields[1], fields[2]
    71	            size_field = fields[3]
    72	            entries.append(
    73	                TreeEntry(
    74	                    mode=mode,
    75	                    object_type=object_type,
    76	                    object_id=object_id,
    77	                    path=raw_path.decode("utf-8"),
    78	                    size=int(size_field) if size_field.isdigit() else None,
    79	                )
    80	            )
    81	        return sorted(entries, key=lambda entry: entry.path)
