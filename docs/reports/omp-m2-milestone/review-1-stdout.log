   171	def _make_repo(
   172	    tmp_path: Path, files: dict[str, str], symlinks: dict[str, str] | None = None
   173	) -> Path:
   174	    repo = tmp_path / "repo"
   175	    repo.mkdir()
   176	    _git(repo, "init", "--quiet", "-b", "main")
   177	    _git(repo, "config", "user.name", "Test")
   178	    _git(repo, "config", "user.email", "test@example.invalid")
   179	    for name, content in files.items():
   180	        target = repo / name
   181	        target.parent.mkdir(parents=True, exist_ok=True)
   182	        target.write_text(content, encoding="utf-8")
   183	    for name, target in (symlinks or {}).items():
   184	        (repo / name).symlink_to(target)
   185	    _git(repo, "add", "-A")
   186	    _git(repo, "commit", "--quiet", "-m", "fixture")
   187	    return repo
