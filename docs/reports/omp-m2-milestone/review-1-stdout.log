    98	def _bindings(args: argparse.Namespace, registry: PortableRegistry) -> BindingResponse:
    99	    snapshot = registry.snapshot(_repository_id(registry), args.ref)
   100	    availability, reason, definitions, resolutions, reports = registry.bindings(
