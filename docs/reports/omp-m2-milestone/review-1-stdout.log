     1	"""In-memory portable repository registry: indexes, imported reports, and derived facts.
     2	
     3	Scope rules that prevent silent mixups:
     4	
     5	* an index is keyed by ``(repository_id, resolved commit)``; a query never substitutes another
     6	  repository's data;
     7	* importing a report requires the tested commit to be an indexed snapshot of *that* repository;
     8	* the same report bytes imported twice is idempotent; a different report for the same run is a
     9	  separate, append-only record;
    10	* everything here is derived state. Nothing writes to the indexed repository.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from dataclasses import dataclass, field
    16	from datetime import UTC, datetime
    17	from pathlib import Path
    18	
    19	from app.assurance.executable_rules import evaluate_executable_findings
    20	from app.domain.errors import ReportNotApplicable, RepositoryNotIndexed
    21	from app.domain.executable import (
    22	    ExecutableFinding,
    23	    ExecutableRelation,
    24	    ExecutionCoverage,
    25	    RelationName,
    26	    RelationOrigin,
    27	    ReportProvenance,
    28	)
    29	from app.domain.portable import (
    30	    BindingAvailability,
    31	    ExecutionImportRequest,
    32	    PortableIndexSummary,
    33	    PortableSnapshot,
    34	    ScenarioExecutionRecord,
    35	    StepDefinitionRecord,
    36	    StepResolutionRecord,
    37	)
    38	from app.ingestion.cucumber_messages import CucumberMessagesAdapter, CucumberReportData
    39	from app.ingestion.portable import PortableIndexer, summarize
    40	from app.ingestion.repository import GitRepository
    41	
    42	
    43	@dataclass
    44	class RepositoryState:
    45	    repository_id: str
    46	    path: Path
    47	    snapshots: dict[str, PortableSnapshot] = field(default_factory=dict)
    48	    refs: dict[str, str] = field(default_factory=dict)
    49	    reports: dict[str, CucumberReportData] = field(default_factory=dict)
    50	    ingested_at: dict[str, datetime] = field(default_factory=dict)
    51	
    52	    def latest_commit(self) -> str:
    53	        return next(reversed(self.snapshots))
    54	
    55	
    56	@dataclass
    57	class PortableRegistry:
    58	    """All portable state for this process. Built empty; no default repository is inferred."""
    59	
    60	    indexer: PortableIndexer = field(default_factory=PortableIndexer)
    61	    adapter: CucumberMessagesAdapter = field(default_factory=CucumberMessagesAdapter)
    62	    repositories: dict[str, RepositoryState] = field(default_factory=dict)
    63	
    64	    # ------------------------------------------------------------------ indexing
    65	
    66	    def index(
    67	        self, path: str | Path, *, repository_id: str | None = None, revision: str | None = None
    68	    ) -> PortableIndexSummary:
    69	        snapshot = self.indexer.index(Path(path), repository_id=repository_id, revision=revision)
    70	        state = self.repositories.setdefault(
    71	            snapshot.repository_id,
    72	            RepositoryState(repository_id=snapshot.repository_id, path=Path(path)),
    73	        )
    74	        for name, commit in GitRepository(Path(path)).tags().items():
    75	            if commit in state.snapshots or commit == snapshot.revision:
    76	                state.refs.setdefault(name, commit)
    77	        if revision is not None:
    78	            state.refs.setdefault(revision, snapshot.revision)
    79	        existing = state.snapshots.get(snapshot.revision)
    80	        if existing is not None and existing.source_digest != snapshot.source_digest:
    81	            raise RepositoryNotIndexed(
    82	                f"re-indexing {snapshot.repository_id}@{snapshot.revision} produced a different "
    83	                "tree digest; the snapshot is not reproducible and must not be mixed"
    84	            )
    85	        state.snapshots[snapshot.revision] = existing or snapshot
    86	        counts = summarize(snapshot)
    87	        return PortableIndexSummary(
    88	            repository_id=snapshot.repository_id,
    89	            identity_strategy=snapshot.identity_strategy,
    90	            revision=snapshot.revision,
    91	            source_digest=snapshot.source_digest,
    92	            parser=snapshot.parser,
    93	            counts=counts,
    94	            files_modified=0,
    95	            hooks_executed=False,
    96	        )
    97	
    98	    def summaries(self) -> list[PortableIndexSummary]:
    99	        summaries: list[PortableIndexSummary] = []
   100	        for state in self.repositories.values():
   101	            for snapshot in state.snapshots.values():
   102	                summaries.append(
   103	                    PortableIndexSummary(
   104	                        repository_id=snapshot.repository_id,
   105	                        identity_strategy=snapshot.identity_strategy,
   106	                        revision=snapshot.revision,
   107	                        source_digest=snapshot.source_digest,
   108	                        parser=snapshot.parser,
   109	                        counts=summarize(snapshot),
   110	                        files_modified=0,
   111	                        hooks_executed=False,
   112	                    )
   113	                )
   114	        return sorted(summaries, key=lambda item: (item.repository_id, item.revision))
   115	
   116	    # ------------------------------------------------------------------- queries
   117	
   118	    def state(self, repository_id: str) -> RepositoryState:
   119	        state = self.repositories.get(repository_id)
   120	        if state is None:
   121	            known = ", ".join(sorted(self.repositories)) or "none"
   122	            raise RepositoryNotIndexed(
   123	                f"repository {repository_id!r} has not been indexed in this process; "
   124	                f"indexed repositories: {known}"
   125	            )
   126	        return state
   127	
   128	    def snapshot(self, repository_id: str, revision: str | None = None) -> PortableSnapshot:
   129	        state = self.state(repository_id)
   130	        if revision is None:
   131	            return state.snapshots[state.latest_commit()]
   132	        if revision in state.snapshots:
   133	            return state.snapshots[revision]
   134	        pinned = state.refs.get(revision)
   135	        if pinned is not None and pinned in state.snapshots:
   136	            return state.snapshots[pinned]
   137	        matches = [commit for commit in state.snapshots if commit.startswith(revision)]
   138	        if len(matches) == 1:
   139	            return state.snapshots[matches[0]]
   140	        if not matches:
   141	            raise RepositoryNotIndexed(
   142	                f"revision {revision!r} of {repository_id!r} is not indexed; index it explicitly"
   143	            )
   144	        raise RepositoryNotIndexed(f"revision {revision!r} is ambiguous in {repository_id!r}")
   145	
   146	    # ------------------------------------------------------------------- reports
   147	
   148	    def import_report(
   149	        self, repository_id: str, request: ExecutionImportRequest
   150	    ) -> tuple[CucumberReportData, bool]:
   151	        state = self.state(repository_id)
   152	        snapshot = self.snapshot(repository_id, request.tested_commit)
   153	        if snapshot.revision != request.tested_commit and not snapshot.revision.startswith(
   154	            request.tested_commit
   155	        ):
   156	            raise ReportNotApplicable(
   157	                f"tested commit {request.tested_commit!r} does not match indexed revision "
   158	                f"{snapshot.revision!r}"
   159	            )
   160	        if request.adapter != "cucumber-messages":
   161	            raise ReportNotApplicable(
   162	                f"adapter {request.adapter!r} is not supported; supported: cucumber-messages"
   163	            )
   164	        report = self.adapter.parse(
   165	            Path(request.report_path),
   166	            repository_id=repository_id,
   167	            tested_commit=snapshot.revision,
   168	        )
   169	        by_path = {feature.path: feature for feature in snapshot.features}
   170	        for uri, digest in report.sources:
   171	            feature = by_path.get(uri)
   172	            if feature is None:
   173	                raise ReportNotApplicable(
   174	                    f"report covers {uri!r}, which is not a feature file at "
   175	                    f"{repository_id}@{snapshot.revision}; the run did not test this revision"
   176	                )
   177	            if feature.content_hash != digest:
   178	                raise ReportNotApplicable(
   179	                    f"report parsed {uri!r} with content {digest}, but that file differs at "
   180	                    f"{repository_id}@{snapshot.revision} ({feature.content_hash}); the run did "
   181	                    "not test this revision"
   182	                )
   183	        key = report.report_digest
   184	        already = key in state.reports
   185	        state.reports.setdefault(key, report)
   186	        state.ingested_at.setdefault(key, datetime.now(UTC))
   187	        return state.reports[key], already
   188	
   189	    def reports_for(self, repository_id: str, revision: str) -> list[CucumberReportData]:
   190	        state = self.state(repository_id)
   191	        snapshot = self.snapshot(repository_id, revision)
   192	        return sorted(
   193	            (
   194	                report
   195	                for report in state.reports.values()
   196	                if report.executions
   197	                and all(item.tested_commit == snapshot.revision for item in report.executions)
   198	            ),
   199	            key=lambda report: report.report_digest,
   200	        )
   201	
   202	    def bindings(
   203	        self, repository_id: str, revision: str | None = None
   204	    ) -> tuple[
   205	        BindingAvailability,
   206	        str,
   207	        list[StepDefinitionRecord],
   208	        list[StepResolutionRecord],
   209	        list[CucumberReportData],
   210	    ]:
   211	        snapshot = self.snapshot(repository_id, revision)
   212	        reports = self.reports_for(repository_id, snapshot.revision)
   213	        if not reports:
   214	            return (
   215	                BindingAvailability.NOT_AVAILABLE,
   216	                "no trusted framework matching report has been imported for this revision; "
   217	                "step matching is unknown, not undefined",
   218	                [],
   219	                [],
   220	                [],
   221	            )
   222	        definitions: dict[str, StepDefinitionRecord] = {}
   223	        resolutions: dict[tuple[str, str | None, str], StepResolutionRecord] = {}
   224	        for report in reports:
   225	            for definition in report.step_definitions:
   226	                definitions.setdefault(definition.definition_key, definition)
   227	            for resolution in report.resolutions:
   228	                resolutions.setdefault(
   229	                    (resolution.scenario_key, resolution.instance_key, resolution.step_key),
   230	                    resolution,
   231	                )
   232	        return (
   233	            BindingAvailability.AVAILABLE,
   234	            "framework-reported step definitions and matches",
   235	            sorted(definitions.values(), key=lambda item: item.definition_key),
   236	            sorted(
   237	                resolutions.values(),
   238	                key=lambda item: (item.scenario_key, item.instance_key or "", item.step_key),
   239	            ),
   240	            reports,
   241	        )
   242	
   243	    def executions(
   244	        self, repository_id: str, revision: str | None = None
   245	    ) -> tuple[list[ScenarioExecutionRecord], list[CucumberReportData]]:
   246	        snapshot = self.snapshot(repository_id, revision)
   247	        reports = self.reports_for(repository_id, snapshot.revision)
   248	        executions = [execution for report in reports for execution in report.executions]
   249	        return (
   250	            sorted(
   251	                executions,
   252	                key=lambda item: (item.scenario_key, item.executed_at, item.execution_key),
   253	            ),
   254	            reports,
   255	        )
   256	
   257	    def coverage(self, repository_id: str, revision: str | None = None) -> ExecutionCoverage:
   258	        snapshot = self.snapshot(repository_id, revision)
   259	        executions, _ = self.executions(repository_id, snapshot.revision)
   260	        scenarios = [scenario for feature in snapshot.features for scenario in feature.scenarios]
   261	        executed = {execution.scenario_key for execution in executions}
   262	        declared_steps = {step.step_key for scenario in scenarios for step in scenario.steps}
   263	        executed_steps = {
   264	            step.step_key for execution in executions for step in execution.steps
   265	        } & declared_steps
   266	        return ExecutionCoverage(
   267	            scenarios_total=len(scenarios),
   268	            scenarios_executed=len(executed & {scenario.scenario_key for scenario in scenarios}),
   269	            scenarios_without_execution=len(
   270	                {scenario.scenario_key for scenario in scenarios} - executed
   271	            ),
   272	            steps_total=len(declared_steps),
   273	            steps_executed=len(executed_steps),
   274	        )
   275	
   276	    def provenance(self, repository_id: str) -> list[ReportProvenance]:
   277	        state = self.state(repository_id)
   278	        provenance: list[ReportProvenance] = []
   279	        for digest, report in sorted(state.reports.items()):
   280	            provenance.append(
   281	                ReportProvenance(
   282	                    report_uri=report.report_uri,
   283	                    report_digest=report.report_digest,
   284	                    adapter=report.adapter,
   285	                    runtime=report.runtime,
   286	                    protocol_version=report.protocol_version,
   287	                    tested_commit=report.executions[0].tested_commit,
   288	                    imported_at=state.ingested_at[digest],
   289	                    execution_count=len(report.executions),
   290	                )
   291	            )
   292	        return provenance
   293	
   294	    # ----------------------------------------------------------------- graph edges
   295	
   296	    def relations(
   297	        self, repository_id: str, revision: str | None = None
   298	    ) -> list[ExecutableRelation]:
   299	        snapshot = self.snapshot(repository_id, revision)
   300	        relations: list[ExecutableRelation] = []
   301	        for feature in snapshot.features:
   302	            for scenario in feature.scenarios:
   303	                for step in scenario.steps:
   304	                    if step.from_background:
   305	                        continue
   306	                    relations.append(
   307	                        ExecutableRelation(
   308	                            relation=RelationName.HAS_STEP,
   309	                            origin=RelationOrigin.EXTRACTED,
   310	                            source_key=scenario.scenario_key,
   311	                            target_key=step.step_key,
   312	                            provenance={"parser": snapshot.parser, "revision": snapshot.revision},
   313	                        )
   314	                    )
   315	                for instance in scenario.instances:
   316	                    relations.append(
   317	                        ExecutableRelation(
   318	                            relation=RelationName.EXPANDS_TO,
   319	                            origin=RelationOrigin.EXTRACTED,
   320	                            source_key=scenario.scenario_key,
   321	                            target_key=instance.instance_key,
   322	                            provenance={"parser": snapshot.parser, "revision": snapshot.revision},
   323	                        )
   324	                    )
   325	        status, _, _, resolutions, reports = self.bindings(repository_id, snapshot.revision)
   326	        if status is BindingAvailability.AVAILABLE:
   327	            digests = ",".join(sorted(report.report_digest for report in reports))
   328	            for resolution in resolutions:
   329	                if resolution.status.value == "matched":
   330	                    for definition_key in resolution.definition_keys:
   331	                        relations.append(
   332	                            ExecutableRelation(
   333	                                relation=RelationName.MATCHES_DEFINITION,
   334	                                origin=RelationOrigin.MATCHED,
   335	                                source_key=resolution.step_key,
   336	                                target_key=definition_key,
   337	                                provenance={
   338	                                    "report_digest": digests,
   339	                                    "adapter": "cucumber-messages",
   340	                                },
   341	                            )
   342	                        )
   343	        executions, _ = self.executions(repository_id, snapshot.revision)
   344	        for execution in executions:
   345	            for step in execution.steps:
   346	                relations.append(
   347	                    ExecutableRelation(
   348	                        relation=RelationName.HAS_STEP_EXECUTION,
   349	                        origin=RelationOrigin.OBSERVED,
   350	                        source_key=execution.execution_key,
   351	                        target_key=step.step_key,
   352	                        provenance={
   353	                            "report_digest": execution.report_digest,
   354	                            "tested_commit": execution.tested_commit,
   355	                        },
   356	                    )
   357	                )
   358	                if step.definition_keys:
   359	                    for definition_key in step.definition_keys:
   360	                        relations.append(
   361	                            ExecutableRelation(
   362	                                relation=RelationName.EXECUTED_DEFINITION,
   363	                                origin=RelationOrigin.OBSERVED,
   364	                                source_key=step.step_key,
   365	                                target_key=definition_key,
   366	                                provenance={
   367	                                    "report_digest": execution.report_digest,
   368	                                    "execution_key": execution.execution_key,
   369	                                },
   370	                            )
   371	                        )
   372	        return sorted(
   373	            relations,
   374	            key=lambda item: (
   375	                item.relation.value,
   376	                item.source_key,
   377	                item.target_key,
   378	                item.origin.value,
   379	            ),
   380	        )
   381	
   382	    # ------------------------------------------------------------------ findings
   383	
   384	    def findings(
   385	        self, repository_id: str, revision: str | None = None
   386	    ) -> tuple[list[ExecutableFinding], str | None]:
   387	        snapshot = self.snapshot(repository_id, revision)
   388	        status, _, definitions, resolutions, reports = self.bindings(
   389	            repository_id, snapshot.revision
   390	        )
   391	        executions, _ = self.executions(repository_id, snapshot.revision)
   392	        if status is BindingAvailability.NOT_AVAILABLE:
   393	            return [], None
   394	        if not reports:
   395	            return [], None
   396	        findings = evaluate_executable_findings(
   397	            repository_id=snapshot.repository_id,
   398	            revision=snapshot.revision,
   399	            resolutions=resolutions,
   400	            executions=executions,
   401	            definition_paths={
   402	                definition.definition_key: definition.source_path for definition in definitions
   403	            },
   404	        )
   405	        return findings, reports[0].executions[0].tested_commit
     1	"""Deterministic executability findings over portable data.
     2	
     3	These findings answer "can this Gherkin suite execute, and did it?" — never "is the requirement
     4	satisfied?". They are only evaluated when a trusted framework report exists; absence of metadata
     5	produces no finding at all (the query surface says ``NOT_AVAILABLE``).
     6	
     7	Precedence and scope:
     8	
     9	* ``undefined_step`` / ``ambiguous_step`` describe the framework's own resolution result.
    10	* ``execution_failed`` describes one observed failing scenario instance; it preserves the failing
    11	  step and the execution key.
    12	* Missing execution coverage is reported as counts, not as a defect: an unexecuted scenario has
    13	  unknown status, not a failing one.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	from collections.abc import Iterable
    19	
    20	from app.domain.enums import FindingStatus, FindingType, RuleId
    21	from app.domain.executable import ExecutableFinding
    22	from app.domain.models import finding_fingerprint
    23	from app.domain.policy import RULE_DEFAULT_SEVERITY
    24	from app.domain.portable import (
    25	    ExecutionOutcome,
    26	    ScenarioExecutionRecord,
    27	    StepMatchStatus,
    28	    StepResolutionRecord,
    29	)
    30	
    31	
    32	def evaluate_executable_findings(
    33	    *,
    34	    repository_id: str,
    35	    revision: str,
    36	    resolutions: Iterable[StepResolutionRecord],
    37	    executions: Iterable[ScenarioExecutionRecord],
    38	    definition_paths: dict[str, str],
    39	) -> list[ExecutableFinding]:
    40	    findings: dict[str, ExecutableFinding] = {}
    41	
    42	    def add(
    43	        *,
    44	        rule_id: RuleId,
    45	        finding_type: FindingType,
    46	        artifact_keys: list[str],
    47	        execution_keys: list[str],
    48	        explanation: str,
    49	    ) -> None:
    50	        fingerprint = finding_fingerprint(rule_id, finding_type, artifact_keys)
    51	        findings.setdefault(
    52	            fingerprint,
    53	            ExecutableFinding(
    54	                finding_id=fingerprint,
    55	                rule_id=rule_id,
    56	                finding_type=finding_type,
    57	                status=FindingStatus.OPEN,
    58	                severity=RULE_DEFAULT_SEVERITY[rule_id],
    59	                artifact_keys=sorted(set(artifact_keys)),
    60	                evaluated_baseline=revision,
    61	                execution_keys=sorted(set(execution_keys)),
    62	                explanation=explanation,
    63	            ),
    64	        )
    65	
    66	    for resolution in resolutions:
    67	        location = f"{resolution.scenario_key} step at {resolution.step_key}"
    68	        if resolution.status is StepMatchStatus.UNDEFINED:
    69	            add(
    70	                rule_id=RuleId.UNDEFINED_STEP,
    71	                finding_type=FindingType.UNDEFINED_STEP,
    72	                artifact_keys=[resolution.scenario_key, resolution.step_key],
    73	                execution_keys=[],
    74	                explanation=(
    75	                    f"The imported {repository_id} report resolved no step definition for "
    76	                    f"{resolution.step_text!r} ({location}). The framework reported the step as "
    77	                    "undefined at this revision."
    78	                ),
    79	            )
    80	        elif resolution.status is StepMatchStatus.AMBIGUOUS:
