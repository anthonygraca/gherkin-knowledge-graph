    92	            return None
    93	        value = output.decode("utf-8", "replace").strip()
    94	        return value or None
    95	
    96	    def tags(self) -> dict[str, str]:
    97	        """Lightweight and annotated tags pinned to commits, as ``name -> commit``."""
    98	        output = self._run("for-each-ref", "--format=%(refname:short) %(objectname)", "refs/tags")
    99	        tags: dict[str, str] = {}
   100	        for line in output.decode("utf-8", "replace").splitlines():
   101	            name, _, object_id = line.partition(" ")
   102	            if not name:
   103	                continue
   104	            try:
   105	                tags[name] = self.resolve(name)
   106	            except IngestionError:
