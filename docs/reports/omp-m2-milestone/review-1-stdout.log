    86	        keyword=node["keyword"].strip(),
    87	        text=node["text"],
    88	        line=line,
    89	        column=node["location"]["column"],
    90	        from_background=background,
    91	        doc_string=doc_string,
    92	        data_table=data_table,
    93	    )
