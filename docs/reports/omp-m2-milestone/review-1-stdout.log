   109	
   110	    def root_commits(self) -> list[str]:
   111	        """Root commit SHAs, used as a clone-stable identity when no remote is configured."""
   112	        output = self._run("rev-list", "--max-parents=0", "HEAD")
   113	        return [line.strip() for line in output.decode("utf-8", "replace").splitlines() if line]
   114	
   115	    def read_blob(self, revision: str, path: str) -> bytes:
   116	        """Exact bytes of ``path`` at ``revision`` (the content hash is taken over these)."""
   117	        object_id = (
   118	            self._run("rev-parse", "--verify", "--end-of-options", f"{revision}:{path}")
   119	            .decode("utf-8", "replace")
   120	            .strip()
   121	        )
   122	        return self._run("cat-file", "blob", object_id)
   123	
   124	    def _run(self, *args: str) -> bytes:
   125	        try:
   126	            result = subprocess.run(
   127	                ["git", *GIT_READ_FLAGS, *args],
   128	                cwd=self.root,
   129	                capture_output=True,
   130	                check=False,
   131	            )
   132	        except FileNotFoundError as exc:
   133	            raise IngestionError(
   134	                "git is not installed; ingestion reads committed revisions through the Git CLI"
   135	            ) from exc
   136	        if result.returncode != 0:
   137	            detail = result.stderr.decode("utf-8", "replace").strip() or "no diagnostic output"
   138	            raise IngestionError(f"git {' '.join(args)} failed in {self.root}: {detail}")
   139	        return result.stdout

