   136	def _tree_hashes(repo: Path) -> dict[str, str]:
   137	    hashes = {}
   138	    for path in sorted(repo.rglob("*")):
   139	        if path.is_file() and ".git" not in path.parts:
   140	            hashes[str(path.relative_to(repo))] = hashlib.sha256(path.read_bytes()).hexdigest()
   141	    return hashes
