    29	    "external-twin": ROOT / "fixtures" / "external-twin",
    30	}
    31	
    32	GIT_IDENTITY = {
    33	    "GIT_AUTHOR_NAME": "External Fixture Bot",
    34	    "GIT_AUTHOR_EMAIL": "external@example.invalid",
    35	    "GIT_COMMITTER_NAME": "External Fixture Bot",
    36	    "GIT_COMMITTER_EMAIL": "external@example.invalid",
    37	    "GIT_CONFIG_GLOBAL": os.devnull,
    38	    "GIT_CONFIG_SYSTEM": os.devnull,
    39	    "GIT_DEFAULT_HASH": "sha1",
    40	    "LC_ALL": "C",
    41	    "TZ": "UTC",
    42	}
    43	
    44	
    45	def git(args: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> str:
    46	    merged = {**os.environ, **GIT_IDENTITY, **(env or {})}
    47	    result = subprocess.run(
    48	        ["git", *args], cwd=cwd, env=merged, capture_output=True, text=True, check=False
    49	    )
    50	    if result.returncode != 0:
    51	        raise RuntimeError(f"git {' '.join(args)} failed in {cwd}: {result.stderr.strip()}")
    52	    return result.stdout
    53	
    54	
    55	def copy_tree(source: Path, dest: Path) -> None:
    56	    for path in sorted(source.rglob("*")):
    57	        if path.is_dir():
    58	            continue
    59	        target = dest / path.relative_to(source)
    60	        target.parent.mkdir(parents=True, exist_ok=True)
    61	        shutil.copyfile(path, target)
    62	
    63	
    64	def build_repo(fixture_dir: Path, dest: Path) -> dict[str, str]:
    65	    """Materialize one fixture's declarative history and return ``tag -> commit``."""
    66	    history = json.loads((fixture_dir / "history.json").read_text(encoding="utf-8"))
    67	    if dest.exists():
    68	        shutil.rmtree(dest)
    69	    dest.mkdir(parents=True)
    70	    git(["init", "--quiet", "-b", "main"], cwd=dest)
    71	    git(["config", "user.name", GIT_IDENTITY["GIT_AUTHOR_NAME"]], cwd=dest)
    72	    git(["config", "user.email", GIT_IDENTITY["GIT_AUTHOR_EMAIL"]], cwd=dest)
    73	    tags: dict[str, str] = {}
    74	    for commit in history["commits"]:
    75	        copy_tree(fixture_dir / commit["overlay"], dest)
    76	        git(["add", "-A"], cwd=dest)
    77	        date = commit["date"]
    78	        git(
    79	            ["commit", "--quiet", "--allow-empty", "-m", commit["message"]],
    80	            cwd=dest,
    81	            env={"GIT_AUTHOR_DATE": date, "GIT_COMMITTER_DATE": date},
    82	        )
    83	        sha = git(["rev-parse", "HEAD"], cwd=dest).strip()
    84	        for tag in commit.get("tags", []):
    85	            git(["tag", tag, sha], cwd=dest)
    86	            tags[tag] = sha
    87	    return tags
    88	
    89	
    90	def build_all(dest_root: Path) -> dict[str, dict[str, str]]:
    91	    dest_root.mkdir(parents=True, exist_ok=True)
    92	    return {
    93	        name: build_repo(fixture_dir, dest_root / name)
    94	        for name, fixture_dir in sorted(FIXTURES.items())
    95	    }
    96	
    97	
    98	def main(argv: list[str] | None = None) -> int:
    99	    parser = argparse.ArgumentParser(description=__doc__)
   100	    subparsers = parser.add_subparsers(dest="command", required=True)
   101	    build = subparsers.add_parser("build", help="build both fixture repositories")
   102	    build.add_argument("--dest", type=Path, default=None)
   103	    show = subparsers.add_parser("show-refs", help="print tag -> commit for a built tree")
   104	    show.add_argument("--dest", type=Path, default=None)
   105	    args = parser.parse_args(argv)
   106	    dest = args.dest or Path(tempfile.mkdtemp(prefix="cta-external-"))
   107	    if args.command == "build":
   108	        refs = build_all(dest)
   109	        print(json.dumps(refs, indent=2, sort_keys=True))
   110	        return 0
   111	    refs = {
   112	        name: {
   113	            tag: git(["rev-parse", tag], cwd=dest / name).strip()
   114	            for tag in git(["tag"], cwd=dest / name).split()
   115	        }
   116	        for name in FIXTURES
   117	        if (dest / name).is_dir()
   118	    }
   119	    print(json.dumps(refs, indent=2, sort_keys=True))
   120	    return 0
   121	
   122	
   123	if __name__ == "__main__":
   124	    raise SystemExit(main())
