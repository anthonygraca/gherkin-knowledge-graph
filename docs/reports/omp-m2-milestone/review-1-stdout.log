     1	#!/usr/bin/env node
     2	/**
     3	 * Strict step-resolution gate for the CTA acceptance suite.
     4	 *
     5	 * Cucumber's process exit code is not enough: a suite can pass while a required scenario was
     6	 * skipped or a step resolved ambiguously and was never executed. This gate reads the Cucumber
     7	 * Messages report and fails when:
     8	 *
     9	 *   - the run did not finish successfully;
    10	 *   - any step was reported UNDEFINED, AMBIGUOUS, or PENDING;
    11	 *   - a pickle (concrete scenario case) never started.
    12	 *
    13	 * Usage: node tools/step-resolution.mjs [reports/cucumber-messages.ndjson]
    14	 */
    15	import fs from 'node:fs';
    16	
    17	const reportPath = process.argv[2] || 'reports/cucumber-messages.ndjson';
    18	const envelopes = fs
    19	  .readFileSync(reportPath, 'utf8')
    20	  .split('\n')
    21	  .filter((line) => line.trim())
    22	  .map((line) => JSON.parse(line));
    23	
    24	const documents = new Map();
    25	const pickles = new Map();
    26	const testCases = new Map();
    27	const startedByCase = new Map();
    28	const results = new Map();
    29	let runFinished = null;
    30	
    31	for (const envelope of envelopes) {
    32	  if (envelope.gherkinDocument) documents.set(envelope.gherkinDocument.uri, envelope.gherkinDocument);
    33	  if (envelope.pickle) pickles.set(envelope.pickle.id, envelope.pickle);
    34	  if (envelope.testCase) testCases.set(envelope.testCase.id, envelope.testCase);
    35	  if (envelope.testCaseStarted) {
    36	    const ids = startedByCase.get(envelope.testCaseStarted.testCaseId) ?? [];
    37	    ids.push(envelope.testCaseStarted.id);
    38	    startedByCase.set(envelope.testCaseStarted.testCaseId, ids);
    39	  }
    40	  if (envelope.testStepFinished) {
    41	    results.set(
    42	      `${envelope.testStepFinished.testCaseStartedId}:${envelope.testStepFinished.testStepId}`,
    43	      envelope.testStepFinished.testStepResult,
    44	    );
    45	  }
    46	  if (envelope.testRunFinished) runFinished = envelope.testRunFinished;
    47	}
    48	
    49	function stepLocations(uri) {
    50	  const byId = new Map();
    51	  const walk = (steps) => {
    52	    for (const step of steps ?? []) byId.set(step.id, step.location.line);
    53	  };
    54	  for (const child of documents.get(uri)?.feature?.children ?? []) {
    55	    if (child.background) walk(child.background.steps);
    56	    if (child.scenario) walk(child.scenario.steps);
    57	    for (const sub of child.rule?.children ?? []) {
    58	      if (sub.background) walk(sub.background.steps);
    59	      if (sub.scenario) walk(sub.scenario.steps);
    60	    }
    61	  }
    62	  return byId;
    63	}
    64	
    65	const problems = [];
    66	if (!runFinished) problems.push('report has no testRunFinished envelope');
    67	else if (!runFinished.success) problems.push('the run did not finish successfully');
    68	
    69	for (const [caseId, testCase] of testCases) {
    70	  const pickle = pickles.get(testCase.pickleId);
    71	  if (!pickle) {
    72	    problems.push(`test case ${caseId} references an unknown pickle`);
    73	    continue;
    74	  }
    75	  const attemptIds = startedByCase.get(caseId) ?? [];
    76	  if (attemptIds.length === 0) {
    77	    problems.push(`${pickle.uri}:${pickle.location?.line ?? '?'} "${pickle.name}" never started`);
    78	    continue;
    79	  }
    80	  const locations = stepLocations(pickle.uri);
    81	  const stepsById = new Map((testCase.testSteps ?? []).map((step) => [step.id, step]));
    82	  for (const attemptId of attemptIds) {
    83	    for (const [key, result] of results) {
    84	      const [startedId, testStepId] = key.split(':');
    85	      if (startedId !== attemptId) continue;
    86	      const caseStep = stepsById.get(testStepId);
    87	      if (!caseStep?.pickleStepId) continue;
    88	      const pickleStep = pickle.steps.find((step) => step.id === caseStep.pickleStepId);
    89	      if (!pickleStep) continue;
    90	      if (!['UNDEFINED', 'AMBIGUOUS', 'PENDING'].includes(result.status)) continue;
    91	      const line = locations.get(pickleStep.astNodeIds?.[0]) ?? '?';
    92	      const definitions = (caseStep.stepDefinitionIds ?? []).length;
    93	      problems.push(
    94	        `${pickle.uri}:${line} "${pickle.name}" step "${pickleStep.text}" is ${result.status}` +
    95	          (result.status === 'UNDEFINED'
    96	            ? ' (no matching definition)'
    97	            : ` (${definitions} definitions)`),
    98	      );
    99	    }
   100	  }
   101	}
   102	
   103	if (problems.length > 0) {
   104	  console.error('step-resolution: FAILED');
   105	  for (const problem of [...new Set(problems)].sort()) console.error(`  - ${problem}`);
   106	  process.exit(1);
   107	}
   108	console.log(
   109	  `step-resolution: ok (${testCases.size} test cases, ${results.size} step results, all resolved and started)`,
   110	);
