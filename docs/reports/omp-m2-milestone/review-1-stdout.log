   142	def op_repo(args: dict) -> dict:
   143	    state = _load_state()
   144	    name = args.get("name", "repo")
   145	    path = _state_dir() / "repos" / name
   146	    if path.exists():
   147	        shutil.rmtree(path)
   148	    path.mkdir(parents=True)
   149	    _git(path, "init", "--quiet", "-b", "main")
   150	    _git(path, "config", "user.name", "BDD Fixture")
   151	    _git(path, "config", "user.email", "bdd@example.invalid")
   152	    _git(path, "config", "commit.gpgsign", "false")
   153	    _write_files(path, args.get("files", {}))
   154	    commit = _commit(path, args.get("message", "fixture commit"))
   155	    state.setdefault("repos", {})[name] = str(path)
   156	    _save_state(state)
   157	    return {"path": str(path), "commit": commit}
