   526	def op_hashes(args: dict) -> dict:
   527	    state = _load_state()
   528	    path = Path(args["path"]) if args.get("path") else _repo_path(state, args.get("name", "repo"))
   529	    import hashlib
   530	
   531	    hashes = {}
   532	    for item in sorted(path.rglob("*")):
   533	        if item.is_file() and ".git" not in item.parts:
   534	            hashes[str(item.relative_to(path))] = hashlib.sha256(item.read_bytes()).hexdigest()
   535	    return {
   536	        "hashes": hashes,
   537	        "status": _git(path, "status", "--porcelain", "--untracked-files=all").strip(),
