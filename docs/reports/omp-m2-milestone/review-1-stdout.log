   177	def op_repo_from_fixture(args: dict) -> dict:
   178	    """Clone the built fixture at one tag into the scenario's state, keeping its history."""
   179	    state = _load_state()
   180	    name = args.get("name", "repo")
   181	    path = _state_dir() / "repos" / name
   182	    if path.exists():
   183	        shutil.rmtree(path)
   184	    path.parent.mkdir(parents=True, exist_ok=True)
   185	    _git(_fixture_repo().parent, "clone", "--quiet", str(_fixture_repo()), str(path))
   186	    _git(path, "checkout", "--quiet", args["tag"])
   187	    _git(path, "config", "user.name", "BDD Fixture")
   188	    _git(path, "config", "user.email", "bdd@example.invalid")
   189	    _git(path, "config", "commit.gpgsign", "false")
   190	    state.setdefault("repos", {})[name] = str(path)
   191	    _save_state(state)
   192	    return {
   193	        "path": str(path),
   194	        "commit": _git(path, "rev-parse", "HEAD").strip(),
   195	        "tags": _git(path, "tag", "--points-at", "HEAD").strip().split(),
