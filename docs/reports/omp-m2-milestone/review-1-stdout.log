   344	def _index_children(
   345	    child: dict[str, Any],
   346	    *,
   347	    uri: str,
   348	    repository_id: str,
   349	    step_nodes: dict[str, dict[str, Any]],
   350	    scenario_nodes: dict[str, dict[str, Any]],
   351	    example_rows: dict[str, tuple[str, int]],
   352	    rule: dict[str, Any] | None,
   353	) -> None:
   354	    if "background" in child:
   355	        _index_steps(
   356	            child["background"].get("steps", []),
   357	            uri=uri,
   358	            repository_id=repository_id,
   359	            step_nodes=step_nodes,
   360	        )
   361	        return
   362	    if "rule" in child:
   363	        nested = child["rule"]
   364	        for sub in nested.get("children", []):
   365	            _index_children(
   366	                sub,
   367	                uri=uri,
   368	                repository_id=repository_id,
   369	                step_nodes=step_nodes,
   370	                scenario_nodes=scenario_nodes,
   371	                example_rows=example_rows,
   372	                rule=nested,
   373	            )
   374	        return
   375	    if "scenario" not in child:
   376	        return
   377	    scenario = child["scenario"]
   378	    line = scenario["location"]["line"]
   379	    scenario_key = f"{repository_id}:{uri}#SCN-L{line}"
   380	    scenario_nodes[scenario["id"]] = {
   381	        "scenario_key": scenario_key,
   382	        "name": scenario.get("name", ""),
   383	        "uri": uri,
