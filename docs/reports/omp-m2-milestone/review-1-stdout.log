   157	def _convert_scenario(
   158	    scenario: dict[str, Any],
   159	    *,
   160	    feature_key: str,
   161	    repository_id: str,
   162	    path: str,
   163	    rule_name: str | None,
   164	    background_steps: list[PortableStep],
   165	) -> PortableScenario:
   166	    line = scenario["location"]["line"]
   167	    scenario_key = f"{repository_id}:{path}#SCN-L{line}"
   168	    kind = (
   169	        ScenarioKind.SCENARIO_OUTLINE
   170	        if scenario.get("keyword", "").strip() == "Scenario Outline"
   171	        else ScenarioKind.SCENARIO
   172	    )
   173	    steps = [
   174	        _convert_step(step, path=path, repository_id=repository_id, background=False)
   175	        for step in scenario.get("steps", [])
   176	    ]
   177	    effective = [*background_steps, *steps] if background_steps else steps
   178	    return PortableScenario(
   179	        scenario_key=scenario_key,
   180	        feature_key=feature_key,
   181	        path=path,
   182	        line=line,
   183	        keyword=scenario.get("keyword", "Scenario").strip(),
   184	        name=_text(scenario),
   185	        description=scenario.get("description", ""),
   186	        tags=_tag_names(scenario),
   187	        rule_name=rule_name,
   188	        kind=kind,
   189	        steps=effective,
   190	        instances=_instances(
   191	            scenario,
   192	            scenario_key=scenario_key,
   193	            repository_id=repository_id,
   194	            path=path,
   195	            name=_text(scenario),
   196	            steps=steps,
   197	        ),
   198	    )
