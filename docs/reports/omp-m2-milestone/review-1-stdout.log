   102	def _instances(
   103	    scenario: dict[str, Any],
   104	    *,
   105	    scenario_key: str,
   106	    repository_id: str,
   107	    path: str,
   108	    name: str,
   109	    steps: list[PortableStep],
   110	) -> list[PortableScenarioInstance]:
   111	    """Expand ``Examples`` rows into concrete case identities (order-preserving)."""
   112	    instances: list[PortableScenarioInstance] = []
   113	    row_number = 0
   114	    for example in scenario.get("examples", []):
   115	        header = [cell.get("value", "") for cell in example.get("tableHeader", {}).get("cells", [])]
   116	        for row in example.get("tableBody", []):
   117	            row_number += 1
   118	            values = {
   119	                column: cell.get("value", "")
   120	                for column, cell in zip(header, row.get("cells", []), strict=True)
   121	            }
   122	            instance_steps = [
   123	                step.model_copy(
   124	                    update={
   125	                        "text": _interpolate(step.text, values),
   126	                        "doc_string": (
   127	                            _interpolate(step.doc_string, values)
   128	                            if step.doc_string is not None
   129	                            else None
   130	                        ),
   131	                        "data_table": (
   132	                            [
   133	                                [_interpolate(cell, values) for cell in row_cells]
   134	                                for row_cells in step.data_table
   135	                            ]
   136	                            if step.data_table is not None
   137	                            else None
   138	                        ),
   139	                    }
   140	                )
   141	                for step in steps
   142	            ]
   143	            suffix = "/".join(values.values()) if values else str(row_number)
   144	            instances.append(
   145	                PortableScenarioInstance(
   146	                    instance_key=f"{scenario_key}/EX-{row_number}",
   147	                    scenario_key=scenario_key,
   148	                    name=f"{name} [{suffix}]",
   149	                    example_row=row_number,
   150	                    example_values=values,
   151	                    steps=instance_steps,
   152	                )
   153	            )
   154	    return instances
