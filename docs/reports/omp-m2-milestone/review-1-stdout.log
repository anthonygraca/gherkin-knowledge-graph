    39	def _registry(args: argparse.Namespace, *, import_report: bool = False) -> PortableRegistry:
    40	    registry = PortableRegistry()
    41	    registry.index(Path(args.path), repository_id=args.repo_id, revision=args.ref)
    42	    if import_report and args.report:
    43	        registry.import_report(
    44	            registry.summaries()[0].repository_id,
    45	            ExecutionImportRequest(
    46	                report_path=args.report,
    47	                tested_commit=args.tested_commit or args.ref,
    48	            ),
    49	        )
    50	    return registry
    51	
    52	
    53	def _repository_id(registry: PortableRegistry) -> str:
    54	    return registry.summaries()[0].repository_id
    55	
    56	
    57	def _scenarios(args: argparse.Namespace, registry: PortableRegistry) -> ScenarioListResponse:
    58	    snapshot = registry.snapshot(_repository_id(registry), args.ref)
    59	    scenarios = [scenario for feature in snapshot.features for scenario in feature.scenarios]
    60	    if args.tag:
    61	        wanted = f"@{args.tag.lstrip('@')}"
    62	        scenarios = [scenario for scenario in scenarios if wanted in scenario.tags]
    63	    if args.feature_path:
    64	        scenarios = [scenario for scenario in scenarios if scenario.path == args.feature_path]
    65	    return ScenarioListResponse(
    66	        schema_version=SCHEMA_VERSION,
    67	        repository_id=snapshot.repository_id,
    68	        revision=snapshot.revision,
    69	        source_digest=snapshot.source_digest,
    70	        parser=snapshot.parser,
    71	        scenarios=scenarios,
    72	    )
    73	
    74	
    75	def _steps(args: argparse.Namespace, registry: PortableRegistry) -> StepListResponse:
    76	    snapshot = registry.snapshot(_repository_id(registry), args.ref)
    77	    scenarios = [scenario for feature in snapshot.features for scenario in feature.scenarios]
    78	    if args.scenario:
    79	        scenarios = [scenario for scenario in scenarios if scenario.scenario_key == args.scenario]
    80	    seen: set[str] = set()
    81	    steps = []
    82	    for scenario in scenarios:
    83	        for step in scenario.steps:
    84	            if step.step_key in seen:
    85	                continue
    86	            seen.add(step.step_key)
    87	            steps.append(step)
