   119	def _git(repo: Path, *args: str, check: bool = True) -> str:
   120	    result = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, check=False)
   121	    if check and result.returncode != 0:
   122	        raise RuntimeError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
   123	    return result.stdout
   124	
   125	
   126	def _write_files(repo: Path, files: dict[str, str]) -> None:
   127	    for name, content in files.items():
   128	        target = repo / name
   129	        target.parent.mkdir(parents=True, exist_ok=True)
   130	        if content.startswith("SYMLINK:"):
   131	            target.symlink_to(content[len("SYMLINK:") :])
   132	        else:
   133	            target.write_text(content, encoding="utf-8")
   134	
   135	
   136	def _commit(repo: Path, message: str) -> str:
   137	    _git(repo, "add", "-A")
   138	    _git(repo, "commit", "--quiet", "--allow-empty", "-m", message)
   139	    return _git(repo, "rev-parse", "HEAD").strip()
