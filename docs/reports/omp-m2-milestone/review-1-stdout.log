   201	def _convert_feature(
   202	    document: dict[str, Any], *, repository_id: str, path: str, content_hash: str
   203	) -> PortableFeature:
   204	    feature = document["feature"]
   205	    feature_key = f"{repository_id}:{path}"
   206	    feature_background = [
   207	        _convert_step(step, path=path, repository_id=repository_id, background=True)
   208	        for child in feature.get("children", [])
   209	        if "background" in child
   210	        for step in child["background"].get("steps", [])
   211	    ]
   212	    scenarios: list[PortableScenario] = []
   213	    for child in feature.get("children", []):
   214	        if "rule" in child:
   215	            rule = child["rule"]
   216	            rule_background = [
   217	                _convert_step(step, path=path, repository_id=repository_id, background=True)
   218	                for sub in rule.get("children", [])
   219	                if "background" in sub
   220	                for step in sub["background"].get("steps", [])
   221	            ]
   222	            for sub in rule.get("children", []):
   223	                if "scenario" in sub:
   224	                    scenarios.append(
   225	                        _convert_scenario(
   226	                            sub["scenario"],
   227	                            feature_key=feature_key,
   228	                            repository_id=repository_id,
   229	                            path=path,
   230	                            rule_name=_text(rule),
   231	                            background_steps=[*feature_background, *rule_background],
   232	                        )
   233	                    )
   234	            continue
   235	        if "scenario" in child:
   236	            scenarios.append(
   237	                _convert_scenario(
   238	                    child["scenario"],
   239	                    feature_key=feature_key,
   240	                    repository_id=repository_id,
   241	                    path=path,
   242	                    rule_name=None,
   243	                    background_steps=feature_background,
   244	                )
   245	            )
   246	    return PortableFeature(
   247	        feature_key=feature_key,
   248	        path=path,
   249	        line=feature["location"]["line"],
   250	        language=feature.get("language", "en"),
   251	        name=_text(feature),
   252	        description=feature.get("description", ""),
   253	        tags=_tag_names(feature),
   254	        background_steps=feature_background,
   255	        scenarios=scenarios,
   256	        content_hash=content_hash,
   257	    )
