   147	def build_parser() -> argparse.ArgumentParser:
   148	    parser = argparse.ArgumentParser(prog="cta", description=__doc__)
   149	    sub = parser.add_subparsers(dest="command", required=True)
   150	
   151	    def add_common(name: str, help_text: str, *, report: bool = False) -> argparse.ArgumentParser:
   152	        command = sub.add_parser(name, help=help_text)
   153	        command.add_argument("path", help="Local repository path (read-only)")
   154	        command.add_argument("--repo-id", default=None, help="Explicit stable repository id")
   155	        command.add_argument("--ref", required=True, help="Pinned tag or commit to index")
   156	        if report:
   157	            command.add_argument("--report", default=None, help="Cucumber Messages NDJSON file")
   158	            command.add_argument(
   159	                "--tested-commit",
   160	                default=None,
   161	                help="Commit the report tested (defaults to --ref)",
   162	            )
   163	        return command
   164	
   165	    add_common("index", "Index one commit and print the summary")
   166	    scenarios = add_common("scenarios", "List scenarios")
   167	    scenarios.add_argument("--tag", default=None)
   168	    scenarios.add_argument("--feature-path", default=None)
   169	    steps = add_common("steps", "List steps")
   170	    steps.add_argument("--scenario", default=None)
   171	    add_common("definitions", "Step definitions and resolutions", report=True)
   172	    add_common("unresolved", "Undefined or ambiguous steps", report=True)
   173	    add_common("executions", "Observed scenario executions", report=True)
   174	    add_common("findings", "Executability findings", report=True)
   175	    return parser
   176	
   177	
   178	def main(argv: list[str] | None = None) -> int:
   179	    args = build_parser().parse_args(argv)
   180	    wants_report = getattr(args, "report", None) is not None
   181	    try:
   182	        registry = _registry(args, import_report=wants_report)
   183	        if args.command == "index":
   184	            summary: PortableIndexSummary = registry.summaries()[0]
   185	            payload = summary.model_dump(mode="json")
   186	        elif args.command == "scenarios":
   187	            payload = _scenarios(args, registry).model_dump(mode="json")
   188	        elif args.command == "steps":
   189	            payload = _steps(args, registry).model_dump(mode="json")
   190	        elif args.command == "definitions":
   191	            payload = _bindings(args, registry).model_dump(mode="json")
   192	        elif args.command == "unresolved":
   193	            payload = _unresolved(args, registry).model_dump(mode="json")
   194	        elif args.command == "executions":
   195	            payload = _executions(args, registry).model_dump(mode="json")
   196	        elif args.command == "findings":
   197	            findings, tested_commit = registry.findings(_repository_id(registry), args.ref)
   198	            payload = {
   199	                "schema_version": SCHEMA_VERSION,
   200	                "repository_id": _repository_id(registry),
   201	                "revision": registry.snapshot(_repository_id(registry), args.ref).revision,
   202	                "tested_commit": tested_commit,
   203	                "findings": [finding.model_dump(mode="json") for finding in findings],
   204	            }
   205	        else:  # pragma: no cover - argparse enforces the command set
   206	            raise RuntimeError(f"unhandled command {args.command}")
   207	    except Exception as exc:  # noqa: BLE001 - CLI boundary: report, do not traceback
   208	        print(
   209	            json.dumps(
   210	                {
   211	                    "error": type(exc).__name__,
   212	                    "detail": str(exc),
   213	                    "code": getattr(exc, "code", None),
   214	                },
   215	                indent=2,
   216	            ),
   217	            file=sys.stderr,
   218	        )
   219	        return 2
   220	    print(json.dumps(payload, indent=2, sort_keys=True))
   221	    return 0
   222	
   223	
   224	if __name__ == "__main__":
   225	    raise SystemExit(main())

