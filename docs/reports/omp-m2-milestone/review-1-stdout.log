   455	def op_fixture_tests(args: dict) -> dict:
   456	    """Run the monitored application's own pytest suite at one tag in an isolated worktree."""
   457	    destination = _state_dir() / "banking-tests-" / args["tag"]
   458	    manifest = fixturectl.build_repo(FIXTURE_DIR, destination)
   459	    worktree = destination.parent / f"worktree-{args['tag']}"
   460	    _git(destination, "worktree", "add", "--detach", str(worktree), args["tag"])
   461	    try:
   462	        result = subprocess.run(
   463	            [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", "--tb=no"],
   464	            cwd=worktree,
   465	            capture_output=True,
   466	            text=True,
   467	            check=False,
   468	        )
   469	    finally:
   470	        subprocess.run(
   471	            ["git", "worktree", "remove", "--force", str(worktree)],
   472	            cwd=destination,
   473	            capture_output=True,
   474	            check=False,
   475	        )
   476	    failed = [
   477	        line[len("FAILED ") :].split(" - ")[0].strip()
   478	        for line in result.stdout.splitlines()
   479	        if line.startswith("FAILED ")
   480	    ]

