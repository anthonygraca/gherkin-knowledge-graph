   296	class PortableIndexer:
   297	    """Index one commit of one repository into portable facts."""
   298	
   299	    def __init__(self, limits: IndexLimits | None = None) -> None:
   300	        self._limits = limits or IndexLimits()
   301	        self._parser = Parser()
   302	
   303	    def index(
   304	        self,
   305	        root: Path,
   306	        *,
   307	        repository_id: str | None = None,
   308	        revision: str | None = None,
   309	    ) -> PortableSnapshot:
   310	        repository = GitRepository(Path(root))
   311	        if not repository.root.is_dir():
   312	            raise PortableIndexError(f"repository path {root} is not a directory")
   313	        try:
   314	            commit = repository.resolve(revision)
   315	            entries = repository.list_tree(commit)
   316	        except IngestionError as exc:
   317	            raise PortableIndexError(str(exc)) from exc
   318	        if len(entries) > self._limits.max_tree_entries:
   319	            raise PortableIndexError(
   320	                f"{root} has {len(entries)} tree entries, above the index limit of "
   321	                f"{self._limits.max_tree_entries}"
   322	            )
   323	        resolved_id, strategy = derive_repository_id(repository.root, repository_id)
   324	        digest = hashlib.sha256()
   325	        features: list[PortableFeature] = []
   326	        diagnostics: list[PortableDiagnostic] = []
   327	        feature_entries = [entry for entry in entries if entry.path.endswith(FEATURE_SUFFIX)]
   328	        if len(feature_entries) > self._limits.max_features:
   329	            raise PortableIndexError(
   330	                f"{root} has {len(feature_entries)} feature files, above the index limit of "
   331	                f"{self._limits.max_features}"
   332	            )
   333	        for entry in entries:
   334	            digest.update(
   335	                f"{entry.mode}\0{entry.object_type}\0{entry.object_id}\0{entry.path}\0".encode()
   336	            )
   337	        for entry in feature_entries:
   338	            if entry.mode == "120000":
   339	                diagnostics.append(
   340	                    PortableDiagnostic(
   341	                        path=entry.path,
   342	                        code="symlink",
   343	                        detail="symlinked feature files are not followed during indexing",
   344	                    )
   345	                )
   346	                continue
   347	            if entry.mode not in ("100644", "100755"):
   348	                diagnostics.append(
   349	                    PortableDiagnostic(
   350	                        path=entry.path,
   351	                        code="unsupported-mode",
   352	                        detail=f"tree entry mode {entry.mode} is not a regular file",
   353	                    )
   354	                )
   355	                continue
   356	            if entry.size is not None and entry.size > self._limits.max_feature_bytes:
   357	                diagnostics.append(
   358	                    PortableDiagnostic(
   359	                        path=entry.path,
   360	                        code="file-too-large",
   361	                        detail=f"{entry.size} bytes exceeds the {self._limits.max_feature_bytes} "
   362	                        "byte feature limit",
   363	                    )
   364	                )
   365	                continue
   366	            try:
   367	                blob = repository.read_object(entry.object_id)
   368	            except IngestionError as exc:
   369	                diagnostics.append(
   370	                    PortableDiagnostic(path=entry.path, code="read-failed", detail=str(exc))
   371	                )
   372	                continue
   373	            if len(blob) > self._limits.max_feature_bytes:
   374	                diagnostics.append(
   375	                    PortableDiagnostic(
   376	                        path=entry.path,
   377	                        code="file-too-large",
   378	                        detail=f"{len(blob)} bytes exceeds the feature limit",
   379	                    )
   380	                )
   381	                continue
   382	            try:
   383	                text = blob.decode("utf-8")
   384	            except UnicodeDecodeError as exc:
   385	                diagnostics.append(
   386	                    PortableDiagnostic(
   387	                        path=entry.path,
   388	                        code="unsupported-encoding",
   389	                        detail=f"feature file is not valid UTF-8: {exc}",
   390	                    )
   391	                )
   392	                continue
   393	            try:
   394	                document = self._parser.parse(TokenScanner(text))
   395	            except CompositeParserException as exc:
   396	                for error in exc.errors:
   397	                    detail = getattr(error, "message", None) or str(error)
   398	                    location = getattr(error, "location", None)
   399	                    line = getattr(location, "line", None)
   400	                    if line is None:
   401	                        match = re.match(r"^\((\d+):\d+\)", detail)
   402	                        line = int(match.group(1)) if match else None
   403	                    diagnostics.append(
   404	                        PortableDiagnostic(
   405	                            path=entry.path,
   406	                            code="invalid-gherkin",
   407	                            detail=detail,
   408	                            line=line,
   409	                        )
   410	                    )
   411	                continue
   412	            except Exception as exc:  # noqa: BLE001 - parser failure must not abort the scan
   413	                diagnostics.append(
   414	                    PortableDiagnostic(
   415	                        path=entry.path,
   416	                        code="invalid-gherkin",
   417	                        detail=str(exc) or type(exc).__name__,
   418	                    )
   419	                )
   420	                continue
   421	            if "feature" not in document:
   422	                diagnostics.append(
   423	                    PortableDiagnostic(
   424	                        path=entry.path,
   425	                        code="invalid-gherkin",
   426	                        detail="file contains no Feature section",
   427	                    )
   428	                )
   429	                continue
   430	            features.append(
   431	                _convert_feature(
   432	                    document,
   433	                    repository_id=resolved_id,
   434	                    path=entry.path,
   435	                    content_hash=_sha256(blob),
   436	                )
   437	            )
   438	        features.sort(key=lambda feature: feature.path)
   439	        return PortableSnapshot(
   440	            repository_id=resolved_id,
   441	            identity_strategy=strategy,
   442	            revision=commit,
   443	            source_digest=_sha256(digest.digest()),
   444	            parser=f"{PARSER_IDENTITY} {_parser_version()}",
   445	            indexed_at=datetime.now(UTC),
   446	            features=features,
   447	            diagnostics=sorted(
   448	                diagnostics, key=lambda item: (item.path, item.line or 0, item.code)
   449	            ),
   450	        )
   451	
   452	
   453	def _parser_version() -> str:
   454	    from importlib.metadata import version
   455	
   456	    return version("gherkin-official")
