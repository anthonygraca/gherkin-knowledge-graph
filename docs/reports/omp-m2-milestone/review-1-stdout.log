   260	def normalize_remote_url(value: str) -> str:
   261	    """Normalize a Git remote URL to ``host/path`` so two clones hash identically."""
   262	    text = value.strip()
   263	    text = re.sub(r"^[a-zA-Z+]+://", "", text)  # strip scheme
   264	    text = text.replace("git@", "", 1)
   265	    text = text.split("@", 1)[-1] if text.count("@") == 1 and ":" in text else text
   266	    text = text.replace(":", "/", 1) if re.match(r"^[^/]+:[^/]", text) else text
   267	    text = text.rstrip("/")
   268	    if text.endswith(".git"):
   269	        text = text[: -len(".git")]
   270	    return text.lower()
