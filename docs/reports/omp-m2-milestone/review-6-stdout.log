            if len(blob) > self._limits.max_feature_bytes:
                diagnostics.append(
                    PortableDiagnostic(
                        path=entry.path,
                        code="file-too-large",
                        detail=f"{len(blob)} bytes exceeds the feature limit",
                    )
                )
