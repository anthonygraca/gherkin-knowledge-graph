def test_copy_of_fixture_tree_has_no_cta_markers():
    for name, directory in FIXTURE_DIRS.items():
        tree = directory / "tree"
        markers = []
        for path in tree.rglob("*"):
            if not path.is_file():
                continue
            text = path.read_text("utf-8")
            for marker in (
                "# cta:artifact",
                "requirements/",
                "accepted-links.json",
                "cta:artifact",
            ):
                if marker in text:
                    markers.append((name, str(path.relative_to(directory)), marker))
        assert markers == []


