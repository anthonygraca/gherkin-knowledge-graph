/bin/bash -lc 'cat bdd/tools/step-resolution.mjs; cat backend/tests/test_cucumber_report_honesty.py' in /home/anthonygraca/CSU Fullerton Dropbox/Anthony Graca/cpsc-583-knowledge-representation/project/gherkin-knowledge-graph
